---
// Shared <html> + <head> for every standard page.
// Canonical, hreflang, og:url and twitter:url are all derived from `route`
// via src/i18n/routes.ts. The page body goes in the default slot.
import Analytics from '../components/Analytics.astro'
import { SITE, routes, url, type Lang, type RouteKey } from '../i18n/routes'

interface Props {
  lang: Lang
  route: RouteKey
  title: string
  description: string
  og: { title: string; description: string }
  twitter: { title: string; description: string }
  /** JSON-LD objects, each rendered in its own <script type="application/ld+json"> */
  jsonLd?: object[]
  ogImage?: string
  ogImageHeight?: string
  robots?: string
  // Optional extras used by some pages
  ogSiteName?: string
  ogImageAlt?: string
  ogDate?: string
  twitterDomain?: string
  twitterDate?: string
}

const {
  lang,
  route,
  title,
  description,
  og,
  twitter,
  jsonLd = [],
  ogImage = `${SITE}/assets/meta_preview1200x600.webp`,
  ogImageHeight = '627',
  robots = 'index, follow',
  ogSiteName,
  ogImageAlt,
  ogDate,
  twitterDomain,
  twitterDate,
} = Astro.props

const canonical = url(route, lang)
const locale = { en: 'en_GB', fr: 'fr_FR' }
const altLocale = lang === 'en' ? locale.fr : locale.en
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta name="robots" content={robots} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="author" content="Billy Nightingale" />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Language hreflang -->
    <link rel="alternate" hreflang="en" href={SITE + routes[route].en} />
    <link rel="alternate" hreflang="fr" href={SITE + routes[route].fr} />

    <link
      rel="preload"
      href="/assets/fonts/MangoGrotesque-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Favicons -->
    <link rel="icon" href="/favicon-n-v1-48.png" sizes="48x48" />
    <link rel="icon" href="/favicon-n-v1-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-n-v1-16.png" sizes="16x16" />
    <link rel="icon" href="/favicon-n-v1-ico.ico" sizes="any" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme color (mobile UI) -->
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph / Facebook -->
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:locale" content={locale[lang]} />
    <meta property="og:locale:alternate" content={altLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={ogImageHeight} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogDate && <meta property="og:date" content={ogDate} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {twitterDomain && <meta name="twitter:domain" content={twitterDomain} />}
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={twitter.title} />
    <meta name="twitter:description" content={twitter.description} />
    <meta name="twitter:image" content={ogImage} />
    {twitterDate && <meta name="twitter:date" content={twitterDate} />}

    <!-- Page-specific head tags: <Fragment slot="head">...</Fragment> -->
    <slot name="head" />
    <link rel="stylesheet" href="/css/style.css?v=18" />
    <script defer src="/script.js" is:inline></script>

    {
      jsonLd.map((data) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data)}
        />
      ))
    }

    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
