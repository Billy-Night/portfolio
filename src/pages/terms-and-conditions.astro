---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import CookieBanner from '../components/CookieBanner.astro'

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.billynightingale.com/#person",
    "name": "Billy Nightingale",
    "jobTitle": "Web designer & web developer",
    "url": "https://www.billynightingale.com/",
    "image": "https://www.billynightingale.com/assets/billy_portrait.webp",
    "description": "Web designer and developer in Capbreton, creating modern, fast, SEO-optimised websites for local businesses.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Capbreton",
      "addressRegion": "Landes",
      "addressCountry": "FR"
    },
    "sameAs": [
      "https://www.linkedin.com/in/billynightingale/",
      "https://github.com/Billy-Night"
    ],
    "knowsAbout": [
      "web design",
      "website creation",
      "frontend development",
      "WordPress",
      "SEO",
      "local SEO",
      "performance optimisation"
    ],
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://www.billynightingale.com/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Web design, website creation and SEO services",
    "description": "Web design, website creation and SEO services for local businesses in Capbreton, Hossegor, Landes and the Pays Basque.",
    "provider": {
      "@type": "Person",
      "name": "Billy Nightingale",
      "url": "https://www.billynightingale.com/"
    },
    "areaServed": [
      "Capbreton",
      "Hossegor",
      "Landes",
      "Pays Basque"
    ]
  }
]

// TODO(MIGRATION_ISSUES #14): Google Fonts is loaded from Google's servers on this page only.
---

<BaseLayout
  lang="en"
  route="terms"
  title="Terms and Conditions of Service | Billy Nightingale"
  description="Portfolio of Billy Nightingale, web developer and designer based in Landes & Pays Basque, France. Terms and conditions page."
  robots="noindex, follow"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oxygen&family=Oxygen+Mono&display=swap" rel="stylesheet" media="print" onload="this.media = 'all'" />
  </Fragment>
  <Header lang="en" route="terms" />
  <main id="legal_main">
    <CookieBanner lang="en" />
    <h1>General Terms and Conditions of Sale</h1>
    <p>
      <strong
        >Billy Nightingale – Website Creation &amp; Web Development</strong
      >
    </p>
    <p>Based in Capbreton, France – contact@billynightingale.com</p>
    <section id="purpose">
      <h2>1. Purpose</h2>
      <p>
        These General Terms and Conditions of Sale define the terms under
        which Billy Nightingale, a sole trader (micro-entrepreneur), provides
        website creation, web development, SEO (search engine optimisation),
        maintenance, and hosting services to professional and private clients.
      </p>
      <p>
        Any order implies the client’s full and unconditional acceptance of
        these terms.
      </p>
    </section>

    <section id="quotes-orders">
      <h2>2. Quotations and Orders</h2>
      <p>
        Each project is subject to a personalised quotation, valid for 30 days
        from the date of issue.
      </p>
      <p>
        The order becomes firm and final once the client has dated and signed
        the quotation and paid a deposit of 50% of the total amount.
      </p>
      <p>No work will begin until this deposit has been received.</p>
    </section>

    <section id="pricing-payment">
      <h2>3. Pricing and Payment Terms</h2>
      <p>
        All prices are indicated in euros and VAT is not applicable (Article
        293 B of the French General Tax Code).
      </p>
      <p>Unless otherwise agreed in writing, payments are made as follows:</p>
      <ul>
        <li>50% upon acceptance of the quotation</li>
        <li>50% upon delivery of the project</li>
      </ul>
      <p>
        Invoices must be paid within 14 days from the date of issue, by bank
        transfer.
      </p>
    </section>
    <section id="late-payment">
      <h2>4. Late or Non-Payment</h2>
      <p>
        In the event of late payment, penalties will automatically apply at
        the legal interest rate increased by 10%, without the need for any
        reminder.
      </p>
      <p>
        A fixed compensation fee of €40, in accordance with Article D441-5 of
        the French Commercial Code, will also be due.
      </p>
    </section>

    <section id="delivery-approval">
      <h2>5. Delivery and Validation</h2>
      <p>
        Billy Nightingale undertakes to perform the services in accordance
        with the schedule agreed with the client.
      </p>
      <p>
        Any modification requested during the project may be subject to an
        amendment to the original quotation.
      </p>
      <p>
        Final delivery must be validated in writing by the client, by email or
        signed document.
      </p>
      <p>
        In the absence of feedback within 7 days after delivery, the project
        will be considered accepted.
      </p>
    </section>

    <section id="ip">
      <h2>6. Intellectual Property</h2>
      <p>
        All intellectual property rights, including code, design, content, and
        graphic elements, remain the property of Billy Nightingale until full
        payment of the agreed price.
      </p>
      <p>
        Once full payment has been made, the rights of use are transferred to
        the client.
      </p>
      <p>
        Billy Nightingale reserves the right to showcase completed work for
        reference and communication purposes, including on his website and
        social media.
      </p>
    </section>

    <section id="maintenance-hosting">
      <h2>7. Maintenance and Hosting</h2>
      <p>
        Maintenance, hosting, licensing, and email services may be offered as
        annual plans.
      </p>
      <p>Unless otherwise stated, these plans include:</p>
      <ul>
        <li>Technical updates, including CMS, themes, and plugins</li>
        <li>Backups</li>
        <li>Security monitoring</li>
        <li>Performance checks</li>
      </ul>
      <p>They do not include:</p>
      <ul>
        <li>Content modifications</li>
        <li>Website enhancements</li>
        <li>The addition of new features</li>
      </ul>
      <p>
        Any request outside this scope will be subject to an additional
        quotation.
      </p>
      <p>
        Hosting, licensing, and email services are provided only for the
        duration of the plan.
      </p>
      <p>
        In the event of cancellation, the client must ensure continuity of
        these services or request a migration service, billed separately.
      </p>
      <p>
        Specific terms, including duration, pricing, and scope, are defined in
        the associated quotation or commercial proposal.
      </p>
    </section>

    <section id="liability">
      <h2>8. Liability</h2>
      <p>
        Billy Nightingale is bound by an obligation of means in the
        performance of services.
      </p>
      <p>Liability cannot be held in cases of:</p>
      <ul>
        <li>Improper use of the website by the client</li>
        <li>Modifications carried out by a third party</li>
        <li>
          Failures or interruptions of services related to external providers,
          including hosting providers, registrars, plugins, etc.
        </li>
        <li>Temporary unavailability of the website beyond his control</li>
      </ul>
    </section>

    <section id="cancellation">
      <h2>9. Withdrawal and Cancellation</h2>
      <p>
        In the event of cancellation before the start of the project, the
        deposit will be retained as compensation.
      </p>
      <p>
        If cancellation occurs during the project, the client agrees to pay
        for the work already completed.
      </p>
      <p>Any work started is due in full.</p>
    </section>

    <section id="gdpr">
      <h2>10. Personal Data</h2>
      <p>
        Billy Nightingale undertakes to respect the confidentiality of
        information provided by the client and to comply with the General Data
        Protection Regulation (GDPR).
      </p>
    </section>

    <section id="law-jurisdiction">
      <h2>11. Applicable Law and Jurisdiction</h2>
      <p>These terms are governed by French law.</p>
      <p>
        Any dispute relating to their interpretation or execution falls under
        the exclusive jurisdiction of the Court of Dax, France.
      </p>
    </section>
    <section id="collaboration-obligation-client">
      <h2>12. Collaboration and Client Obligations</h2>
      <p>
        The client agrees to provide all content, information, and approvals
        necessary for the proper completion of the project within the agreed
        deadlines.
      </p>
      <p>
        Any delay in providing these elements may result in a postponement of
        the schedule without liability on the part of Billy Nightingale.
      </p>
    </section>
  </main>
</BaseLayout>
