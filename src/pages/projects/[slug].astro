---
// One page per client project that has a `page` part in src/data/projects.ts:
// /projects/monkey-mood and so on. The French pages are in fr/projets/.
import ProjectPage from '../../components/project/ProjectPage.astro'
import { clientProjects } from '../../data/projects'

export function getStaticPaths() {
  return clientProjects
    .filter((project) => project.page)
    .map((project) => ({ params: { slug: project.page!.slug }, props: { project } }))
}

const { project } = Astro.props
---

<ProjectPage project={project} lang="en" />
