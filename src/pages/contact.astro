---
import BaseLayout from '../layouts/BaseLayout.astro'
import { business, person, service } from '../data/schema'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactIntro from '../components/contact/ContactIntro.astro'
import ContactForm from '../components/contact/ContactForm.astro'

const jsonLd = [
  business('en'),
  person('en'),
  service('en'),
]
---

<BaseLayout
  lang="en"
  route="contact"
  title="Contact Billy Nightingale | Web Designer in Capbreton"
  description="Contact Billy Nightingale, web developer and designer based in Capbreton. Get in touch for modern, fast, SEO-optimised websites or to discuss your next project."
  og={{
    title: "Contact Billy Nightingale | Freelance Web Developer in Capbreton",
    description: "Get in touch with Billy Nightingale, web developer and designer based in Capbreton. Send a message or start a new website project via the contact form.",
  }}
  twitter={{
    title: "Contact Billy Nightingale | Freelance Web Developer in Capbreton",
    description: "Get in touch with Billy Nightingale for your next website project or any questions. Based in Capbreton, France.",
  }}
  jsonLd={jsonLd}
>
  <Header lang="en" route="contact" />
  <main>
    <ContactIntro lang="en" />
    <ContactForm lang="en" />
    <div class="gradient"></div>
  </main>
  <Footer lang="en" />
</BaseLayout>
