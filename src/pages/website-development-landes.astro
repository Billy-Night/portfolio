---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import CookieBanner from '../components/CookieBanner.astro'
import Footer from '../components/Footer.astro'

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.billynightingale.com/website-development-landes#service",
    "name": "Website Development in Landes",
    "description": "Professional website development services in Landes, including custom website design, SEO, performance optimisation and ongoing support.",
    "provider": {
      "@type": "Person",
      "@id": "https://www.billynightingale.com/#person",
      "name": "Billy Nightingale"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Landes"
    },
    "url": "https://www.billynightingale.com/website-development-landes"
  }
]
---

<BaseLayout
  lang="en"
  route="landes"
  title="Website Design & Development in Landes | Billy Nightingale"
  description="Website design in Landes for businesses that want to stand out online. Fast, modern websites focused on performance, SEO and generating enquiries."
  og={{
    title: "Website Development in Landes | Billy Nightingale",
    description: "Professional website development in Landes. Fast, modern websites designed to help local businesses improve visibility, attract customers and grow online.",
  }}
  twitter={{
    title: "Website Development in Landes | Billy Nightingale",
    description: "Professional website development in Landes. Fast, modern websites designed to help local businesses improve visibility, attract customers and grow online.",
  }}
  twitterDomain="billynightingale.com"
  jsonLd={jsonLd}
>
  <Header lang="en" route="landes" logoAlt="Billy Nightingales logo for creating websites" menuIconAlt="menu icon" />
  <main>
    <CookieBanner lang="en" />
    <section class="section-center-max-width">
      <div class="landes-hero-container">
        <div class="landes-hero-text-container">
          <h1 class="landes-hero__title">
            Website Design & Development in Landes
          </h1>
          <!-- <p>Built for growth, built to last, built for performance.</p> -->
        </div>
        <div class="landes-hero-img-container">
          <svg
            class="landes-hero-svg1"
            viewBox="0 0 900 900"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M873.597 146.264L853.224 338.41C852.802 342.453 850.077 345.881 846.245 347.234C842.413 348.588 838.142 347.621 835.277 344.756L796.816 306.295L485.226 617.867C483.257 619.836 480.568 620.961 477.773 620.961H265.904L124.312 762.553C122.255 764.609 119.548 765.646 116.859 765.646C114.169 765.646 111.462 764.609 109.406 762.553L29.4779 682.625C25.3646 678.512 25.3646 671.832 29.4779 667.701L207.263 489.916C209.232 487.947 211.921 486.822 214.716 486.822H426.568L701.947 211.443L663.486 172.982C660.62 170.117 659.636 165.846 661.007 162.014C662.361 158.182 665.788 155.475 669.831 155.035L861.978 134.662C865.142 134.328 868.288 135.435 870.556 137.685C872.806 139.935 873.931 143.082 873.597 146.264ZM851.238 157.004L694.019 173.685L724.324 203.99C728.437 208.103 728.437 214.783 724.324 218.914L438.398 504.84C436.429 506.809 433.74 507.934 430.945 507.934H219.093L51.8549 675.172L116.859 740.176L254.091 602.943C256.06 600.975 258.749 599.85 261.544 599.85H473.396L789.345 283.9C793.458 279.787 800.138 279.787 804.251 283.9L834.556 314.205L851.238 157.004Z"
              fill="#DCA868"
            />
          </svg>
          <svg
            class="landes-hero-svg2"
            width="682"
            height="682"
            viewBox="0 0 682 682"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M367.693 468.205L603.809 232.103L598.148 215.133L358.729 454.552H198.192C196.075 454.552 194.037 455.405 192.545 456.897L88.553 560.888L94.2008 577.845L201.496 470.55H362.046C364.164 470.55 366.202 469.697 367.693 468.205Z"
              fill="#DCA868"
            />
          </svg>

          <img
            class="landes-hero-img"
            src="/assets/portraits/billy_nightingale_web_designer_v2.webp"
            alt="Billy Nightingale - web designer and developer discussing website creation with clients"
          />
        </div>
      </div>
      <div class="landes-cta-container">
        <div class="cta-container">
          <a class="btn__primary btn__prim--light" href="/contact"
            >Launch a project</a
          >
        </div>
      </div>
    </section>
    <!-- <section class="hero-phone">
      <div class="phone-channel">
        <div class="phone-container">
          <script
            type="module"
            src="https://unpkg.com/@splinetool/viewer@1.12.97/build/spline-viewer.js" ></script>
          <spline-viewer
            url="https://prod.spline.design/6Ah4mrnEZLN8QiV3/scene.splinecode"
          ></spline-viewer>
        </div>
      </div>
    </section> -->
    <section class="section-pad">
      <div class="static-phone-channel">
        <div class="phone-iteractive-content-container">
          <div class="static-phone-container">
            <img
              class="static-phone-img"
              src="/assets/landes_phone/phone_web_performance.webp"
              alt="Phone containing screens that illustrate website performance, SEO optimisation and solving business issues with technology"
            />
          </div>
          <div class="phone-text-container">
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Fast websites create better first impressions
              </h2>
              <p class="max-txt-width">
                Visitors expect websites to load quickly, especially on mobile
                devices.
              </p>
              <p class="max-txt-width">
                Every website I build is optimised for performance, helping
                local businesses provide a smoother experience, improve search
                visibility and convert more visitors into customers.
              </p>
            </div>
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Helping local businesses get found online
              </h2>
              <p class="max-txt-width">
                A beautiful website is only valuable if people can find it.
              </p>
              <p class="max-txt-width">
                I work with businesses across the Landes region to improve
                visibility through technical SEO, local search optimisation
                and a strong website foundation.
              </p>
            </div>
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Every business has different challenges
              </h2>
              <p class="max-txt-width">
                Some businesses need more reservations, others want to sell
                products online, improve visibility or modernise their
                customer experience.
              </p>
              <p class="max-txt-width">
                My approach is to understand the problem first, then design
                and build a solution that supports your business goals.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="landes-mission-section">
      <div class="landes-mission-container">
        <h2>grow your business</h2>
        <div class="mission-text-container">
          <p class="max-txt-width">
            I craft premium web sites and digital systems in the region of
            Landes, France.
          </p>
          <p class="max-txt-width">
            The objective is to support local business in developing and
            growing in their local market. Which is achieved by ongoing
            support and growth strategies tailored for the Landes region.
          </p>
          <p class="max-txt-width">
            With a strong focus on building high performance website’s with a
            95+ score and top ranking websites in search results.
          </p>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="wid__sec">
      <div class="wid__heading-container">
        <h2>Top ranking sites in Landes</h2>
        <p>My proven local SEO strategeis</p>
      </div>
      <div class="wid__content-container">
        <div class="row">
          <div class="wid__img-cont">
            <img
              src="/assets/landes_seo_mockups/monkey_mood_seo_mockup.webp"
              alt="Monkey Mood, one of Billy Nightingales clients ranking high in Google Search results, with excellent SEO"
            />
          </div>
          <div class="wid__text-cont txt-r">
            <div class="wid__text box__shadow">
              <div class="max-txt-width">
                <h3>Monkey Mood restaurant</h3>
                <p>
                  Monkey Mood is a local restaurant which focuses on
                  Indonesian vegan cuisine.
                </p>
                <p>
                  They are a top ranking website in Google search results for
                  both their location in Capbreton and Bordeaux.
                </p>
                <div class="wid__content_cta">
                  <a class="btn__primary btn__prim--dark" href="/services"
                    >SERVICES</a
                  >
                  <a class="btn__second btn__second--dark" href="/#projects"
                    >PROJECTS</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="wid__img-cont-right right">
            <img
              src="/assets/landes_seo_mockups/Pacific_Coast_cafe_seo_mockup.webp"
              alt="Pacific Coast Cafe one of Billy Nightingales clients ranking high in Google search results"
            />
          </div>
          <div class="wid__text-cont txt-l">
            <div class="wid__text box__shadow">
              <div class="max-txt-width">
                <h3>Pacific Coast Cafe</h3>
                <p>
                  Pacific coast cafe is a local cafe in the centre of
                  Hossegor, I worked with them to improve their sites
                  performance and SEO. While integrating a online shop
                </p>
                <p>
                  The result are easy to see as the website is 20% faster and
                  also performs excellently in Google search results
                </p>
                <div class="wid__content_cta">
                  <a class="btn__primary btn__prim--dark" href="/services"
                    >SERVICES</a
                  >
                  <a class="btn__second btn__second--dark" href="/#projects"
                    >PROJECTS</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="landes-approach-section">
      <div class="subheading-centred">
        <h2>My approach for local businesses in Landes</h2>
        <p class="max-txt-width">
          My approach combines thoughtful design with technical performance,
          creating websites that not only look professional but help local
          businesses grow online.
        </p>
      </div>
      <div class="lan-approach-content-cont">
        <div class="lan-approach-row1">
          <div class="lan-approach-design approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>Design</h3>
            </div>

            <p class="max-txt-width">
              My designs are focused on bringing out the companies visual
              identity and crafting a design for the local culture, they are
              designed to be affective for the Landes market.
            </p>
            <p class="max-txt-width">
              This means improving conversions and increasing growth, locally
              in Landes.
            </p>
          </div>
          <div class="lan-approach-design approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>performance</h3>
            </div>

            <p class="max-txt-width">
              Each site is optimised for performance and visibility in the
              local Landes market to convert clients.
            </p>
            <p class="max-txt-width">
              Faster websites provide a better user experience and stronger
              SEO performance, helping local businesses attract more visitors
              and generate more enquiries.
            </p>
          </div>
        </div>
        <div class="lan-approach-row2">
          <div class="lan-approach-performance approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>Solve Business problems</h3>
            </div>
            <p class="max-txt-width">
              Every business is different. Some need more reservations, some
              need more visibility and others need a better way to sell
              online. My goal is to understand the challenges behind the
              website and build a solution around them.
            </p>
            <p>See some tailored solutions for local businesses below.</p>
          </div>
        </div>
      </div>
      <div class="approach-cta-cont">
        <p class="max-txt-width">
          As your digital local partner I offer ongoing support packages to
          insure your website stays at top performance while generating
          growth.
        </p>
        <div class="cta-container">
          <a class="btn__primary btn__prim--light" href="/services"
            >SERVICES</a
          >
          <a class="btn__second btn__second--light" href="/#projects"
            >PROJECTS</a
          >
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="layout-two-column content-cont-marg-right">
        <div class="layout-two-column-img img-overlay-blur-left">
          <img
            class="img-rad"
            src="/assets/client_meetings/billy_nightingale_web_designer_rendez_vous_avec_pacific_coast_cafe_hossegor.webp"
            alt="Billy Nightingale web designer having a meeting with clients in Hossegor"
          />
        </div>
        <div
          class="layout-two-column-txt contact__txt-normal-flow glass__back loc-mob-margin-left"
        >
          <h2>Studio in landes</h2>
          <p>
            My handmade custom built studio is based in Capbreton, Landes,
            France.
          </p>
          <p class="max-txt-width">
            I believe good websites are built through attention to detail,
            clear communication and long-term thinking. The studio was created
            as a dedicated space for focused design and development work.
          </p>
          <p class="max-txt-width">
            Being based in capbreton allows me to understand local business
            and the local market, which is very important when designing and
            creating website and systems for clients.
          </p>
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="subheading-centred">
        <h2>Real challenges, tailored solutions</h2>
        <p>I find tailored solution to my clients requirements</p>
      </div>
      <div class="layout-two-column lan-chall-cont">
        <div class="ver-switcher-btn-cont">
          <button class="ver-switcher-btn is-active" data-index="0">
            <h3>Simplifying reservation across locations</h3>
          </button>
          <button class="ver-switcher-btn" data-index="1">
            <h3>Creating new revenue opportunities</h3>
          </button>
          <button class="ver-switcher-btn" data-index="2">
            <h3>Launching a brand online from day one</h3>
          </button>
        </div>
        <div class="ver-switcher-content">
          <div class="ver-switcher-content-txt is-active">
            <h3>Multi-location booking</h3>
            <p>Client: Monkey Mood</p>
            <h3>Challenge</h3>
            <p class="max-txt-width">
              Monkey Mood operates restaurants in both Capbreton and Bordeaux.
              Customers needed a clearer way to navigate between locations and
              complete reservations.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Redesigned and rebuilt the website with a simplified booking
              journey, improved mobile experience and clearer location
              structure.
            </p>
          </div>
          <div class="ver-switcher-content-txt">
            <h3>Creating new revenue opportunities</h3>
            <p>Client: Pacific Coast Cafe</p>
            <h3>Challenge</h3>
            <p class="max-txt-width">
              Pacific Coast Café needed a stronger digital platform to support
              future growth and create additional revenue streams beyond the
              physical café.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Improved website performance and integrated an online shop,
              creating a foundation for e-commerce, gift cards and future
              expansion.
            </p>
          </div>
          <div class="ver-switcher-content-txt">
            <h3>Launching a brand online from day one</h3>
            <p>Client: Turbulente Kombucha</p>
            <h3>Challenge</h3>
            <p class="max-txt-width">
              Turbulente Kombucha needed its first online presence to reflect
              its identity and connect with customers beyond local
              distribution.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Designed and developed the company's first e-commerce website
              with a visual identity inspired by surfing, nature and the local
              coastline.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="sections">
      <div class="section-contact-container">
        <h2>Ready to discuss your project</h2>
        <p>Book a call or request a quote now</p>
        <div class="cta-container">
          <a
            class="btn__primary btn__prim--light"
            href="mailto:contact@billynightingale.com"
            >PAR MAIL</a
          >
          <a class="btn__second btn__second--light" href="/contact"
            >Quote</a
          >
        </div>
      </div>
    </section>  </main>
  <Footer lang="en" />
</BaseLayout>
