---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import CookieBanner from '../components/CookieBanner.astro'
import Footer from '../components/Footer.astro'

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.billynightingale.com/#person",
    "name": "Billy Nightingale",
    "jobTitle": "Web designer & web developer",
    "url": "https://www.billynightingale.com/",
    "image": "https://www.billynightingale.com/assets/billy_portrait.webp",
    "description": "Web designer and developer in Capbreton, creating modern, fast, SEO-optimised websites for local businesses.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Capbreton",
      "addressRegion": "Landes",
      "addressCountry": "FR"
    },
    "sameAs": [
      "https://www.linkedin.com/in/billynightingale/",
      "https://github.com/Billy-Night"
    ],
    "knowsAbout": [
      "web design",
      "website creation",
      "front-end development",
      "WordPress",
      "SEO",
      "local SEO",
      "performance optimisation"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.billynightingale.com/services/#service",
    "name": "Web design, web development and SEO services",
    "serviceType": [
      "Web design",
      "Web development",
      "SEO"
    ],
    "provider": {
      "@type": "Person",
      "@id": "https://www.billynightingale.com/#person"
    },
    "areaServed": [
      "Capbreton",
      "Hossegor",
      "Landes",
      "Pays Basque"
    ],
    "url": "https://www.billynightingale.com/services"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.billynightingale.com/services/#webpage",
    "url": "https://www.billynightingale.com/services",
    "name": "Services | Billy Nightingale",
    "inLanguage": "en-GB",
    "description": "Web design, web development and SEO services in Capbreton, Hossegor, Landes and the Pays Basque.",
    "about": {
      "@id": "https://www.billynightingale.com/services/#service"
    },
    "primaryImageOfPage": {
      "@type": "ImageObject",
