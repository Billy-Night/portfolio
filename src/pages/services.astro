// TODO(pre-existing, MIGRATION_ISSUES #6): "#projects" does not exist on this page
---

<BaseLayout
  lang="en"
  route="services"
  title="Billy Nightingale | Services"
  description="Web design, development and SEO services in Capbreton. Helping small businesses build fast, modern websites. Request a quote or get in touch."
  og={{
    title: "Billy Nightingale | Web design, web development & SEO services",
    description: "Web design, development and SEO services in Capbreton. Helping small businesses build fast, modern websites. Request a quote or get in touch.",
  }}
  twitter={{
    title: "Billy Nightingale | Web design, web development & SEO services",
    description: "Web design, development and SEO services in Capbreton. Helping small businesses build fast, modern websites. Request a quote or get in touch.",
  }}
  ogSiteName="Billy Nightingale"
  ogImageAlt="Billy Nightingale – Web design, development & SEO services"
  twitterDomain="https://www.billynightingale.com/"
  ogImageHeight="600"
  jsonLd={jsonLd}
>
  <Header lang="en" route="services" logoAlt="Billy Nightingales logo for creating websites" />
  <main>
    <CookieBanner lang="en" />
    <section class="services-hero-section">
      <div class="services-intro-container">
        <div class="services-intro-img-frame">
          <h2>
            <a
              href="#services-page__main-services"
              class="paint-text flip-text"
              data-replace="Web design"
              ><span>Web design</span></a
            >
          </h2>
          <h2>
            <a
              href="#services-page__main-services"
              class="paint-text flip-text"
              data-replace="Web Development"
              ><span>Web Development</span></a
            >
          </h2>
          <h2>
            <a
              href="#services-page__main-services"
              class="paint-text flip-text"
              data-replace="SEO"
              ><span>SEO</span></a
            >
          </h2>
          <h2>
            <a
              href="#services-page__sec-service-addons"
              class="paint-text flip-text"
              data-replace="Performance"
              ><span>Performance</span></a
            >
          </h2>
          <h2>
            <a
              href="#services__page-sec-project-management"
              class="paint-text flip-text"
              data-replace="Project Management"
              ><span>Project Management</span></a
            >
          </h2>
          <img
            src="/assets/portraits/portrait_sitting_working_v2.webp"
            alt="Billy Nightingale sitting at his MacBook working on web design"
          />
        </div>
      </div>
    </section>
    <section class="services-intro-section">
      <div class="services__hero-text">
        <h1>Web design, development & SEO for growing businesses</h1>
        <div class="services__hero-sub-heading">
          <h2 class="max-txt-width">
            I help businesses build fast, modern websites that attract clients
            and support long-term growth.
          </h2>
        </div>
      </div>
      <div class="services__hero-link">
        <a class="hero__contact-link" href="/contact">[ START A PROJECT ]</a>
      </div>
    </section>
    <div class="gradient"></div>
    <section
      class="sections sec-services-main"
      id="services-page__main-services"
    >
      <div class="services-main-title">
        <h2 class="section-sub-headings">Main Services</h2>
        <h3>Are you ready to build your dream digital experience ?</h3>
      </div>
      <div class="services-main-blocks">
        <div class="service-card">
          <h2>Web Design</h2>
          <p class="max-txt-width">
            Thoughtful, user-focused design that reflects your brand and makes
            it easy for visitors to take action.
          </p>
        </div>
        <div class="service-card">
          <h2>Web Développement</h2>
          <p class="max-txt-width">
            Clean, fast, and reliable websites built to scale, maintain, and
            perform long-term.
          </p>
        </div>
        <div class="service-card">
          <h2>SEO</h2>
          <p>
            Solid technical and on-page foundations so your site can be found
            by the right people.
          </p>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section
      class="sections sec-service-addons"
      id="services-page__sec-service-addons"
    >
      <h2 class="section-sub-headings">Built for performance & Longevity</h2>
      <div class="sec-service-addons-content-container">
        <div class="addons-content-container">
          <div class="addons-performance-img-frame">
            <img
              src="/assets/icons/performance_arrow.svg"
              alt="icon indicating improving web performance"
            />
          </div>
          <div class="addons-performance-text-container">
            <h2>Performance & Accessibility</h2>
            <p>
              I ensure all my clients sites are performance tested before and
              after deployment, to ensure the best service.
            </p>
            <p>
              All my sites are built to industry standard and meet all
              accessibility requirements.
            </p>
          </div>
        </div>
        <div class="addons-content-container">
          <div class="addons-performance-img-frame">
            <img
              alt="icon tech stack"
              src="/assets/icons/tech_stack_icon.svg"
            />
          </div>
          <div class="addons-performance-text-container">
            <h2>Maintenance & Hosting</h2>
            <p>
              I offer care packages for all my sites, keep them updated and my
              clients stress free.
            </p>
            <p>
              Providing fast and reliable hosting for all my custom built
              sites.
            </p>
          </div>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section
      class="sections sec-project-management"
      id="services__page-sec-project-management"
    >
      <h2 class="section-sub-headings">Project Management</h2>
      <div class="project-management-container">
        <div class="task-card"><h3>Discovery & Goals</h3></div>
        <div class="task-card"><h3>Design & Structure</h3></div>
        <div class="task-card"><h3>Développement & Testing</h3></div>
        <div class="task-card"><h3>Launch & Support</h3></div>
      </div>
      <p class="project-management-hook">
        A clear, collaborative process from first call to launch.
      </p>
    </section>
    <div class="gradient"></div>
    <section class="sections-large packages" aria-labelledby="packages-title">
      <div class="packages__container">
        <div class="packages__header">
          <div class="packages__heading">
            <p class="packages__eyebrow">Website packages</p>
            <h2 id="packages-title" class="packages__title">
              Three paths. One purpose.<br />
              Your online growth.
            </h2>
          </div>
          <p class="packages__intro">
            Choose the website package that meets you where you are and gives
            you the foundation to grow with confidence.
          </p>
        </div>
        <div class="packages__grid">
          <!-- Starter package -->
          <article class="package-card package-card--featured">
            <div class="package-card__top">
              <div>
                <div class="package-card__label">
                  <span>Start your presence</span>
                  <span class="package-card__label-line"></span>
                </div>
                <h3 class="package-card__title">Starter Website</h3>
              </div>
              <div class="package-card__icon" aria-hidden="true">
                <svg viewBox="0 0 64 64">
                  <rect x="14" y="20" width="28" height="28" />
                  <rect x="24" y="10" width="28" height="28" />
                </svg>
              </div>
            </div>
            <div
              class="package-card__divider package-card__divider--short"
            ></div>
            <div class="package-card__label">
              <span>From <span class="package-card__price">€700</span></span>
            </div>
            <p class="package-card__description">
              A professional one-page website designed to establish your
              online presence and create a strong foundation for future
              growth.
            </p>
            <ul class="package-card__features">
              <li>
                <div class="bullet-point-container">
                  <svg
                    class="default-svg bullet-point-svg"
                    enable-background="new 0 0 512.087 512.087"
