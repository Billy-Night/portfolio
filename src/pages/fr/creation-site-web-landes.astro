---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import CookieBanner from '../../components/CookieBanner.astro'
import Footer from '../../components/Footer.astro'

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.billynightingale.com/fr/creation-site-web-landes#service",
    "name": "Création de site internet dans les Landes",
    "description": "Services professionnels de création de sites internet dans les Landes, incluant la conception de sites sur mesure, le référencement naturel (SEO), l’optimisation des performances et l’accompagnement continu.",
    "provider": {
      "@type": "Person",
      "@id": "https://www.billynightingale.com/#person",
      "name": "Billy Nightingale"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Landes"
    },
    "url": "https://www.billynightingale.com/fr/creation-site-web-landes"
  }
]
---

<BaseLayout
  lang="fr"
  route="landes"
  title="Création de site internet dans les Landes | Billy Nightingale"
  description="Création de sites web sur mesure dans les Landes. Design, référencement local, performance et accompagnement pour développer votre activité."
  og={{
    title: "Création de sites web dans les Landes | Billy Nightingale",
    description: "Sites web sur mesure, référencement local et solutions digitales pour les entreprises des Landes. Basé à Capbreton.",
  }}
  twitter={{
    title: "Création de sites web dans les Landes | Billy Nightingale",
    description: "Sites web sur mesure, référencement local et solutions digitales pour les entreprises des Landes. Basé à Capbreton.",
  }}
  jsonLd={jsonLd}
>
  <Header lang="fr" route="landes" />
  <main>
    <CookieBanner lang="fr" />
    <section class="section-center-max-width">
      <div class="landes-hero-container">
        <div class="landes-hero-text-container">
          <h1 class="landes-hero__title">
            Création de sites web dans les Landes
          </h1>
        </div>

        <div class="landes-hero-img-container">
          <svg
            class="landes-hero-svg1"
            viewBox="0 0 900 900"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M873.597 146.264L853.224 338.41C852.802 342.453 850.077 345.881 846.245 347.234C842.413 348.588 838.142 347.621 835.277 344.756L796.816 306.295L485.226 617.867C483.257 619.836 480.568 620.961 477.773 620.961H265.904L124.312 762.553C122.255 764.609 119.548 765.646 116.859 765.646C114.169 765.646 111.462 764.609 109.406 762.553L29.4779 682.625C25.3646 678.512 25.3646 671.832 29.4779 667.701L207.263 489.916C209.232 487.947 211.921 486.822 214.716 486.822H426.568L701.947 211.443L663.486 172.982C660.62 170.117 659.636 165.846 661.007 162.014C662.361 158.182 665.788 155.475 669.831 155.035L861.978 134.662C865.142 134.328 868.288 135.435 870.556 137.685C872.806 139.935 873.931 143.082 873.597 146.264ZM851.238 157.004L694.019 173.685L724.324 203.99C728.437 208.103 728.437 214.783 724.324 218.914L438.398 504.84C436.429 506.809 433.74 507.934 430.945 507.934H219.093L51.8549 675.172L116.859 740.176L254.091 602.943C256.06 600.975 258.749 599.85 261.544 599.85H473.396L789.345 283.9C793.458 279.787 800.138 279.787 804.251 283.9L834.556 314.205L851.238 157.004Z"
              fill="#DCA868"
            />
          </svg>
          <svg
            class="landes-hero-svg2"
            width="682"
            height="682"
            viewBox="0 0 682 682"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M367.693 468.205L603.809 232.103L598.148 215.133L358.729 454.552H198.192C196.075 454.552 194.037 455.405 192.545 456.897L88.553 560.888L94.2008 577.845L201.496 470.55H362.046C364.164 470.55 366.202 469.697 367.693 468.205Z"
              fill="#DCA868"
            />
          </svg>

          <img
            class="landes-hero-img"
            src="/assets/portraits/billy_nightingale_web_designer_v2.webp"
            alt="Billy Nightingale web designer et développeur parler avec des clients"
          />
        </div>
      </div>
      <div class="landes-cta-container">
        <div class="cta-container">
          <a class="btn__primary btn__prim--light" href="/fr/contact"
            >Lancer un projet</a
          >
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="static-phone-channel">
        <div class="phone-iteractive-content-container">
          <div class="static-phone-container">
            <img
              class="static-phone-img"
              src="/assets/landes_phone/phone_web_performance_fr.webp"
              alt="Smartphone affichant les performances d’un site web optimisé avec d’excellents scores de vitesse et de référencement."
            />
          </div>
          <div class="phone-text-container">
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Des sites rapides pour une meilleure première impression
              </h2>
              <p class="max-txt-width">
                Les visiteurs s’attendent à ce qu’un site web charge
                rapidement, particulièrement sur mobile.
              </p>
              <p class="max-txt-width">
                Chaque site que je crée est optimisé pour la performance afin
                d’offrir une expérience fluide, d’améliorer votre visibilité
                sur Google et de transformer davantage de visiteurs en
                clients.
              </p>
            </div>
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Aider les entreprises landaises à être trouvées en ligne
              </h2>
              <p class="max-txt-width">
                Un beau site internet n’a de valeur que s’il est visible.
              </p>
              <p class="max-txt-width">
                J’accompagne les entreprises des Landes dans l’amélioration de
                leur présence en ligne grâce au référencement naturel (SEO), à
                l’optimisation locale et à des fondations techniques solides.
              </p>
            </div>
            <div class="phone-text-content-cont max-txt-width">
              <h2 class="static-phone-title">
                Chaque entreprise a ses propres défis
              </h2>
              <p class="max-txt-width">
                Certaines entreprises ont besoin de davantage de réservations,
                d’autres souhaitent vendre en ligne, gagner en visibilité ou
                moderniser leur expérience client.
              </p>
              <p class="max-txt-width">
                Mon approche consiste à comprendre vos objectifs avant de
                concevoir et développer une solution adaptée à votre activité.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="landes-mission-section">
      <div class="landes-mission-container">
        <h2>Développez votre activité</h2>
        <div class="mission-text-container">
          <p class="max-txt-width">
            Je conçois des sites web haut de gamme et des solutions digitales
            pour les entreprises situées dans les Landes.
          </p>
          <p class="max-txt-width">
            Mon objectif est d’accompagner les entreprises locales dans leur
            développement grâce à un suivi personnalisé et à des stratégies de
            croissance adaptées au marché landais.
          </p>
          <p class="max-txt-width">
            Je mets un point d’honneur à créer des sites performants, obtenant
            régulièrement des scores supérieurs à 95/100 et de solides
            résultats dans les moteurs de recherche.
          </p>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="wid__sec">
      <div class="wid__heading-container">
        <h2>Des sites bien positionnés dans les Landes</h2>
        <p>Des stratégies SEO locales qui donnent des résultats</p>
      </div>
      <div class="wid__content-container">
        <div class="row">
          <div class="wid__img-cont">
            <img
              src="/assets/landes_seo_mockups/monkey_mood_seo_mockup.webp"
              alt="Monkey Mood, l’un des clients de Billy Nightingale, bien positionné dans les résultats de recherche Google grâce à un excellent référencement naturel (SEO)."
            />
          </div>
          <div class="wid__text-cont txt-r">
            <div class="wid__text box__shadow">
              <div class="max-txt-width">
                <h3>Restaurant Monkey Mood</h3>
                <p>
                  Monkey Mood est un restaurant local spécialisé dans la
                  cuisine végétale indonésienne.
                </p>
                <p>
                  Le site bénéficie d’un excellent positionnement sur Google
                  pour ses deux établissements à Capbreton et Bordeaux.
                </p>
                <div class="wid__content_cta">
                  <a class="btn__primary btn__prim--dark" href="/fr/services"
                    >SERVICES</a
                  >
                  <a
                    class="btn__second btn__second--dark"
                    href="/fr/#projects"
                    >PROJECTS</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="wid__img-cont-right right">
            <img
              src="/assets/landes_seo_mockups/Pacific_Coast_cafe_seo_mockup.webp"
              alt="Pacific Coast Café, client de Billy Nightingale, affichant un excellent positionnement dans les résultats de recherche Google."
            />
          </div>
          <div class="wid__text-cont txt-l">
            <div class="wid__text box__shadow">
              <div class="max-txt-width">
                <h3>Pacific Coast Café</h3>
                <p>
                  Pacific Coast Café est un café situé au cœur d’Hossegor.
                  J’ai travaillé avec l’équipe afin d’améliorer les
                  performances du site, son référencement naturel et
                  d’intégrer une boutique en ligne.
                </p>
                <p>
                  Les résultats sont visibles : le site est environ 20 % plus
                  rapide et obtient d’excellentes performances dans les
                  résultats de recherche Google.
                </p>
                <div class="wid__content_cta">
                  <a class="btn__primary btn__prim--dark" href="/fr/services"
                    >SERVICES</a
                  >
                  <a
                    class="btn__second btn__second--dark"
                    href="/fr/#projects"
                    >PROJECTS</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="gradient"></div>
    <section class="landes-approach-section">
      <div class="subheading-centred">
        <h2>Mon approche pour les entreprises des Landes</h2>
        <p class="max-txt-width">
          J’associe design réfléchi et performance technique afin de créer des
          sites web qui inspirent confiance, renforcent votre image de marque
          et contribuent au développement de votre activité.
        </p>
      </div>
      <div class="lan-approach-content-cont">
        <div class="lan-approach-row1">
          <div class="lan-approach-design approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>Design</h3>
            </div>

            <p class="max-txt-width">
              Mes créations mettent en valeur l’identité visuelle de chaque
              entreprise tout en s’inspirant de la culture locale et de
              l’environnement des Landes.
            </p>
            <p class="max-txt-width">
              L’objectif est d’améliorer les conversions et de soutenir votre
              croissance locale.
            </p>
          </div>
          <div class="lan-approach-design approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>performance</h3>
            </div>

            <p class="max-txt-width">
              Chaque site est optimisé pour offrir rapidité, visibilité et
              efficacité sur le marché local.
            </p>
            <p class="max-txt-width">
              Un site rapide améliore l’expérience utilisateur, favorise le
              référencement naturel et aide votre entreprise à attirer
              davantage de visiteurs qualifiés.
            </p>
          </div>
        </div>
        <div class="lan-approach-row2">
          <div class="lan-approach-performance approach-cont">
            <svg
              class="lan-approach-svg"
              width="302"
              height="102"
              viewBox="0 0 302 102"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
                stroke="none"
                stroke-width="2"
              />
            </svg>
            <div class="approach-design-heading">
              <h3>Résoudre des problèmes</h3>
            </div>
            <p class="max-txt-width">
              Chaque entreprise est différente. Certaines cherchent à
              augmenter leurs réservations, d’autres à gagner en visibilité ou
              à vendre plus efficacement en ligne. Mon rôle consiste à
              comprendre ces enjeux afin de construire une solution adaptée.
            </p>
            <p>
              Découvrez quelques exemples de solutions mises en place pour des
              entreprises locales.
            </p>
          </div>
        </div>
      </div>
      <div class="approach-cta-cont">
        <p class="max-txt-width">
          En tant que partenaire digital local, je propose également un
          accompagnement continu afin de maintenir votre site performant,
          sécurisé et capable de soutenir votre croissance.
        </p>
        <div class="cta-container">
          <a class="btn__primary btn__prim--light" href="/fr/services"
            >SERVICES</a
          >
          <a class="btn__second btn__second--light" href="/fr/#projects"
            >PROJECTS</a
          >
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="layout-two-column content-cont-marg-right">
        <div class="layout-two-column-img img-overlay-blur-left">
          <img
            class="img-rad"
            src="/assets/client_meetings/billy_nightingale_web_designer_rendez_vous_avec_pacific_coast_cafe_hossegor.webp"
            alt="Billy Nightingale, concepteur et développeur web, en rendez-vous avec des clients à Hossegor"
          />
        </div>
        <div
          class="layout-two-column-txt contact__txt-normal-flow glass__back loc-mob-margin-left"
        >
          <h2>Studio web dans les Landes</h2>
          <p>
            Mon studio de création web est basé à Capbreton, dans les Landes.
          </p>
          <p class="max-txt-width">
            Je suis convaincu que les meilleurs sites web naissent de
            l’attention portée aux détails, d’une communication claire et
            d’une vision à long terme. Ce studio a été conçu comme un espace
            dédié à la création et au développement de solutions digitales de
            qualité.
          </p>
          <p class="max-txt-width">
            Être implanté à Capbreton me permet de comprendre les entreprises
            locales, leur marché et leurs clients, un atout essentiel pour
            concevoir des sites web efficaces et adaptés à leur environnement.
          </p>
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="subheading-centred">
        <h2>Des défis concrets, des solutions sur mesure</h2>
        <p>Des solutions adaptées aux besoins réels de chaque client</p>
      </div>
      <div class="layout-two-column lan-chall-cont">
        <div class="ver-switcher-btn-cont">
          <button class="ver-switcher-btn is-active" data-index="0">
            <h3>
              Simplifier les réservations entre plusieurs établissements
            </h3>
          </button>
          <button class="ver-switcher-btn" data-index="1">
            <h3>Créer des opportunités de revenus</h3>
          </button>
          <button class="ver-switcher-btn" data-index="2">
            <h3>Lancer une marque en ligne</h3>
          </button>
        </div>
        <div class="ver-switcher-content">
          <div class="ver-switcher-content-txt is-active">
            <h3>
              Simplifier les réservations entre plusieurs établissements
            </h3>
            <p>Client: Monkey Mood</p>
            <h3>Défi</h3>
            <p class="max-txt-width">
              Monkey Mood possède deux restaurants, à Capbreton et à Bordeaux.
              Les clients avaient besoin d’un parcours plus clair pour choisir
              leur établissement et réserver facilement.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Refonte complète du site avec un parcours de réservation
              simplifié, une expérience mobile améliorée et une structure plus
              claire entre les différents établissements.
            </p>
          </div>
          <div class="ver-switcher-content-txt">
            <h3>Créer de nouvelles opportunités de revenus</h3>
            <p>Client: Pacific Coast Cafe</p>
            <h3>Défi</h3>
            <p class="max-txt-width">
              Pacific Coast Café souhaitait renforcer sa présence en ligne
              afin de soutenir sa croissance et développer de nouvelles
              sources de revenus au-delà du café physique.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Optimisation des performances du site et intégration d’une
              boutique en ligne, ouvrant la voie à l’e-commerce, aux cartes
              cadeaux et à de futurs développements.
            </p>
          </div>
          <div class="ver-switcher-content-txt">
            <h3>Lancer une marque en ligne dès le premier jour</h3>
            <p>Client: Turbulente Kombucha</p>
            <h3>Défi</h3>
            <p class="max-txt-width">
              Turbulente Kombucha avait besoin de sa première présence en
              ligne afin de présenter son identité de marque et de toucher ses
              clients au-delà de son réseau de distribution local.
            </p>
            <h3>Solution</h3>
            <p class="max-txt-width">
              Conception et développement du premier site e-commerce de la
              marque, avec une identité visuelle inspirée du surf, de la
              nature et du littoral landais.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="sections">
      <div class="section-contact-container">
        <h2>Prêt à discuter de votre projet ?</h2>
        <p>Réservez un appel ou demandez un devis dès aujourd’hui.</p>
        <div class="cta-container">
          <a
            class="btn__primary btn__prim--light"
            href="mailto:contact@billynightingale.com"
            >PAR MAIL</a
          >
          <a class="btn__second btn__second--light" href="/fr/contact"
            >Devis</a
          >
        </div>
      </div>
    </section>  </main>
  <Footer lang="fr" />
</BaseLayout>
