---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import CookieBanner from '../../components/CookieBanner.astro'
import Footer from '../../components/Footer.astro'

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.billynightingale.com/fr/#person",
    "name": "Billy Nightingale",
    "jobTitle": "Web designer et développeur web",
    "url": "https://www.billynightingale.com/fr/",
    "image": "https://www.billynightingale.com/assets/billy_portrait.webp",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Capbreton",
      "addressRegion": "Nouvelle-Aquitaine",
      "addressCountry": "FR"
    }
  }
]
---

<BaseLayout
  lang="fr"
  route="contact"
  title="Contact | Billy Nightingale, Web Designer à Capbreton"
  description="Contactez Billy Nightingale, développeur web et designer web à Capbreton. Discutons de votre site moderne, rapide et optimisé SEO."
  og={{
    title: "Contactez Billy Nightingale | Développeur Web Freelance à Capbreton",
    description: "Contactez Billy Nightingale, développeur web et designer web basé à Capbreton. Envoyez un message ou démarrez un nouveau projet via le formulaire de contact.",
  }}
  twitter={{
    title: "Contactez Billy Nightingale | Développeur Web Freelance à Capbreton",
    description: "Envoyez un message ou discutez de votre projet web avec Billy Nightingale, développeur web et designer web à Capbreton.",
  }}
  jsonLd={jsonLd}
>
  <Header lang="fr" route="contact" />
  <main>
    <CookieBanner lang="fr" />
    <section class="section-pad">
      <div class="layout-two-column content-cont-marg-right">
        <div class="layout-two-column-img img-overlay-blur-left">
          <img
            class="img-rad"
            src="/assets/client_meetings/billy_nightingale_web_designer_rendez_vous_avec_pacific_coast_cafe_hossegor.webp"
            alt="Billy Nightingale web designer having a meeting with clients in Hossegor"
          />
        </div>
        <div
          class="layout-two-column-txt contact__txt-normal-flow glass__back loc-mob-margin-left"
        >
          <h1 class="trans-caps">Travaillons ensemble</h1>
          <p class="max-txt-width">
            J’aime travailler en étroite collaboration avec mes clients et
            transformer des idées techniques en solutions claires et
            concrètes. Mon objectif est que chaque client comprenne le projet,
            se sente à l’aise avec les choix techniques réalisés et reste
            impliqué tout au long du processus.
          </p>
          <p class="max-txt-width">
            Je me considère comme un partenaire technique sur le long terme
            plutôt que simplement comme quelqu’un qui crée des sites web. De
            la stratégie et du design à la performance, au SEO et au support
            continu, je travaille en collaboration avec les entreprises pour
            les aider à développer leur présence en ligne avec confiance.
          </p>
        </div>
      </div>
    </section>
    <section class="sections sec-contact-form">
      <div class="contact-form-container">
        <div class="contact-form-title">
          <h3>Project details</h3>
        </div>
        <form
          id="contact-form"
          action="https://hook.eu1.make.com/1sbn8f4mnouwqh6ea5afdbu3lqtn3iy5"
          method="POST"
          data-netlify="true"
        >
          <input type="hidden" name="form-name" value="contact-form" />
          <input
            type="text"
            name="web-check"
            tabindex="-1"
            autocomplete="off"
            style="position: absolute; left: -9999px; top: -9999px"
          />

          <!-- Name -->
          <div class="form-group">
            <label for="name">Nom</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Votre nom"
            />
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="vous@example.com"
            />
          </div>

          <!-- Reason for contact -->
          <div class="form-group">
            <label for="reason">Comment puis-je vous aider ?</label>
            <select id="reason" name="reason" required>
              <option value="" disabled selected>
                Sélectionnez une option
              </option>
              <option value="new-website">Créer un nouveau site</option>
              <option value="improve-website">
                Améliorer un site web existant
              </option>
              <option value="project-discussion">
                Discuter d’un projet potentiel
              </option>
              <option value="seo">Offres SEO</option>
              <option value="general-question">Question générale</option>
            </select>
          </div>

          <!-- Conditional project fields -->
          <div id="form-project-fields" class="hide-element">
            <!-- Business name -->
            <div class="form-group">
              <label for="business">Nom de l’entreprise (optionnel)</label>
              <input
                type="text"
                id="business"
                name="business"
                placeholder="Business name"
              />
            </div>

            <!-- Website URL -->
            <div class="form-group">
              <label for="url">Site web actuel (optionnel)</label>
              <input
                type="url"
                id="url"
                name="url"
                placeholder="https://yourwebsite.com"
              />
            </div>

            <!-- SEO specific -->
            <div class="form-group" id="seo-objective-form">
              <label for="seo-objective"
                >Objectif principal pour le SEO</label
              >
              <div>
                <input
                  type="checkbox"
                  id="local"
                  name="seo-features[]"
                  value="local"
                />
                <label for="local">SEO local</label>
              </div>

              <div>
                <input
                  type="checkbox"
                  id="technical"
                  name="seo-features[]"
                  value="technical"
                />
                <label for="technical">Optimisation technique</label>
              </div>

              <div>
                <input
                  type="checkbox"
                  id="content"
                  name="seo-features[]"
                  value="content"
                />
                <label for="content">Contenu SEO / blogging</label>
              </div>
            </div>

            <!-- Budget SEO -->
            <div class="form-group" id="SEO-budget-form">
              <label for="seo-budget">Budget estimé pour le SEO</label>
              <select id="seo-budget" name="seo-budget">
                <option value="" disabled selected>
                  Sélectionnez une plage
                </option>
                <option value="250-400">€250 – €400</option>
                <option value="400-700">€400 – €700</option>
                <option value="150-300/m">€150 – €300 / mois</option>
                <option value="700-1200">€700 – €1,200</option>
              </select>
            </div>

            <!-- Budget website -->
            <div class="form-group" id="website-budget-form">
              <label for="web-budget">Budget estimé pour le site web</label>
              <select id="web-budget" name="web-budget">
                <option value="" disabled selected>
                  Sélectionnez une plage
                </option>
                <option value="500-1000">€500 – €1,000</option>
                <option value="1000-2000">€1,000 – €2,000</option>
                <option value="2000-4000">€2,000 – €4,000</option>
                <option value="4000-plus">€4,000+</option>
              </select>
            </div>

            <!-- SEO Timeline -->
            <div class="form-group" id="pref-time-seo">
              <label for="seo-timeline">Délai souhaité pour le SEO</label>
              <select id="seo-timeline" name="seo-timeline">
                <option value="" disabled selected>
                  Sélectionnez un délai
                </option>
                <option value="start-asap">Commencer dès que possible</option>
                <option value="1-month">Dans un mois</option>
                <option value="1-3-months">
                  D’ici 1 à 3 mois (recommandé)
                </option>
                <option value="ongoing-monthly">
                  Support mensuel continu
                </option>
                <option value="no-rush">
                  Pas d’urgence / exploration des options
                </option>
              </select>
            </div>

            <!-- Website Timeline -->
            <div class="form-group" id="pref-time-website">
              <label for="web-timeline"
                >Délai souhaité pour le site web</label
              >
              <select id="web-timeline" name="web-timeline">
                <option value="" disabled selected>
                  Sélectionnez un délai
                </option>
                <option value="asap">Dès que possible</option>
                <option value="1-month">D’ici un mois</option>
                <option value="1-3-months">D’ici 1 à 3 mois</option>
                <option value="no-rush">Pas d’urgence</option>
              </select>
            </div>
          </div>

          <!-- Message -->
          <div class="form-group">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Parlez-moi de votre projet ou de votre question…"
            ></textarea>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn btn-form-submit">
            Envoyer le message
          </button>
          <div>
            <p class="form-status-pass hide-element">
              Le formulaire a bien été envoyé, merci !
            </p>
            <p class="form-status-error hide-element">
              Un problème est survenu lors de l’envoi du formulaire, veuillez
              réessayer.
            </p>
          </div>
        </form>
      </div>
    </section>
    <div class="gradient"></div>
  </main>
  <Footer lang="fr" />
</BaseLayout>
