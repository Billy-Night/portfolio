---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { business, person, service, website } from '../../data/schema'
import Header from '../../components/Header.astro'
import HomeHero from '../../components/home/HomeHero.astro'
import HomeServices from '../../components/home/HomeServices.astro'
import HomeProjects from '../../components/home/HomeProjects.astro'
import HomeProcess from '../../components/home/HomeProcess.astro'
import HomeReviews from '../../components/home/HomeReviews.astro'
import HomeContact from '../../components/home/HomeContact.astro'
import HomeFaq from '../../components/home/HomeFaq.astro'
import Footer from '../../components/Footer.astro'

const jsonLd = [
  website('fr'),
  business('fr'),
  person('fr'),
  service('fr'),
]
---

<BaseLayout
  lang="fr"
  route="home"
  title="Web Designer & Développeur Web à Capbreton | Billy Nightingale"
  description="Création de site web, web design, développement web et SEO à Capbreton dans les Landes. Sites modernes et performants pour les entreprises locales."
  og={{
    title: "Billy Nightingale | Web Designer & Développeur Web",
    description: "Création de site web, web design, développement web et SEO à Capbreton dans les Landes. Sites modernes et performants pour les entreprises locales.",
  }}
  twitter={{
    title: "Billy Nightingale | Web Designer & Développeur Web",
    description: "Création de site web, web design, développement web et SEO à Capbreton dans les Landes. Sites modernes et performants pour les entreprises locales.",
  }}
  jsonLd={jsonLd}
>
  <Header lang="fr" route="home" />
  <main>
    <HomeHero lang="fr" />
    <HomeServices lang="fr" />
    <div class="gradient"></div>
    <HomeProjects lang="fr" />
    <HomeProcess lang="fr" />
    <div class="gradient"></div>
    <HomeReviews lang="fr" />
    <div class="gradient"></div>
    <HomeContact lang="fr" />
    <div class="gradient"></div>
    <HomeFaq lang="fr" />
  </main>
  <div class="gradient"></div>
  <Footer lang="fr" />
</BaseLayout>
