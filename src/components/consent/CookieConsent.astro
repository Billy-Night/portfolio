---
// The cookie banner, and with it the whole consent mechanism: Google Analytics
// and Microsoft Clarity load only after "Accept". It is used once, by
// src/layouts/BaseLayout.astro, so it is on every page.
//
//   <CookieConsent lang="en" />
//
// Settings (analytics IDs, live addresses): ./config.ts
// Behaviour: ./consent.js
// How it all works, and how to use it on another site: ./README.md
import { routes, type Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    // What the banner says must match what ./consent.js does: nothing is
    // loaded unless the visitor accepts.
    text: 'This site uses cookies to measure its audience, only if you accept.',
    policy: 'Privacy policy',
    accept: 'Accept',
    deny: 'Deny',
  },
  fr: {
    text: 'Ce site utilise des cookies pour mesurer son audience, uniquement si vous les acceptez.',
    policy: 'Politique de confidentialité',
    accept: 'Accepter',
    deny: 'Refuser',
  },
}[lang]
---

<div class="cookie-banner dark__glass-back">
  <p>{t.text}{' '}<a href={routes.privacy[lang]}>{t.policy}</a></p>
  <div class="cta-container">
    <button type="button" class="btn__primary btn__prim--light" id="cookie-accept">{t.accept}</button>
    <button type="button" class="btn__second btn__second--light" id="cookie-deny">{t.deny}</button>
  </div>
</div>

<script>
  import './consent.js'
</script>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .cookie-banner {
    display: none;
    max-width: 300px;
    z-index: 1000;
    position: fixed;
    bottom: var(--space-4);
    right: var(--page-gutter);
    color: var(--white);
    padding: var(--space-4);
    border-radius: var(--corner-rad);
  }

  @media screen and (max-width: 800px) {
    .cookie-banner {
      max-width: 90%;
      right: var(--page-gutter);
    }
  }
</style>
