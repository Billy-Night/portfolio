---
// The gold diamond used for bullet points across the site. On its own it is
// only the drawing: BulletList.astro uses it for lists, and the homepage
// process section places it beside each step.
interface Props {
  /** Sets the size and colour: 'bullet-point-svg' in lists, 'home-process-svg' in the process section */
  class: string
}

const { class: className } = Astro.props
