---
// One web application on the homepage. The text comes from `webApps` in
// src/data/projects.ts.
import Photo from '../Photo.astro'
import type { Lang } from '../../i18n/routes'
import type { WebApp } from '../../data/projects'

interface Props {
  app: WebApp
  lang: Lang
  /** Put the screenshot on the other side. HomeProjects.astro sets this on every second one. */
  reverse: boolean
}

const { app, lang, reverse } = Astro.props

// The headings carry 'heading-reverse' on the cards that are not reversed
const headingReverse = !reverse && 'heading-reverse'

const summary = app.summary[lang]
const summaryPieces = typeof summary === 'string' ? [summary] : summary
---

<article class:list={[reverse && 'reverse', 'project-info-container']}>
  <div class="text">
    <h3 class:list={['projects-heading', headingReverse]}>{app.category[lang]}</h3>
    <h4 class:list={['projects-heading-name', headingReverse]}>{app.name[lang]}</h4>
    <div class="project__glass-back">
      <p class="max-txt-width">
        {
          summaryPieces.map((piece) =>
            typeof piece === 'string' ? piece : <a href={piece.href} target="_blank" rel="noopener">{piece.text}</a>
          )
        }
      </p>
    </div>
    <h4 class:list={['heading__project-tech', headingReverse]}>Technologies</h4>
    <ul class="project-tech-list">
      {app.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
  <Photo src={app.photo} alt={app.photoAlt[lang]} loading="lazy" />
</article>
