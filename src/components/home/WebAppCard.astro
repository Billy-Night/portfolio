---
// One web application on the homepage. The text comes from `webApps` in
// src/data/projects.ts.
import ProjectCard from './ProjectCard.astro'
import type { Lang } from '../../i18n/routes'
import type { WebApp } from '../../data/projects'

interface Props {
  app: WebApp
  lang: Lang
  /** Put the screenshot on the other side. HomeProjects.astro sets this on every second one. */
  reverse: boolean
}

const { app, lang, reverse } = Astro.props

// The 'Technologies' heading carries 'project-card__heading--align-right' on the cards that are not reversed
const headingReverse = !reverse && 'project-card__heading--align-right'

const summary = app.summary[lang]
const summaryPieces = typeof summary === 'string' ? [summary] : summary
---

<ProjectCard category={app.category[lang]} name={app.name[lang]} reverse={reverse} photo={app.photo} photoAlt={app.photoAlt[lang]}>
  <p class="max-txt-width">
    {
      summaryPieces.map((piece) =>
        typeof piece === 'string' ? piece : <a href={piece.href} target="_blank" rel="noopener">{piece.text}</a>
      )
    }
  </p>
  <Fragment slot="below">
    <h4 class:list={['project-card__tech-heading', headingReverse]}>Technologies</h4>
    <ul class="project-tech-list">
      {app.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </Fragment>
</ProjectCard>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  .project-card__tech-heading {
    font-size: var(--title-6);
    margin-bottom: var(--space-2);
    margin-top: var(--space-4);
  }
</style>
