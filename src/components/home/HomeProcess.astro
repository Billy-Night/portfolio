---
// Shared by the English and French pages. Text that differs is in the table below.
import Timeline from '../Timeline.astro'
import BulletIcon from '../BulletIcon.astro'
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "From Strategy to Launch",
    intro: "A structured process designed to deliver a fast, effective website that supports your business goals.",
    discoveryHeading: "Discovery & Strategy",
    discoveryStep1: "Understand your business goals",
    discoveryStep2: "Research competitors and opportunities",
    discoveryStep3: "Define a clear strategy",
    designStep1: "Create the visual direction",
    designStep2: "Design key pages and user journeys",
    designStep3: "Refine the experience",
    developmentHeading: "Development",
    developmentStep1: "Build the website",
    developmentStep2: "Integrate required functionality",
    developmentStep3: "Optimise performance and SEO",
    launchHeading: "Launch",
    launchStep1: "Test and deploy",
    launchStep2: "Configure analytics",
    launchStep3: "Monitor and support",
  },
  fr: {
    heading: "De la Stratégie au Lancement",
    intro: "Un processus structuré conçu pour créer un site web rapide, performant et aligné sur vos objectifs commerciaux.",
    discoveryHeading: "Découverte & Stratégie",
    discoveryStep1: "Comprendre vos objectifs commerciaux",
    discoveryStep2: "Analyser vos concurrents et identifier les opportunités",
    discoveryStep3: "Définir une stratégie claire",
    designStep1: "Définir la direction visuelle",
    designStep2: "Concevoir les pages clés et les parcours utilisateurs",
    designStep3: "Affiner l’expérience utilisateur",
    developmentHeading: "Développement",
    developmentStep1: "Développer le site web",
    developmentStep2: "Intégrer les fonctionnalités nécessaires",
    developmentStep3: "Optimiser les performances et le référencement (SEO)",
    launchHeading: "Lancement",
    launchStep1: "Tester et mettre en ligne le site",
    launchStep2: "Configurer les outils d’analyse",
    launchStep3: "Assurer le suivi et l’accompagnement",
  },
}[lang]
---

<Timeline heading={t.heading} intro={t.intro} stepClass="timeline__step--pad-medium">
  <div slot="step-1" class="timeline__step-heading timeline__step-heading--hidden timeline__step-content">
    <h3>{t.discoveryHeading}</h3>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.discoveryStep1}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.discoveryStep2}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.discoveryStep3}</p>
    </div>
  </div>
  <div slot="step-2" class="timeline__step-heading timeline__step-heading--hidden timeline__step-content">
    <h3>Design</h3>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.designStep1}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.designStep2}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.designStep3}</p>
    </div>
  </div>
  <div slot="step-3" class="timeline__step-heading timeline__step-heading--hidden timeline__step-content">
    <h3>{t.developmentHeading}</h3>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.developmentStep1}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.developmentStep2}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.developmentStep3}</p>
    </div>
  </div>
  <div slot="step-4" class="timeline__step-heading timeline__step-heading--hidden timeline__step-content">
    <h3>{t.launchHeading}</h3>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.launchStep1}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.launchStep2}</p>
    </div>
    <div class="flex-two-col">
      <BulletIcon class="timeline__bullet" />
      <p>{t.launchStep3}</p>
    </div>
  </div>
</Timeline>
