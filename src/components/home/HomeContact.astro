---
// Shared by the English and French pages. Text that differs is in the table below.
import ContactCta from '../ContactCta.astro'
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "CONTACT ME",
    intro: "I'm always interested in hearing about new exciting projects in the tech space.",
    emailButton: "EMAIL ME",
    aboutButton: "ABOUT ME",
  },
  fr: {
    heading: "CONTACTEZ-MOI",
    intro: "Je suis toujours ouvert à discuter de nouveaux projets avec vous.",
    emailButton: "PAR MAIL",
    aboutButton: "À PROPOS",
  },
}[lang]
---

<ContactCta id="contact" heading={t.heading} intro={t.intro} socialLinks>
  <a
    class="btn__primary btn__prim--light"
    href="mailto:contact@billynightingale.com"
    >{t.emailButton}</a
  >
  <a class="btn__second btn__second--light" href={r('about')}>{t.aboutButton}</a>
</ContactCta>
