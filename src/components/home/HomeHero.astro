---
// Shared by the English and French pages. Text that differs is in the table below.
import Hero from '../Hero.astro'
import Photo from '../Photo.astro'
import imgBillyNightingalePortraitStandingLaptopV4 from '../../assets/images/portraits/billy_nightingale_portrait_standing_laptop_v4.webp'
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    titleText: "GROW YOUR BUSINESS",
    subheading: "CREATING WEBSITES & SYSTEMS",
    introStart: "I'm",
    introRest: "a web designer helping local businesses in Capbreton and southwest France build a strong, professional online presence.",
    tagline: "Your technical partner — from design to launch and SEO.",
    availability: "Available for new projects, locally or remotely.",
    ctaText: "Learn more about me and my recent projects",
    projectsButton: "Projects",
  },
  fr: {
    titleText: "DÉVELOPPEZ VOTRE ENTREPRISE",
    subheading: "CRÉATION DE SITE WEB ET SYSTÈMES",
    introStart: "Je suis",
    introRest: "développeur web et designer web, j’aide les entreprises du sud-ouest de la France à créer une présence en ligne forte et professionnelle.",
    tagline: "Votre partenaire technique, de la conception au lancement et au SEO.",
    availability: "Disponible pour de nouveaux projets, sur place ou à distance.",
    ctaText: "Découvrez-en plus sur moi et mes projets récents",
    projectsButton: "Projets",
  },
}[lang]
---

<Hero title={t.titleText} titleClass={lang === 'fr' && 'hero__title--fr'}>
  <span slot="title-word" class:list={["xl-heading hero__title-word--hide-on-phone", lang === 'fr' && "hero__title-word--fr"]}
    >WEB DESIGNER CAPBRETON HOSSEGOR</span
  >
  <Photo
    slot="photo"
    src={imgBillyNightingalePortraitStandingLaptopV4}
    maxWidth={750}
    alt="Portrait of Billy Nightingale looking at web design on laptop"
    class="hero__photo--home"
    loading="eager"
    fetchpriority="high"
  />
  <h2>{t.subheading}</h2>
  <p class="max-hero-txt-width">
    {t.introStart} <span class="hero__name">Billy Nightingale,</span> {t.introRest}
  </p>
  <p class="max-hero-txt-width">
    {t.tagline}
  </p>
  <p class="max-hero-txt-width">
    {t.availability}
  </p>
  <p class="max-hero-txt-width">
    {t.ctaText}
  </p>
  <div class="cta-container">
    <a class="btn__primary btn__prim--light" href={r('contact')}
      >Contact</a
    >
    <a class="btn__second btn__second--light" href={`${r('home')}#projects`}
      >{t.projectsButton}</a
    >
  </div>
</Hero>
