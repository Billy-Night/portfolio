---
// The frame of a project on the homepage: the small category line, the name,
// a glass panel for the text, and the screenshot beside it. Used by
// ClientProjectCard.astro and WebAppCard.astro, which supply what goes in the
// panel:
//
//   <ProjectCard category="..." name="..." reverse={...} photo={...} photoAlt="...">
//     ...                                  the contents of the glass panel
//     <Fragment slot="below">...</Fragment>   anything under the panel
//   </ProjectCard>
import type { ImageMetadata } from 'astro'
import Photo from '../Photo.astro'

interface Props {
  /** The small line above the name */
  category: string
  name: string
  /** Put the screenshot on the other side. HomeProjects.astro sets this on every second project. */
  reverse: boolean
  photo: ImageMetadata
  photoAlt: string
  /** Resize the screenshot to this width. Only for files much larger than their displayed size. */
  photoMaxWidth?: number
}

const { category, name, reverse, photo, photoAlt, photoMaxWidth } = Astro.props

// The headings carry 'project-card__heading--align-right' on the projects that are not reversed
const headingReverse = !reverse && 'project-card__heading--align-right'
---

<article class:list={[reverse && 'project-card--reverse', 'project-card']}>
  <div class="project-card__text">
    <h3 class:list={['project-card__category', headingReverse]}>{category}</h3>
    <h4 class:list={['project-card__name', headingReverse]}>{name}</h4>
    <div class="project__glass-back">
      <slot />
    </div>
    <slot name="below" />
  </div>
  <Photo src={photo} maxWidth={photoMaxWidth} alt={photoAlt} loading="lazy" />
</article>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md
     They style the frame for both kinds of card. The glass panel and the technology tags are
     shared with the project pages, so those rules are in src/styles/. -->
<style>
  .project-card__category {
    color: var(--sub-heading-colour);
    font-size: var(--text-base);
    font-family: var(--mono);
    margin-bottom: var(--space-1);
  }

  :global(.project-card__heading--align-right) {
    text-align: right;
  }

  .project-card__name {
    color: var(--gold);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .project-card {
    margin-top: var(--space-6);
    margin-bottom: var(--space-project-gap);
  }

  :global(.projects) :global(img) {
    width: 100%;
    height: auto;
    margin: 8% 0 8% 0;
    border-left: 1px solid var(--gold);
    border-top: 1px solid var(--gold);
    border-radius: var(--corner-rad-lg);
    padding: 1rem;
  }

  .project-card--reverse :global(img) {
    border-left: 0px;
    border-right: 1px solid var(--gold);
  }

  /* From 801px, so it never applies together with the 'up to 800px' rules below */
  @media (min-width: 801px) {
    .project-card {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 1rem;
    }

    :global(.projects) :global(img) {
      grid-column: 1/6;
      grid-row: 1/2;
    }

    .project-card__text {
      grid-column: 5/11;
      grid-row: 1/2;
      order: 2;
      text-align: left;
    }

    :global(.projects) .project-card--reverse .project-card__text {
      grid-column: 1/7;
      order: 2;
      text-align: left;
    }

    :global(.projects) .project-card--reverse :global(img) {
      grid-column: 6/11;
      grid-row: 1/2;
    }

    :global(.projects) .project-card--reverse :global(ul) {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 800px) {
    :global(.project-card__heading--align-right) {
      text-align: left;
    }
  }
</style>
