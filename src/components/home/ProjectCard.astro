---
// One project on the homepage. The text comes from src/data/projects.ts.
// A project that has its own page gets a link to it.
import Photo from '../Photo.astro'
import BulletList from '../BulletList.astro'
import { projectPaths, type Lang } from '../../i18n/routes'
import type { Project } from '../../data/projects'

interface Props {
  project: Project
  lang: Lang
  /** Put the screenshot on the other side. HomeProjects.astro sets this on every second project. */
  reverse: boolean
}

const { project, lang, reverse } = Astro.props

// The headings carry 'heading-reverse' on the projects that are not reversed
const headingReverse = !reverse && 'heading-reverse'

const t = {
  en: { pageLink: "Read the full project" },
  fr: { pageLink: "Voir le projet en détail" },
}[lang]

const summary = project.summary[lang]
const summaryPieces = typeof summary === 'string' ? [summary] : summary
---

<article class:list={[reverse && 'reverse', 'project-info-container']}>
  <div class="text">
    <h3 class:list={['projects-heading', headingReverse]}>{project.category[lang]}</h3>
    <h4 class:list={['projects-heading-name', headingReverse]}>{project.name[lang]}</h4>
    <div class="project__glass-back">
      <p class="max-txt-width">
        {
          summaryPieces.map((piece) =>
            typeof piece === 'string' ? piece : <a href={piece.href} target="_blank" rel="noopener">{piece.text}</a>
          )
        }
      </p>
      {project.detail && <p>{project.detail[lang]}</p>}
      {
        project.tasks && (
          <>
            <p>{project.tasks.intro[lang]}</p>
            <div class="project-task-list">
              <BulletList items={project.tasks.items[lang]} />
            </div>
          </>
        )
      }
      {project.result && <p class="max-txt-width">{project.result[lang]}</p>}
      {
        project.link && (
          <p>
            {project.link.intro[lang]}
            <a href={project.link.href} target="_blank" rel="noopener">{project.link.text[lang]}</a>
          </p>
        )
      }
      {
        project.page && (
          <p>
            <a href={projectPaths(project.page.slug)[lang]}>
              {t.pageLink} <span aria-hidden="true">→</span>
            </a>
          </p>
        )
      }
    </div>
    <h4 class:list={['heading__project-tech', headingReverse]}>Technologies</h4>
    <ul class="project-tech-list">
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
  <Photo src={project.photo} maxWidth={project.photoMaxWidth} alt={project.photoAlt[lang]} loading="lazy" />
</article>
