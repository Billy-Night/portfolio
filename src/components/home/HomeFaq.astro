---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'
import { faq } from '../../data/faq'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Frequently asked Questions",
    intro: "Some question which I regularly get asked",
    answerLabel: "Answer",
  },
  fr: {
    heading: "Questions fréquentes",
    intro: "Quelques questions que l’on me pose régulièrement",
    answerLabel: "Réponse",
  },
}[lang]
---

<section class="section-pad section-center-max-width">
  <div class="subheading-centred">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="vertical-switcher">
    {
      faq.map((entry, index) => (
        <div class="vertical-switcher-content">
          <h3 class="vertical-switcher-question">
            <button
              type="button"
              class:list={['vertical-switcher-btn', index === 0 && 'is-active']}
              data-index={index}
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`faq-answer-${index}`}
            >{entry.question[lang]}</button>
          </h3>
          <div class:list={['vertical-switcher-txt', index === 0 && 'is-active']} id={`faq-answer-${index}`}>
            <p class="h3-style">{t.answerLabel}</p>
            <p class="max-txt-width">
              {entry.answer[lang]}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import '../../scripts/faq.js'
</script>

<!-- This component's own styles. is:global keeps the rules unscoped, so they behave
     exactly as they did in the shared stylesheet. Shared classes used here are in src/styles/. -->
<style is:global>
  .vertical-switcher-btn {
    border: none;
    padding-top: var(--gap-sm);
    padding-bottom: var(--gap-sm);
    background: none;
    text-decoration: none;
    cursor: pointer;
    text-align: left;
    /* 60% is the faintest this gold can go on the navy background and still
       be readable enough for large text (contrast 3.6 to 1; 3 to 1 is the minimum) */
    opacity: 60%;
    /* The button sits inside the question's <h3> and takes its type styles */
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-transform: inherit;
  }

  .vertical-switcher-question {
    font-size: var(--title-2);
  }

  .vertical-switcher-btn.is-active {
    opacity: 100%;
  }

  .vertical-switcher-txt {
    display: none;
    padding: var(--space-6);
    border: 2px dashed rgba(220, 168, 104, 0.3);
    border-radius: var(--corner-rad);
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease visibility 0.4s ease;
    pointer-events: none;
  }

  .vertical-switcher-txt.is-active {
    display: block;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>
