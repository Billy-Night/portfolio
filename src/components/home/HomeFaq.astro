---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'
import { faq } from '../../data/faq'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Frequently asked Questions",
    intro: "Some question which I regularly get asked",
    answerLabel: "Answer",
  },
  fr: {
    heading: "Questions fréquentes",
    intro: "Quelques questions que l’on me pose régulièrement",
    answerLabel: "Réponse",
  },
}[lang]
---

<section class="section-pad section-center-max-width">
  <div class="subheading-centred">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="vertical-switcher">
    {
      faq.map((entry, index) => (
        <div class="vertical-switcher-content">
          <h3 class="vertical-switcher-question">
            <button
              type="button"
              class:list={['vertical-switcher-btn', index === 0 && 'is-active']}
              data-index={index}
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`faq-answer-${index}`}
            >{entry.question[lang]}</button>
          </h3>
          <div class:list={['vertical-switcher-txt', index === 0 && 'is-active']} id={`faq-answer-${index}`}>
            <p class="h3-style">{t.answerLabel}</p>
            <p class="max-txt-width">
              {entry.answer[lang]}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import '../../scripts/faq.js'
</script>
