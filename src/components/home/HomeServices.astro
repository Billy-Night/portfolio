---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    howIGrowYour: "How I grow your business",
    theServicesIOffer: "The services I offer to help your business succeed online.",
    development: "Development",
  },
  fr: {
    howIGrowYour: "Services pour votre entreprise",
    theServicesIOffer: "Les services que je propose pour aider votre entreprise à réussir en ligne.",
    development: "Développement",
  },
}[lang]
---

<section class="section-center-max-width section-pad">
  <div class="flex-center">
    <h2 class="xl-heading txt-center">{t.howIGrowYour}</h2>
    <p class="max-txt-width txt-center">
      {t.theServicesIOffer}
    </p>
  </div>
  <div class="flex-center">
    <div class="layout-6x6-grid home-services-grid">
      <div class="home-services-design flex-center"><h2>Design</h2></div>
      <div class="home-services-development flex-center">
        <h2>{t.development}</h2>
      </div>
      <div class="home-services-seo flex-center"><h2>SEO</h2></div>
      <div class="home-services-automation flex-center">
        <h2>Automation</h2>
      </div>
      <div class="home-services-img flex-center">
        <svg
          class="home-services__circle"
          viewBox="0 0 440 440"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <linearGradient
              id="rustic-metal"
              x1="0"
              y1="0"
              x2="440"
              y2="440"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0%" stop-color="#75685b" />
              <stop offset="45%" stop-color="#353e43" />
              <stop offset="100%" stop-color="#1b2024" />
            </linearGradient>
          </defs>
          <circle
            cx="220"
            cy="219.99"
            r="200"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
          <line
            y1="220.002"
            x2="440"
            y2="220.002"
            stroke-width="2"
            stroke="#75685b"
          />
          <line
            x1="220"
            y1="440"
            x2="220"
            stroke-width="2"
            stroke="#75685b"
          />
          <line
            x1="71.2929"
            y1="368.278"
            x2="368.278"
            y2="71.2934"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
          <line
            x1="368.278"
            y1="368.692"
            x2="71.2929"
            y2="71.7076"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
        </svg>
      </div>
    </div>
  </div>
</section>
