---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "How I grow your business",
    intro: "The services I offer to help your business succeed online.",
    developmentLabel: "Development",
    automationLabel: "Automation",
  },
  fr: {
    heading: "Services pour votre entreprise",
    intro: "Les services que je propose pour aider votre entreprise à réussir en ligne.",
    developmentLabel: "Développement",
    automationLabel: "Automatisation",
  },
}[lang]
---

<section class="section-center-max-width section-pad">
  <div class="flex-center">
    <h2 class="xl-heading txt-center">{t.heading}</h2>
    <p class="max-txt-width txt-center">
      {t.intro}
    </p>
  </div>
  <div class="flex-center">
    <div class="layout-6x6-grid home-services-grid">
      <div class="home-services-design flex-center"><p class="home-services__label">Design</p></div>
      <div class="home-services-development flex-center">
        <p class="home-services__label">{t.developmentLabel}</p>
      </div>
      <div class="home-services-seo flex-center"><p class="home-services__label">SEO</p></div>
      <div class="home-services-automation flex-center">
        <p class="home-services__label">{t.automationLabel}</p>
      </div>
      <div class="home-services-img flex-center">
        <svg
          class="home-services__circle"
          viewBox="0 0 440 440"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <linearGradient
              id="rustic-metal"
              x1="0"
              y1="0"
              x2="440"
              y2="440"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0%" stop-color="#75685b" />
              <stop offset="45%" stop-color="#353e43" />
              <stop offset="100%" stop-color="#1b2024" />
            </linearGradient>
          </defs>
          <circle
            cx="220"
            cy="219.99"
            r="200"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
          <line
            y1="220.002"
            x2="440"
            y2="220.002"
            stroke-width="2"
            stroke="#75685b"
          />
          <line
            x1="220"
            y1="440"
            x2="220"
            stroke-width="2"
            stroke="#75685b"
          />
          <line
            x1="71.2929"
            y1="368.278"
            x2="368.278"
            y2="71.2934"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
          <line
            x1="368.278"
            y1="368.692"
            x2="71.2929"
            y2="71.7076"
            stroke-width="2"
            stroke-dasharray="4 4"
            stroke="url(#rustic-metal)"
          />
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  .layout-6x6-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(6, 1fr);
    gap: var(--gap-sm);
  }

  .home-services-grid {
    width: min(100%, 860px);
    margin-inline: auto;
    grid-template-areas:
      '. . development development . .'
      '. img img img img .'
      'design img img img img seo'
      'design img img img img seo'
      '. img img img img .'
      '. . automation automation . .';
  }

  .home-services-design {
    grid-area: design;
    min-width: 72px;
  }

  /* The four words around the circle are labels, not section headings, so they
     are paragraphs styled like an <h2>. */
  .home-services__label {
    margin: 0;
    font-weight: 400;
    font-size: var(--title-2);
    line-height: var(--leading-title);
    font-family: var(--subHeading);
    letter-spacing: 4%;
    color: var(--subHeading-colour);
    text-transform: uppercase;
  }

  .home-services-development {
    grid-area: development;
  }

  .home-services-seo {
    grid-area: seo;
    min-width: 72px;
  }

  .home-services-automation {
    grid-area: automation;
  }

  .home-services-img {
    grid-area: img;
  }

  .home-services__circle {
    width: 100%;
    height: auto;
    max-width: 600px;
    display: block;

    animation: gentle-rotate 20s infinite ease-in-out;
    transform-origin: center;
  }

  @keyframes gentle-rotate {
    0%,
    40% {
      transform: rotate(0deg);
    }

    50%,
    90% {
      transform: rotate(180deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  /* Reduced motion: the circle does not turn. This must come after the rule
     that starts the animation, which is why it is here and not with the
     other reduced-motion rules in src/styles/90-reduced-motion.css. */
  @media (prefers-reduced-motion: reduce) {
    .home-services__circle {
      animation: none;
    }
  }
</style>
