          <li>Figma</li>
          <li>CMS</li>
          <li>Elementor Pro</li>
          <li>Stripe</li>
          <li>PW Gift Cards</li>
          <li>Notion</li>
          <li>Drive</li>
        </ul>
      </div>
      <img
        loading="lazy"
        decoding="async"
        src="/assets/client_sites/Billy_nightingale_client_pacific_coast_cafe_hossegor.webp"
        alt={t.altWeatherWiseAFrontend}
        data-src="/assets/client_sites/Billy_nightingale_client_pacific_coast_cafe_hossegor.webp"
