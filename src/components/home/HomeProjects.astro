---

<section class="sections projects" id="projects">
  <div class="section-project-container">
    <h2>{t.clientProjects}</h2>
    <article class="project-info-container">
      <div class="text">
        <h3 class="projects-heading heading-reverse">{t.hospitality}</h3>
        <h4 class="projects-heading-name heading-reverse">
          {t.monkeyMoodRestaurant}
        </h4>
        <div class="project__glass-back">
          <p class="max-txt-width">
            {t.completeWebsiteRedesignFor}
          </p>
          <p>{t.keyAspectsOfThe}</p>
          <div class="project-task-list">
            <ul>
              <li>{t.fullRedesignWithMockups}</li>
              <li>
                {t.userFlowMappingTo}
              </li>
              <li>{t.bookingSystemIntegrationZenchef}</li>
              <li>
                {t.customAnimationsAndStorytelling}
              </li>
              <li>{t.performanceAndSeoOptimisation}</li>
            </ul>
          </div>
          <p class="max-txt-width">
            {t.thisWebsiteImprovedBooking}
          </p>
          <p>
            {t.checkOutTheWebsite}
            <a href="https://monkey-mood.fr" target="_blank"
              >{t.monkeyMoodWebsite}</a
            >
          </p>
        </div>
        <h4 class="heading__project-tech heading-reverse">
          Technologies
        </h4>
        <ul class="project-tech-list">
          <li>Figma</li>
          <li>WordPress CMS</li>
          <li>Elementor Pro</li>
          <li>Notion</li>
          <li>Drive</li>
          <li>ZenChef</li>
        </ul>
      </div>
      <img
        loading="lazy"
        decoding="async"
        src="/assets/client_sites/billy_nightingale_client_monkey_mood_creation_de_site_web.webp"
        alt="Eve-Marie web site created by Billy"
        data-src="/assets/client_sites/billy_nightingale_client_monkey_mood_creation_de_site_web.webp"
        width="600"
        height="600"
      />
    </article>
    <article class="reverse project-info-container">
      <div class="text">
        <h3 class="projects-heading">{t.eCommerce}</h3>
        <h4 class="projects-heading-name">{t.pacificCoastCafeCafe}</h4>
