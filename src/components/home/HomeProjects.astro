---
// Shared by the English and French pages. The projects are in
// src/data/projects.ts; the two headings are in the table below.
import ClientProjectCard from './ClientProjectCard.astro'
import WebAppCard from './WebAppCard.astro'
import type { Lang } from '../../i18n/routes'
import { clientProjects, webApps } from '../../data/projects'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    clientProjectsHeading: "CLIENT PROJECTS",
    webAppsHeading: "WEB APPLICATION",
  },
  fr: {
    clientProjectsHeading: "PROJETS CLIENTS",
    webAppsHeading: "APPLICATIONS WEB",
  },
}[lang]
---

<section class="sections projects" id="projects">
  <div class="section-project-container">
    <h2>{t.clientProjectsHeading}</h2>
    {clientProjects.map((project, index) => <ClientProjectCard project={project} lang={lang} reverse={index % 2 === 1} />)}
    <h2>{t.webAppsHeading}</h2>
    {webApps.map((app, index) => <WebAppCard app={app} lang={lang} reverse={index % 2 === 1} />)}
  </div>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  .projects h2 {
    margin-bottom: 4%;
    margin-left: 0;
  }
</style>
