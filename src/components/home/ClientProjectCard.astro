---
// One client project on the homepage: a short introduction (who the client
// is, the problem, the result) with one link, to the project's own page or,
// for a project without one, to the client's website. The text comes from
// `clientProjects` in src/data/projects.ts.
import Photo from '../Photo.astro'
import { projectPaths, type Lang } from '../../i18n/routes'
import type { ClientProject } from '../../data/projects'

interface Props {
  project: ClientProject
  lang: Lang
  /** Put the screenshot on the other side. HomeProjects.astro sets this on every second project. */
  reverse: boolean
}

const { project, lang, reverse } = Astro.props

// The headings carry 'heading-reverse' on the projects that are not reversed
const headingReverse = !reverse && 'heading-reverse'

const t = {
  en: {
    problem: "The problem",
    result: "The result",
    pageLink: "View the project",
    liveLink: "Visit the website",
  },
  fr: {
    problem: "Le problème",
    result: "Le résultat",
    pageLink: "Voir le projet",
    liveLink: "Voir le site",
  },
}[lang]
---

<article class:list={[reverse && 'reverse', 'project-info-container']}>
  <div class="text">
    <h3 class:list={['projects-heading', headingReverse]}>{project.category[lang]}</h3>
    <h4 class:list={['projects-heading-name', headingReverse]}>{project.name[lang]}</h4>
    <div class="project__glass-back">
      <p class="max-txt-width">{project.card.client[lang]}</p>
      <dl class="project-card__points">
        <dt>{t.problem}</dt>
        <dd>{project.card.problem[lang]}</dd>
        <dt>{t.result}</dt>
        <dd>{project.card.result[lang]}</dd>
      </dl>
      {
        project.page ? (
          <a class="btn__second btn__second--light project-card__link" href={projectPaths(project.page.slug)[lang]}>
            {t.pageLink} <span aria-hidden="true">→</span>
          </a>
        ) : (
          project.liveUrl && (
            <a class="btn__second btn__second--light project-card__link" href={project.liveUrl} target="_blank" rel="noopener">
              {t.liveLink} <span aria-hidden="true">→</span>
            </a>
          )
        )
      }
    </div>
  </div>
  <Photo src={project.photo} maxWidth={project.photoMaxWidth} alt={project.photoAlt[lang]} loading="lazy" />
</article>
