---
// Shared by the English and French pages. Text that differs is in the table below.
import Photo from '../Photo.astro'
import type { Lang } from '../../i18n/routes'
import { reviews } from '../../data/reviews'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "TRUSTED BY MY CLIENTS",
    intro: "Feedback from my clients",
  },
  fr: {
    heading: "Ils m’ont fait confiance",
    intro: "Retour d’expérience sur des projets récent",
  },
}[lang]
---

<section class="sections" id="reviews">
  <div class="cont__review">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
    <div class="review-hover-wrap">
      {
        reviews.map((review) => (
          <div class="cont__review-content">
            <div class="review-avatar">
              <Photo
                src={review.photo}
                maxWidth={360}
                alt={review.photoAlt[lang]}
                class={review.photoClass}
                loading="lazy"
              />
            </div>
            <div class="cont__review-text">
              <svg
                class="review__svg--play"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 485 485"
                fill="currentColor"
              >
                <path
                  d="M413.974,71.026C368.171,25.225,307.274,0,242.5,0S116.829,25.225,71.026,71.026C25.225,116.829,0,177.726,0,242.5
      s25.225,125.671,71.026,171.474C116.829,459.775,177.726,485,242.5,485s125.671-25.225,171.474-71.026
      C459.775,368.171,485,307.274,485,242.5S459.775,116.829,413.974,71.026z M242.5,455C125.327,455,30,359.673,30,242.5
      S125.327,30,242.5,30S455,125.327,455,242.5S359.673,455,242.5,455z"
                />
                <circle
                  class="review-icon-loading-circle-drawPath"
                  cx="242.5"
                  cy="242.5"
                  r="227.5"
                />
                <polygon
                  points="181.062,336.575 343.938,242.5 181.062,148.425"
                />
              </svg>
              <svg
                class="review__svg--pause"
                version="1.1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                x="0px"
                y="0px"
                viewBox="0 0 271.953 271.953"
                style="enable-background: new 0 0 271.953 271.953"
                xml:space="preserve"
              >
                <g>
                  <g>
                    <path
                      d="M135.977,271.953c75.097,0,135.977-60.879,135.977-135.977S211.074,0,135.977,0S0,60.879,0,135.977
    			S60.879,271.953,135.977,271.953z M135.977,21.756c62.979,0,114.22,51.241,114.22,114.22s-51.241,114.22-114.22,114.22
    			s-114.22-51.241-114.22-114.22S72.992,21.756,135.977,21.756z"
                    />
                    <path
                      d="M110.707,200.114c7.511,0,13.598-6.086,13.598-13.598V83.174c0-7.511-6.086-13.598-13.598-13.598
    			c-7.511,0-13.598,6.086-13.598,13.598v103.342C97.109,194.028,103.195,200.114,110.707,200.114z"
                    />
                    <path
                      d="M165.097,200.114c7.511,0,13.598-6.086,13.598-13.598V83.174c0-7.511-6.086-13.598-13.598-13.598
    			S151.5,75.663,151.5,83.174v103.342C151.5,194.028,157.586,200.114,165.097,200.114z"
                    />
                  </g>
                </g>
              </svg>
              {review.paragraphs[lang].map((paragraph) => <p class="max-txt-width">{paragraph}</p>)}
              <p>{review.author}</p>
              <div class="cont__review-stars">
                <img
                  class="review__stars"
                  src="/assets/icons/stars.svg"
                  alt="icon star"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../../scripts/reviews.js'
</script>

<!-- The homepage reviews' own styles. is:global keeps the rules unscoped, so they behave exactly as they
     did in the shared stylesheet. Shared classes used here are in src/styles/. -->
<style is:global>
  .cont__review {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .review-hover-wrap {
    position: relative;
    width: 100%;
    max-width: 900px;
    min-height: 700px;
  }

  @media screen and (max-width: 600px) {
    .review-hover-wrap {
      min-height: 800px;
    }
  }

  @media screen and (max-width: 400px) {
    .review-hover-wrap {
      min-height: 1000px;
    }
  }

  .review-hover-wrap:hover {
    cursor: pointer;
  }

  .cont__review-content {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    position: absolute;
    inset: 0;
    padding-top: var(--space-11);
    padding-left: var(--space-11);
    transition:
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.8s;
  }

  .cont__review-content.review-is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cont__review-text {
    position: relative;
    z-index: 2;
    transition: var(--transition-lift);
    background-color: var(--glass-bg-light);
    border: var(--glass-border);
    border-radius: var(--corner-rad);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-6);
  }

  .review-avatar {
    z-index: 1;
    width: 180px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    position: absolute;
    top: 0;
    left: 0;
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  @media screen and (max-width: 700px) {
    .review-avatar {
      width: 150px;
      left: 50%;
      transform: translate(-50%);
    }

    .cont__review-content {
      padding-top: var(--space-11);
      padding-left: 0;
    }

    .cont__review-text {
      padding: var(--space-5);
    }

    .cont__review h2 {
      text-align: center;
    }
  }

  .review__svg--pause {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    position: absolute;
    opacity: 0;
    top: var(--space-3);
    right: var(--space-3);
    fill: var(--body-colour);
  }

  .review__svg--pause.pause-icon-is-active {
    opacity: 1;
  }

  .review__svg--play {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    position: absolute;
    opacity: 1;
    top: var(--space-3);
    right: var(--space-3);
    fill: var(--body-colour);
  }

  .review__svg--play.play-icon-is-hidden {
    opacity: 0;
  }

  .review-icon-loading-circle-drawPath {
    fill: none;
    stroke: var(--brightGold);
    stroke-width: 30;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 242.5px 242.5px;
  }

  .cont__review-stars {
    padding: 0px;
  }
</style>
