---
import { GITHUB, LINKEDIN } from './icons'
import { otherLang, pathsOf, routes, type Lang, type PageRoute, type RouteKey } from '../i18n/routes'

interface Props {
  lang: Lang
  /** Current page — the language switch links to its translation */
  route: PageRoute
}

const {
  lang,
  route,
} = Astro.props

const alt = otherLang(lang)
const r = (key: RouteKey) => routes[key][lang]

const labels = {
  en: {
    projects: 'Projects', about: 'About', contact: 'Contact', services: 'Services', landes: 'Landes',
    logoAlt: 'Billy Nightingale logo', menuIconAlt: 'Menu icon',
    homeLabel: 'Home', menuLabel: 'Open menu', menuCloseLabel: 'Close menu',
  },
  fr: {
    projects: 'Projets', about: 'À propos', contact: 'Contact', services: 'Services', landes: 'Landes',
    logoAlt: 'Logo Billy Nightingale', menuIconAlt: 'Icône du menu',
    homeLabel: 'Accueil', menuLabel: 'Ouvrir le menu', menuCloseLabel: 'Fermer le menu',
  },
}[lang]

const linkedIn =
  lang === 'fr'
    ? 'https://www.linkedin.com/in/billynightingale/?locale=fr_FR'
    : 'https://www.linkedin.com/in/billynightingale/'
---

<header class="header">
  <nav class="nav__list-full nav__glass-back">
    <a class="nav__link" href={r('home')} aria-label={labels.homeLabel}>
      <img class="nav__logo" src="/assets/nightingale_logo_gold.svg" alt={labels.logoAlt} />
    </a>
    <ul class="nav__list" id="nav-list">
      <li><a class="nav__link nav__link--mini" href={pathsOf(route)[alt]}>{alt.toUpperCase()}</a></li>
      <li><a class="nav__link nav__link--mini" href={`${r('home')}#projects`}>{labels.projects}</a></li>
      <li><a class="nav__link nav__link--mini" href={r('about')}>{labels.about}</a></li>
      <li><a class="nav__link nav__link--mini" href={r('contact')}>{labels.contact}</a></li>
      <li><a class="nav__link nav__link--mini" href={r('services')}>{labels.services}</a></li>
      <li><a class="nav__link nav__link--mini" href={r('landes')}>{labels.landes}</a></li>
      <li class="mob__hide">
        <a class="nav__link" href={linkedIn} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg
            class="social__icons"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 448 512"
            width="30"
            height="30"
          >
            <path d={LINKEDIN}></path>
          </svg>
        </a>
      </li>
      <li class="mob__hide">
        <a class="nav__link" href="https://github.com/Billy-Night" target="_blank" rel="noopener" aria-label="GitHub">
          <svg
            class="social__icons"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 448 512"
          >
            <path d={GITHUB}></path>
          </svg>
        </a>
      </li>
    </ul>
    <button
      class="menu-btn--hamburger"
      type="button"
      aria-label={labels.menuLabel}
      aria-expanded="false"
      aria-controls="nav-list"
      data-label-open={labels.menuLabel}
      data-label-close={labels.menuCloseLabel}
    >
      <img src="/assets/icons/ham_menu.svg" alt={labels.menuIconAlt} class="menu-btn__icon" />
    </button>
  </nav>
</header>

<script>
  import '../scripts/header.js'
</script>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md
     Keep the order of these rules: the open-menu rules (.nav__links-mob, .nav__dropdown) must come
     after the phone rules that hide the links, or the menu opens empty. -->
<style>
  .nav__glass-back {
    background: var(--glass-bg-dark);
    transition: var(--transition-lift);
    border: var(--glass-border-faint);
    -webkit-backdrop-filter: var(--glass-blur-rich);
    backdrop-filter: var(--glass-blur-rich);
  }

  .header {
    height: auto;
    position: sticky;
    top: 0;
    z-index: 5;
    width: 100%;
    transition:
      top 0.3s ease-in-out,
      width 0.3s ease-in-out;
  }

  .nav__list-full {
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    font-family: var(--mono);
    font-size: var(--text-base);
    padding: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    text-transform: uppercase;
  }

  .nav__logo {
    height: 40px;
    width: 40px;
  }

  .nav__list {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-flow: row wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .nav__link {
    color: var(--gold);
    text-decoration: none;
    display: inline-block;
  }

  .social__icons {
    width: 20px;
    height: 20px;
    fill: var(--gold);
    vertical-align: -0.125em;
  }

  :global(a:hover) .social__icons {
    fill: var(--white);
  }

  .small-nav {
    max-width: 1280px;
    top: 10px;
    margin: 0 auto;
    overflow: hidden;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  .nav--rounded {
    border-radius: 10px;
  }

  @media screen and (max-width: 800px) {
    .mob__hide {
      display: none;
    }
  }

  .menu-btn--hamburger {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border: none;
  }

  .menu-btn--hamburger:hover {
    cursor: pointer;
  }

  .menu-btn__icon {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 800px) {
    .nav__list-full {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .nav__link--mini {
      display: none;
    }

    .menu-btn--hamburger {
      display: flex;
    }
  }

  .nav__links-mob {
    display: inline-block;
  }

  .nav__dropdown {
    display: flex;
    flex-direction: column;
    align-items: start;
    height: 92vh;
    font-size: var(--title-4);
  }
</style>
