---
// Cookie-consent-gated Microsoft Clarity + Google Analytics loader.
// Kept verbatim from the original pages; `is:inline` stops Astro bundling it,
// because script.js calls loadClarity() / loadGoogleAnalytics() as globals.
---

<script type="text/javascript" is:inline>
  const isProduction = [
    'billynightingale.com',
    'www.billynightingale.com',
  ].includes(window.location.hostname)

  const scriptLoaded = {
    clarity: false,
    googleAnalytics: false,
  }

  let cookiesAccepted = localStorage.getItem('cookiesAccepted') === 'true'

  if (isProduction && cookiesAccepted) {
    loadClarity()
    loadGoogleAnalytics()
  } else {
    console.log(
      `Tracking scripts not loaded., Production: ${isProduction}, Cookies accepted: ${cookiesAccepted}`,
    )
  }

  function updateCookiesAccepted() {
    cookiesAccepted = localStorage.getItem('cookiesAccepted') === 'true'
  }

  function loadClarity() {
    cookiesAccepted = localStorage.getItem('cookiesAccepted')
    if (scriptLoaded.clarity || !isProduction || !cookiesAccepted) {
      console.log(
        `Clarity script already loaded:, ${scriptLoaded.clarity}, Production: ${isProduction}, Cookie: ${cookiesAccepted}`,
      )
      return
    }
    ;(function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          ;(c[a].q = c[a].q || []).push(arguments)
        }
      t = l.createElement(r)
      t.async = 1
      t.src = 'https://www.clarity.ms/tag/' + i
      y = l.getElementsByTagName(r)[0]
      y.parentNode.insertBefore(t, y)
    })(window, document, 'clarity', 'script', 'wpv1qvf7nc')
    scriptLoaded.clarity = true
    console.log(
      `Clarity script loaded successfully. Production: ${isProduction}, Cookies accepted: ${cookiesAccepted}, scriptLoaded: ${scriptLoaded.clarity}`,
    )
  }

  function loadGoogleAnalytics() {
    if (scriptLoaded.googleAnalytics || !isProduction) {
      console.log(
        `Google Analytics script already loaded:, ${scriptLoaded.googleAnalytics}, Production: ${isProduction},  Cookies accepted: ${cookiesAccepted}`,
      )
      return
    }
    const googleScript = document.createElement('script')
    googleScript.src =
      'https://www.googletagmanager.com/gtag/js?id=G-LVZ55QWZGE'
    googleScript.async = true
    document.head.appendChild(googleScript)

    window.dataLayer = window.dataLayer || []
    function gtag() {
      dataLayer.push(arguments)
    }
    gtag('js', new Date())

    gtag('config', 'G-LVZ55QWZGE')
    scriptLoaded.googleAnalytics = true
    console.log(
      `Google Analytics script loaded successfully. Production: ${isProduction}, Cookies accepted: ${cookiesAccepted}, scriptLoaded: ${scriptLoaded.googleAnalytics}, Cookie: ${cookiesAccepted}`,
    )
  }
</script>
