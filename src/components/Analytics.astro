---
// Cookie-consent-gated Microsoft Clarity + Google Analytics loader.
// `is:inline` stops Astro bundling it: src/scripts/cookieBanner.js calls loadClarity(),
// loadGoogleAnalytics() and updateCookiesAccepted() as globals when the
// visitor accepts the cookie banner, and withdrawClarityConsent() when a
// visitor who had accepted denies.
//
// Nothing loads unless BOTH are true: the page is on the production domain,
// and localStorage 'cookiesAccepted' is exactly 'true'.
---

<script type="text/javascript" is:inline>
  const isProduction = [
    'billynightingale.com',
    'www.billynightingale.com',
  ].includes(window.location.hostname)

  const scriptLoaded = {
    clarity: false,
    googleAnalytics: false,
  }

  let cookiesAccepted = localStorage.getItem('cookiesAccepted') === 'true'

  loadClarity()
  loadGoogleAnalytics()

  function updateCookiesAccepted() {
    cookiesAccepted = localStorage.getItem('cookiesAccepted') === 'true'
  }

  function loadClarity() {
    updateCookiesAccepted()
    if (scriptLoaded.clarity || !isProduction || !cookiesAccepted) return
    ;(function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          ;(c[a].q = c[a].q || []).push(arguments)
        }
      t = l.createElement(r)
      t.async = 1
      t.src = 'https://www.clarity.ms/tag/' + i
      y = l.getElementsByTagName(r)[0]
      y.parentNode.insertBefore(t, y)
    })(window, document, 'clarity', 'script', 'wpv1qvf7nc')
    // Tell Clarity the visitor accepted. Since 31 October 2025 Clarity waits
    // for this signal before setting its cookies (_clck, _clsk) for visitors
    // in the EEA, the UK and Switzerland; without it every page view is a
    // separate anonymous visit. The call is queued until Clarity has loaded.
    // Audience measurement only: advertising storage stays denied.
    // https://learn.microsoft.com/en-us/clarity/setup-and-installation/clarity-consent-api-v2
    window.clarity('consentv2', {
      ad_Storage: 'denied',
      analytics_Storage: 'granted',
    })
    scriptLoaded.clarity = true
  }

  // Called by cookieBanner.js when a visitor who had accepted chooses "Deny":
  // Clarity deletes its cookies and ends the session.
  window.withdrawClarityConsent = function () {
    if (!scriptLoaded.clarity) return
    window.clarity('consentv2', {
      ad_Storage: 'denied',
      analytics_Storage: 'denied',
    })
  }

  function loadGoogleAnalytics() {
    updateCookiesAccepted()
    if (scriptLoaded.googleAnalytics || !isProduction || !cookiesAccepted) return
    const googleScript = document.createElement('script')
    googleScript.src =
      'https://www.googletagmanager.com/gtag/js?id=G-LVZ55QWZGE'
    googleScript.async = true
    document.head.appendChild(googleScript)

    window.dataLayer = window.dataLayer || []
    function gtag() {
      dataLayer.push(arguments)
    }
    gtag('js', new Date())

    gtag('config', 'G-LVZ55QWZGE')
    scriptLoaded.googleAnalytics = true
  }
</script>
