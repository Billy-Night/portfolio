---
// A section of rows, each with a photo on one side and a light text panel on
// the other. Used by about/AboutWhatIDo.astro and landes/LandesSeoResults.astro.
// Each row is an ImageTextRow.astro:
//
//   <ImageTextRows heading="..." intro="...">
//     <ImageTextRow imageSide="left">
//       <Photo slot="image" ... />
//       <h3>...</h3> <p>...</p>
//     </ImageTextRow>
//   </ImageTextRows>
interface Props {
  heading: string
  intro: string
}

const { heading, intro } = Astro.props
---

<section class="image-rows">
  <div class="image-rows__heading">
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="image-rows__list">
    <slot />
  </div>
</section>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md
     They also style the rows inside it (ImageTextRow.astro). -->
<style>
  .image-rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .image-rows__heading {
    text-align: center;
    padding: var(--space-6) var(--page-gutter);
  }

  /* Full width, up to the rows' own limit. Without a width of its own this box
     took its width from the photos, so on tablets the rows were narrow until
     each photo loaded and then jumped wider. */
  .image-rows__list {
    width: 100%;
    max-width: 2000px;
  }

  :global(.image-row) {
    display: grid;
    max-width: 2000px;
    grid-template-columns: 1fr 1fr;
    row-gap: var(--gap-md);
    column-gap: clamp(var(--space-6), 6vw, var(--space-9));
    padding-top: clamp(var(--space-7), 8vw, var(--space-9));
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
  }

  :global(.image-row__image--right) {
    grid-column: 2 / 3;
    grid-row: 1;
    width: 100%;
    display: block;
    -webkit-mask-image: linear-gradient(
      to right,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
  }

  :global(.image-row__image) {
    position: relative;
  }

  :global(.image-row__image) :global(img) {
    width: 100%;
    max-width: 900px;
    display: block;
    -webkit-mask-image: linear-gradient(
      to left,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to left,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
  }

  :global(.image-row__text) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  :global(.image-row__panel) {
    background-color: var(--cream);
    border: var(--glass-border-faint);
    border-radius: var(--corner-rad);
    text-align: center;
    padding: clamp(var(--space-4), 4vw, var(--space-10));
  }

  :global(.image-row__panel) :global(h3) {
    color: var(--dark);
  }

  :global(.image-row__panel) :global(p) {
    color: var(--dark);
  }

  :global(.image-row__text--pad-left) {
    padding-left: var(--page-gutter);
  }

  :global(.image-row__text--pad-right) {
    padding-right: var(--page-gutter);
  }

  :global(.image-row__buttons) {
    margin-top: clamp(var(--space-3), 4vw, var(--space-6));
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: var(--space-4);
  }

  @media screen and (max-width: 900px) {
    :global(.image-row) {
      grid-template-columns: 1fr;
    }

    :global(.image-row__image--right) {
      grid-column: 1;
    }

    :global(.image-row__text) {
      padding-left: var(--page-gutter);
      padding-right: var(--page-gutter);
    }
  }
</style>
