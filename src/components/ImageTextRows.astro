---
// A section of rows, each with a photo on one side and a light text panel on
// the other. Used by about/AboutWhatIDo.astro and landes/LandesSeoResults.astro.
// Each row is an ImageTextRow.astro:
//
//   <ImageTextRows heading="..." intro="...">
//     <ImageTextRow imageSide="left">
//       <Photo slot="image" ... />
//       <h3>...</h3> <p>...</p>
//     </ImageTextRow>
//   </ImageTextRows>
interface Props {
  heading: string
  intro: string
}

const { heading, intro } = Astro.props
---

<section class="wid__sec">
  <div class="wid__heading-container">
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="wid__content-container">
    <slot />
  </div>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md
     They also style the rows inside it (ImageTextRow.astro). -->
<style is:global>
  .wid__sec {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wid__heading-container {
    text-align: center;
    padding: var(--space-6) var(--page-gutter);
  }

  .wid__row {
    display: grid;
    max-width: 2000px;
    grid-template-columns: 1fr 1fr;
    row-gap: var(--gap-md);
    column-gap: clamp(var(--space-6), 6vw, var(--space-9));
    padding-top: clamp(var(--space-7), 8vw, var(--space-9));
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .wid__right {
    grid-column: 2 / 3;
    grid-row: 1;
  }

  .wid__img-cont {
    position: relative;
  }

  .wid__img-cont img {
    width: 100%;
    max-width: 900px;
    display: block;
    -webkit-mask-image: linear-gradient(
      to left,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to left,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
  }

  .wid__img-cont-right {
    width: 100%;
    display: block;
    -webkit-mask-image: linear-gradient(
      to right,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      black 60%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
  }

  .wid__text-cont {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .wid__text {
    background-color: var(--cream);
    border: var(--glass-border-faint);
    border-radius: var(--corner-rad);
    text-align: center;
    padding: clamp(var(--space-4), 4vw, var(--space-10));
  }

  .wid__text h3 {
    color: var(--dark);
  }

  .wid__text p {
    color: var(--dark);
  }

  .txt-l {
    padding-left: var(--page-gutter);
  }

  .txt-r {
    padding-right: var(--page-gutter);
  }

  .wid__content_cta {
    margin-top: clamp(var(--space-3), 4vw, var(--space-6));
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: var(--space-4);
  }

  @media screen and (max-width: 900px) {
    .wid__row {
      grid-template-columns: 1fr;
    }

    .wid__right {
      grid-column: 1;
    }

    .wid__text-cont {
      padding-left: var(--page-gutter);
      padding-right: var(--page-gutter);
    }
  }
</style>
