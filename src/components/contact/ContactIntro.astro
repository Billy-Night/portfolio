---
// Contact page: photo and introduction text.
// Shared by src/pages/contact.astro and src/pages/fr/contact.astro.
import { Image } from 'astro:assets'
import imgBillyNightingaleWebDesignerRendezVousAvecPacificCoastCafeHossegor from '../../assets/images/client_meetings/billy_nightingale_web_designer_rendez_vous_avec_pacific_coast_cafe_hossegor.webp'
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    imageAlt: "Billy Nightingale web designer having a meeting with clients in Hossegor",
    heading: "Let's work together",
    intro1: "I enjoy working closely with clients and helping translate technical ideas into clear, practical solutions. My goal is to ensure every client understands the project, feels comfortable with the technical decisions being made, and stays involved throughout the process.",
    intro2: "I see myself as a long-term technical partner rather than simply someone who builds websites. From strategy and design to performance, SEO and ongoing support, I work closely with businesses to help them grow online with confidence.",
  },
  fr: {
    imageAlt: "Billy Nightingale, web designer, en rendez-vous avec des clients à Hossegor",
    heading: "Travaillons ensemble",
    intro1: "J’aime travailler en étroite collaboration avec mes clients et transformer des idées techniques en solutions claires et concrètes. Mon objectif est que chaque client comprenne le projet, se sente à l’aise avec les choix techniques réalisés et reste impliqué tout au long du processus.",
    intro2: "Je me considère comme un partenaire technique sur le long terme plutôt que simplement comme quelqu’un qui crée des sites web. De la stratégie et du design à la performance, au SEO et au support continu, je travaille en collaboration avec les entreprises pour les aider à développer leur présence en ligne avec confiance.",
  },
}[lang]
---

<section class="section-pad">
  <div class="layout-two-column content-cont-marg-right">
    <div class="layout-two-column-img img-overlay-blur-left">
      <Image
        src={imgBillyNightingaleWebDesignerRendezVousAvecPacificCoastCafeHossegor}
        alt={t.imageAlt}
        class="img-rad"
        width={1080}
        widths={[540, 810, 1080]}
        sizes="(max-width: 800px) 100vw, 616px"
        loading="eager"
      />
    </div>
    <div class="layout-two-column-txt contact__txt-normal-flow glass__back loc-mob-margin-left">
      <h1 class="trans-caps">{t.heading}</h1>
      <p class="max-txt-width">{t.intro1}</p>
      <p class="max-txt-width">{t.intro2}</p>
    </div>
  </div>
</section>
