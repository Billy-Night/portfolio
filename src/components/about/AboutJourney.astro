---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "THE JOURNEY",
    intro: "My engineering and web development journey",
    // Each timeline step is two words, each in its own <span>
    degree: ["Motorsport", "Engineering"],
    firstCareer: ["Mechatronics", "Engineer"],
    webTraining: ["Web", "Development"],
  },
  fr: {
    heading: "LE PARCOURS",
    intro: "Mon parcours en ingénierie et développement web",
    degree: ["Ingénierie", "Motorsport"],
    firstCareer: ["Ingénieur", "Mécatronique"],
    webTraining: ["Développement", "Web"],
  },
}[lang]
---

<section class="timeline__section" id="about__timeline-section">
  <div class="tl__heading-container">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="tl__container">
    <div class="tl__line-container">
      <svg
        class="tl_svg"
        viewBox="0 0 603 2137"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle class="tl_dot" r="12"></circle>
        <path
          class="tl_line"
          d="M308 0C308 39.7738 275.757 72.0169 235.983 72.0169L141.5 72.0169C64.1801 72.0169 1.5 134.697 1.5 212.017V422.143C1.5 499.463 64.1801 562.143 141.5 562.143H461.5C538.82 562.143 601.5 624.823 601.5 702.143V959.778C601.5 1037.1 538.82 1099.78 461.5 1099.78H141.5C64.1801 1099.78 1.5 1162.46 1.5 1239.78V1459.91C1.5 1537.23 64.1801 1599.91 141.5 1599.91H461.5C538.82 1599.91 601.5 1662.59 601.5 1739.91V1925.52C601.5 2002.84 538.82 2065.52 461.5 2065.52H381.52C342.573 2065.52 311 2097.1 311 2136.04"
          stroke-width="3"
        />
      </svg>
    </div>
    <div class="tl__content-container">
      <div class="time-step time__step-1 glass__back ts-padding-l">
        <h3 class="h4-style ts-about-heading ts-heading hide-ts-h">
          <span>BEng</span> <span>{t.degree[0]}</span>
          <span>{t.degree[1]}</span>
        </h3>
      </div>
      <div class="time-step time__step-2 glass__back ts-padding-l">
        <h3 class="h4-style ts-about-heading ts-heading hide-ts-h">
          <span>{t.firstCareer[0]}</span> <span>{t.firstCareer[1]}</span>
        </h3>
      </div>
      <div class="time-step time__step-3 glass__back ts-padding-l">
        <h3 class="h4-style ts-about-heading ts-heading hide-ts-h">
          <span>Bac</span> <span>+2</span> <span>{t.webTraining[0]}</span>
          <span>{t.webTraining[1]}</span>
        </h3>
      </div>
      <div class="time-step time__step-4 glass__back ts-padding-l">
        <h3 class="h4-style ts-about-heading ts-heading hide-ts-h">
          <span>Billy</span> <span>Nightingale</span> <span>Web</span>
          <span>Studio</span>
        </h3>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/timeline.js'
</script>
