---
// Shared by the English and French pages. Text that differs is in the table below.
import ImageTextRow from '../ImageTextRow.astro'
import ImageTextRows from '../ImageTextRows.astro'
import Photo from '../Photo.astro'
import imgBillyNightingaleWebDesignFigma from '../../assets/images/about_wid/billy_nightingale_web_design_figma.webp'
import imgBillyNightingaleWebOptimistationLighthouse from '../../assets/images/about_wid/billy_nightingale_web_optimistation_lighthouse.webp'
import imgBillyNightingaleWebDevelopment from '../../assets/images/about_wid/billy_nightingale_web_development.webp'
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "WHAT I DO",
    intro: "I build websites, systems and applications",
    designImageAlt: "Billy Nightingale using Figma for web design",
    designHeading: "WEBSITE DESIGN",
    designText1: "Designing websites for small to medium size businesses, with the use of cutting edge technology like Figma and relume AI to provide the highest quality design",
    designText2: "Creating assets like SVGs, icons and editing images with Affinity and Adobe to enhance the visual experience",
    projectsButton: "PROJECTS",
    seoHeading: "SEO & PERFORMANCE OPTIMISATION",
    seoText: "Optimise performance and SEO to drive traffic and increase revenue, I strive to provide the fastest most accessible sites with great user experience.",
    developmentHeading: "WEBSITE DEVELOPMENT",
    developmentText: "Full-stack web development, developing products and tools. I develop website using tool such as Wordpress and Elementor but also full-stack application through programming with languages such as JavaScript, frameworks like React and Node.JS",
  },
  fr: {
    heading: "CE QUE JE FAIS",
    intro: "Je crée des sites web, des systèmes et des applications",
    designImageAlt: "Billy Nightingale utilisant Figma pour le design web",
    designHeading: "DESIGN DE SITE WEB",
    designText1: "Création de sites web pour les petites et moyennes entreprises, en utilisant des technologies modernes comme Figma et Relume AI afin de proposer un design de haute qualité.",
    designText2: "Création d’éléments visuels comme des SVG, des icônes et retouche d’images avec Affinity et Adobe afin d’améliorer l’expérience visuelle.",
    projectsButton: "PROJETS",
    seoHeading: "OPTIMISATION SEO & PERFORMANCE",
    seoText: "J’optimise les performances et le SEO afin d’augmenter le trafic et les revenus. Je cherche à créer des sites rapides, accessibles et offrant une excellente expérience utilisateur.",
    developmentHeading: "DÉVELOPPEMENT WEB",
    developmentText: "Développement web full-stack, création de produits et d’outils numériques. Je développe des sites avec des outils comme WordPress et Elementor, mais aussi des applications full-stack avec des langages comme JavaScript et des frameworks comme React et Node.js.",
  },
}[lang]
---

<ImageTextRows heading={t.heading} intro={t.intro}>
  <ImageTextRow imageSide="left">
    <Photo
      slot="image"
      src={imgBillyNightingaleWebDesignFigma}
      alt={t.designImageAlt}
      loading="lazy"
    />
    <h3>{t.designHeading}</h3>
    <p>
      {t.designText1}
    </p>
    <p>
      {t.designText2}
    </p>
    <div class="image-row__buttons">
      <a class="btn__primary btn__prim--dark" href={r('services')}
        >SERVICES</a
      >
      <a class="btn__second btn__second--dark" href={`${r('home')}#projects`}
        >{t.projectsButton}</a
      >
    </div>
  </ImageTextRow>

  <ImageTextRow imageSide="right">
    <Photo
      slot="image"
      src={imgBillyNightingaleWebOptimistationLighthouse}
      alt="Billy Nightingale using Google Lighthouse to optimise websites"
      loading="lazy"
    />
    <h3>{t.seoHeading}</h3>
    <p>
      {t.seoText}
    </p>
    <div class="image-row__buttons">
      <a class="btn__primary btn__prim--dark" href={r('services')}
        >SERVICES</a
      >
      <a class="btn__second btn__second--dark" href={`${r('home')}#projects`}
        >{t.projectsButton}</a
      >
    </div>
  </ImageTextRow>

  <ImageTextRow imageSide="left">
    <Photo
      slot="image"
      src={imgBillyNightingaleWebDevelopment}
      alt="Billy Nightingale using VSCode for web development"
      loading="lazy"
    />
    <h3>{t.developmentHeading}</h3>
    <p>
      {t.developmentText}
    </p>
    <div class="image-row__buttons">
      <a class="btn__primary btn__prim--dark" href={r('services')}
        >SERVICES</a
      >
      <a class="btn__second btn__second--dark" href={`${r('home')}#projects`}
        >{t.projectsButton}</a
      >
    </div>
  </ImageTextRow>
</ImageTextRows>
