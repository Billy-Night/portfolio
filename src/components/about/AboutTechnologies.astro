---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "THE TECHNOLOGIES AND TOOLS",
    intro: "The technologies I choose for a project depend on the scope and requirements of the website or application, I work with the latest cutting edge technology, but I always choose what is practical for the size and budget of the project, some of the main technologies I work with are",
    projectManagementHeading: "Project Management",
    deploymentHeading: "Deployment",
    developmentHeading: "Development",
  },
  fr: {
    heading: "LES TECHNOLOGIES ET OUTILS",
    intro: "Les technologies que je choisis pour un projet dépendent de son périmètre et des besoins du site web ou de l’application. Je travaille avec des technologies modernes, mais je privilégie toujours les solutions les plus adaptées à la taille et au budget du projet. Voici quelques-unes des principales technologies avec lesquelles je travaille :",
    projectManagementHeading: "Gestion de projet",
    deploymentHeading: "Déploiement",
    developmentHeading: "Développement",
  },
}[lang]
---

<section class="sections">
  <div class="technologies__heading">
    <h2>{t.heading}</h2>
    <p class="max-txt-width">
      {t.intro}
    </p>
  </div>
  <div class="technologies__list">
    <div class="technologies__group">
      <h3 class="h4-style">{t.projectManagementHeading}</h3>
      <div class="technologies__items">
        <span>Google Drive</span>
        <span>Notion</span>
        <span>Trello</span>
        <span>ClickUp</span>
      </div>
    </div>
    <div class="technologies__group">
      <h3 class="h4-style">Design</h3>
      <div class="technologies__items">
        <span>Relume</span>
        <span>Figma</span>
        <span>Affinity</span>
        <span>Unicorn studio</span>
      </div>
    </div>
    <div class="technologies__group">
      <h3 class="h4-style">{t.developmentHeading}</h3>
      <div class="technologies__items">
        <span>Wordpress</span>
        <span>Elementor Pro</span>
        <span>HTML</span>
        <span>CSS</span>
        <span>JavaScript</span>
        <span>React</span>
        <span>NodeJS</span>
        <span>MySQL</span>
      </div>
    </div>
    <div class="technologies__group">
      <h3 class="h4-style">{t.deploymentHeading}</h3>
      <div class="technologies__items">
        <span>Hostinger</span>
        <span>Netlify Pro</span>
        <span>Railway</span>
      </div>
    </div>
  </div>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  .technologies__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .technologies__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 2px solid white;
    border-radius: var(--corner-rad);
    box-shadow: var(--glass-shadow);
  }

  .technologies__group {
    padding: clamp(var(--space-3), 4vw, var(--space-7));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(var(--space-3), 4vw, var(--space-5));
  }

  .technologies__items {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .technologies__items > span {
    background-color: var(--gold);
    padding: var(--space-3);
    border-radius: var(--corner-rad);
    color: var(--dark);
    font-family: var(--mono);
  }

  @media screen and (max-width: 848px) {
    .technologies__list {
      grid-template-columns: 1fr;
    }
  }
</style>
