---
// Shared by the English and French pages. Text that differs is in the table below.
import ContactCta from '../ContactCta.astro'
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "CONTACT ME",
    intro: "I’m always available to discuss new projects, feel free to contact me through my social networks or fill in the form on my about page, lets get your project going!",
    emailButton: "Email Me",
  },
  fr: {
    heading: "CONTACTEZ-MOI",
    intro: "Je suis toujours disponible pour discuter de nouveaux projets. N’hésitez pas à me contacter via mes réseaux sociaux ou à remplir le formulaire sur ma page à propos. Donnons vie à votre projet",
    emailButton: "Mail",
  },
}[lang]
---

<ContactCta id="contact" heading={t.heading} intro={t.intro} introClass="max-txt-width" socialLinks>
  <a
    class="btn__primary btn__prim--light"
    href="mailto:contact@billynightingale.com"
    >{t.emailButton}</a
  >
  <a class="btn__second btn__second--light" href={r('services')}
    >Services</a
  >
</ContactCta>
