---
// Shared by the English and French pages. Text that differs is in the table below.
import Hero from '../Hero.astro'
import Photo from '../Photo.astro'
import imgBillyNightingaleWebDesignerCapbreton from '../../assets/images/portraits/billy_nightingale_web_designer_capbreton.webp'
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    titleWord: "ABOUT",
    introHeading: "A BRIEF INTRO",
    intro1: "I’m Billy Nightingale, a web designer and developer based in Capbreton, which is part of the Landes region in France. I help small local businesses create modern, high-performing websites that are fast, search-engine friendly, and designed to support real business growth.",
    intro2: "With a background in mechanical engineering and a strong focus on problem solving, I combine technical development with thoughtful design to build websites that are both functional and visually engaging. My work ranges from WordPress websites for local businesses to custom web applications and digital tools designed to simplify operations and improve online presence.",
    ctaText: "Jump back and check out my projects or learn more",
    learnMoreButton: "LEARN MORE",
    projectsButton: "PROJECTS",
  },
  fr: {
    titleWord: "À PROPOS",
    introHeading: "BRÈVE INTRODUCTION",
    intro1: "Je suis Billy Nightingale, web designer et développeur basé à Capbreton, dans les Landes, en France. J’aide les petites entreprises locales à créer des sites web modernes, performants, rapides, optimisés pour les moteurs de recherche et pensés pour soutenir leur croissance.",
    intro2: "Avec une formation en ingénierie mécanique et une approche axée sur la résolution de problèmes, je combine développement technique et design réfléchi pour créer des sites web à la fois fonctionnels et visuellement engageants. Mon travail va des sites WordPress pour les entreprises locales aux applications web sur mesure et aux outils numériques conçus pour simplifier les opérations et améliorer la présence en ligne.",
    ctaText: "Retournez voir mes projets ou découvrez-en plus",
    learnMoreButton: "EN SAVOIR PLUS",
    projectsButton: "PROJETS",
  },
}[lang]
---

<Hero title="BILLY NIGHTINGALE">
  <span slot="title-word" class="hero__title-word">{t.titleWord}</span>
  <Photo
    slot="photo"
    src={imgBillyNightingaleWebDesignerCapbreton}
    alt="Portrait of Billy Nightingale looking at web design on laptop"
    class="about-intro__image"
    loading="eager"
    fetchpriority="high"
  />
  <h2>{t.introHeading}</h2>
  <p>
    {t.intro1}
  </p>
  <p>
    {t.intro2}
  </p>
  <p>{t.ctaText}</p>
  <div class="cta-container">
    <a
      class="btn__primary btn__prim--light"
      href="#about__timeline-section"
      >{t.learnMoreButton}</a
    >
    <a class="btn__second btn__second--light" href={`${r('home')}#projects`}
      >{t.projectsButton}</a
    >
  </div>
</Hero>
