---
// A list with the gold diamond as its bullet. Each bullet fades in the first
// time it scrolls into view (src/scripts/bullets.js). Use it wherever the site
// needs a bullet list, so they all look and behave the same.
import BulletIcon from './BulletIcon.astro'

interface Props {
  items: string[]
  /** Replaces the default 'bullet-list' class, for a list with its own layout (the package cards) */
  listClass?: string
  /**
   * Not for callers. Astro passes the scope class of the component that uses
   * this list in here by itself, which is why the list's own class has a
   * prop of its own above: as `class`, its default would be overwritten.
   */
  class?: string
}

const { items, listClass = 'bullet-list', class: scopeClass } = Astro.props
---

<ul class:list={[listClass, scopeClass]}>
  {
    items.map((item) => (
      <li>
        <div class="bullet-point-container">
          <BulletIcon class="bullet-point-svg" />
          <span>{item}</span>
        </div>
      </li>
    ))
  }
</ul>

<script>
  import '../scripts/bullets.js'
</script>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md
     The package cards on the services page give their list its own class and layout instead of 'bullet-list'. -->
<style>
  .bullet-point-container {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    transition:
      opacity 600ms ease,
      transform 600ms ease;
  }

  /* Added by src/scripts/bullets.js to bullets further down the page, and
     removed when they scroll into view. Without the script nothing is hidden. */
  .bullet-point-container.is-waiting {
    opacity: 0;
    transform: translateY(20px);
  }

  :global(.bullet-point-svg) {
    flex-shrink: 0;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    fill: var(--gold);
  }

  /* A plain bullet list (src/components/BulletList.astro). The package cards on
     the services page give their list its own class and layout instead. */
  :global(.bullet-list) {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-3);
  }

  /* Keep the diamond beside the first line when the text runs to several lines */
  :global(.bullet-list) .bullet-point-container {
    align-items: flex-start;
  }

  :global(.bullet-list) :global(span) {
    line-height: var(--leading-body);
  }

  /* Reduced motion: bullets fade in without sliding up. This must come after
     the rule above that slides them. */
  @media (prefers-reduced-motion: reduce) {
    .bullet-point-container.is-waiting {
      transform: none;
    }
  }
</style>
