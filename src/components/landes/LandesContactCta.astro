---
// Shared by the English and French pages. Text that differs is in the table below.
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "Ready to discuss your project",
    intro: "Book a call or request a quote now",
    quoteButton: "Quote",
    emailButton: "EMAIL ME",
  },
  fr: {
    heading: "Prêt à discuter de votre projet ?",
    intro: "Réservez un appel ou demandez un devis dès aujourd’hui.",
    quoteButton: "Devis",
    emailButton: "PAR MAIL",
  },
}[lang]
---

<section class="sections">
  <div class="section-contact-container">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
    <div class="cta-container">
      <a
        class="btn__primary btn__prim--light"
        href="mailto:contact@billynightingale.com"
        >{t.emailButton}</a
      >
      <a class="btn__second btn__second--light" href={r('contact')}
        >{t.quoteButton}</a
      >
    </div>
  </div>
</section>
