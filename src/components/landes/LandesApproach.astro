---
// Shared by the English and French pages. Text that differs is in the table below.
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "My approach for local businesses in Landes",
    text1: "My approach combines thoughtful design with technical performance, creating websites that not only look professional but help local businesses grow online.",
    text2: "My designs are focused on bringing out the company’s visual identity and crafting a design for the local culture, they are designed to be effective for the Landes market.",
    text3: "This means improving conversions and increasing growth, locally in Landes.",
    text4: "Each site is optimised for performance and visibility in the local Landes market to convert clients.",
    text5: "Faster websites provide a better user experience and stronger SEO performance, helping local businesses attract more visitors and generate more enquiries.",
    problemsHeading: "Solve Business problems",
    problemsText1: "Every business is different. Some need more reservations, some need more visibility and others need a better way to sell online. My goal is to understand the challenges behind the website and build a solution around them.",
    problemsText2: "See some tailored solutions for local businesses below.",
    supportText: "As your digital local partner I offer ongoing support packages to ensure your website stays at top performance while generating growth.",
    projectsButton: "PROJECTS",
  },
  fr: {
    heading: "Mon approche pour les entreprises des Landes",
    text1: "J’associe design réfléchi et performance technique afin de créer des sites web qui inspirent confiance, renforcent votre image de marque et contribuent au développement de votre activité.",
    text2: "Mes créations mettent en valeur l’identité visuelle de chaque entreprise tout en s’inspirant de la culture locale et de l’environnement des Landes.",
    text3: "L’objectif est d’améliorer les conversions et de soutenir votre croissance locale.",
    text4: "Chaque site est optimisé pour offrir rapidité, visibilité et efficacité sur le marché local.",
    text5: "Un site rapide améliore l’expérience utilisateur, favorise le référencement naturel et aide votre entreprise à attirer davantage de visiteurs qualifiés.",
    problemsHeading: "Résoudre des problèmes",
    problemsText1: "Chaque entreprise est différente. Certaines cherchent à augmenter leurs réservations, d’autres à gagner en visibilité ou à vendre plus efficacement en ligne. Mon rôle consiste à comprendre ces enjeux afin de construire une solution adaptée.",
    problemsText2: "Découvrez quelques exemples de solutions mises en place pour des entreprises locales.",
    supportText: "En tant que partenaire digital local, je propose également un accompagnement continu afin de maintenir votre site performant, sécurisé et capable de soutenir votre croissance.",
    projectsButton: "PROJETS",
  },
}[lang]
---

<section class="landes-approach">
  <div class="subheading-centred">
    <h2>{t.heading}</h2>
    <p class="max-txt-width">
      {t.text1}
    </p>
  </div>
  <div class="landes-approach__content">
    <div class="landes-approach__row--1">
      <div class="landes-approach__card--design landes-approach__card">
        <svg
          class="landes-approach__icon"
          width="302"
          height="102"
          viewBox="0 0 302 102"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
            stroke="none"
            stroke-width="2"
          />
        </svg>
        <div class="landes-approach__card-heading">
          <h3>Design</h3>
        </div>

        <p class="max-txt-width">
          {t.text2}
        </p>
        <p class="max-txt-width">
          {t.text3}
        </p>
      </div>
      <div class="landes-approach__card--design landes-approach__card">
        <svg
          class="landes-approach__icon"
          width="302"
          height="102"
          viewBox="0 0 302 102"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
            stroke="none"
            stroke-width="2"
          />
        </svg>
        <div class="landes-approach__card-heading">
          <h3>performance</h3>
        </div>

        <p class="max-txt-width">
          {t.text4}
        </p>
        <p class="max-txt-width">
          {t.text5}
        </p>
      </div>
    </div>
    <div class="landes-approach__row--2">
      <div class="landes-approach__card--performance landes-approach__card">
        <svg
          class="landes-approach__icon"
          width="302"
          height="102"
          viewBox="0 0 302 102"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18.1141 1L1 30.5918V71.4082L18.1141 101H283.886L301 71.4082V30.5918L283.886 1H18.1141Z"
            stroke="none"
            stroke-width="2"
          />
        </svg>
        <div class="landes-approach__card-heading">
          <h3>{t.problemsHeading}</h3>
        </div>
        <p class="max-txt-width">
          {t.problemsText1}
        </p>
        <p>{t.problemsText2}</p>
      </div>
    </div>
  </div>
  <div class="landes-approach__closing">
    <p class="max-txt-width">
      {t.supportText}
    </p>
    <div class="cta-container">
      <a class="btn__primary btn__prim--light" href={r('services')}
        >SERVICES</a
      >
      <a class="btn__second btn__second--light" href={`${r('home')}#projects`}
        >{t.projectsButton}</a
      >
    </div>
  </div>
</section>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .landes-approach {
    max-width: var(--sec-width);
    margin: 0 auto;
    padding: var(--padding-hor-section) var(--page-gutter);
  }

  .landes-approach__content {
    padding-top: var(--padding-hor-section);
  }

  .landes-approach__row--1 {
    padding-top: var(--padding-hor-section);
    padding-bottom: var(--padding-hor-section);
    display: flex;
    flex-direction: row;
    gap: var(--gap-md);
    justify-content: center;
    overflow: visible;
  }

  .landes-approach__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: var(--light-container);
    border-radius: var(--corner-rad);
    color: var(--dark);
    padding: var(--space-5);
    padding-top: var(--space-7);
    width: 100%;
  }

  .landes-approach__card:hover {
    .landes-approach__card-heading {
      transform: translateY(-80%);
    }
  }

  .landes-approach__icon {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    fill: var(--page-background);
  }

  .landes-approach__card-heading {
    background-image: url('/assets/art_work/title_rect.svg');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    width: 302px;
    height: 102px;
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    transition: transform 0.4s ease;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .landes-approach__card-heading:hover {
    transform: translateY(-80%);
  }

  .landes-approach__row--2 {
    padding-top: var(--padding-hor-section);
    display: flex;
    justify-content: center;
  }

  .landes-approach__closing {
    padding-top: var(--padding-hor-section);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (max-width: 800px) {
    .landes-approach__row--1 {
      flex-direction: column;
      gap: var(--space-10);
      padding-bottom: 0px;
    }

    .landes-approach__row--2 {
      padding-top: var(--space-10);
    }
  }

  @media screen and (max-width: 400px) {
    .landes-approach__icon {
      width: 240px;
    }

    .landes-approach__card-heading {
      width: 240px;
      background-size: contain;
    }
  }
</style>
