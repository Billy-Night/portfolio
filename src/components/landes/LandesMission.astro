---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "grow your business",
    text1: "I craft premium websites and digital systems in the region of Landes, France.",
    text2: "The objective is to support local businesses in developing and growing in their local market, which is achieved by ongoing support and growth strategies tailored for the Landes region.",
    text3: "With a strong focus on building high performance websites with a 95+ score and top ranking websites in search results.",
  },
  fr: {
    heading: "Développez votre activité",
    text1: "Je conçois des sites web haut de gamme et des solutions digitales pour les entreprises situées dans les Landes.",
    text2: "Mon objectif est d’accompagner les entreprises locales dans leur développement grâce à un suivi personnalisé et à des stratégies de croissance adaptées au marché landais.",
    text3: "Je mets un point d’honneur à créer des sites performants, obtenant régulièrement des scores supérieurs à 95/100 et de solides résultats dans les moteurs de recherche.",
  },
}[lang]
---

<section class="landes-mission-section">
  <div class="landes-mission-container">
    <h2>{t.heading}</h2>
    <div class="mission-text-container">
      <p class="max-txt-width">
        {t.text1}
      </p>
      <p class="max-txt-width">
        {t.text2}
      </p>
      <p class="max-txt-width">
        {t.text3}
      </p>
    </div>
  </div>
</section>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .landes-mission-section {
    padding: var(--padding-hor-section) var(--page-gutter);
    padding-top: var(--padding-hor-section);
    padding-bottom: var(--padding-hor-section);
  }

  .landes-mission-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .mission-text-container {
    text-align: center;
  }
</style>
