---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    growYourBusiness: "grow your business",
    iCraftPremiumWeb: "I craft premium web sites and digital systems in the region of Landes, France.",
    theObjectiveIsTo: "The objective is to support local business in developing and growing in their local market. Which is achieved by ongoing support and growth strategies tailored for the Landes region.",
    withAStrongFocus: "With a strong focus on building high performance website’s with a 95+ score and top ranking websites in search results.",
  },
  fr: {
    growYourBusiness: "Développez votre activité",
    iCraftPremiumWeb: "Je conçois des sites web haut de gamme et des solutions digitales pour les entreprises situées dans les Landes.",
    theObjectiveIsTo: "Mon objectif est d’accompagner les entreprises locales dans leur développement grâce à un suivi personnalisé et à des stratégies de croissance adaptées au marché landais.",
    withAStrongFocus: "Je mets un point d’honneur à créer des sites performants, obtenant régulièrement des scores supérieurs à 95/100 et de solides résultats dans les moteurs de recherche.",
  },
}[lang]
---

<section class="landes-mission-section">
  <div class="landes-mission-container">
    <h2>{t.growYourBusiness}</h2>
    <div class="mission-text-container">
      <p class="max-txt-width">
        {t.iCraftPremiumWeb}
      </p>
      <p class="max-txt-width">
        {t.theObjectiveIsTo}
      </p>
      <p class="max-txt-width">
        {t.withAStrongFocus}
      </p>
    </div>
  </div>
</section>
