---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Real challenges, tailored solutions",
    intro: "I find tailored solutions to my clients’ requirements",
    bookingTab: "Simplifying reservation across locations",
    revenueTab: "Creating new revenue opportunities",
    launchTab: "Launching a brand online from day one",
    bookingHeading: "Multi-location booking",
    challengeLabel: "Challenge",
    bookingChallenge: "Monkey Mood operates restaurants in both Capbreton and Bordeaux. Customers needed a clearer way to navigate between locations and complete reservations.",
    bookingSolution: "Redesigned and rebuilt the website with a simplified booking journey, improved mobile experience and clearer location structure.",
    revenueHeading: "Creating new revenue opportunities",
    revenueChallenge: "Pacific Coast Café needed a stronger digital platform to support future growth and create additional revenue streams beyond the physical café.",
    revenueSolution: "Improved website performance and integrated an online shop, creating a foundation for e-commerce, gift cards and future expansion.",
    launchHeading: "Launching a brand online from day one",
    launchChallenge: "Turbulente Kombucha needed its first online presence to reflect its identity and connect with customers beyond local distribution.",
    launchSolution: "Designed and developed the company's first e-commerce website with a visual identity inspired by surfing, nature and the local coastline.",
  },
  fr: {
    heading: "Des défis concrets, des solutions sur mesure",
    intro: "Des solutions adaptées aux besoins réels de chaque client",
    bookingTab: "Simplifier les réservations entre plusieurs établissements",
    revenueTab: "Créer des opportunités de revenus",
    launchTab: "Lancer une marque en ligne",
    bookingHeading: "Simplifier les réservations entre plusieurs établissements",
    challengeLabel: "Défi",
    bookingChallenge: "Monkey Mood possède deux restaurants, à Capbreton et à Bordeaux. Les clients avaient besoin d’un parcours plus clair pour choisir leur établissement et réserver facilement.",
    bookingSolution: "Refonte complète du site avec un parcours de réservation simplifié, une expérience mobile améliorée et une structure plus claire entre les différents établissements.",
    revenueHeading: "Créer de nouvelles opportunités de revenus",
    revenueChallenge: "Pacific Coast Café souhaitait renforcer sa présence en ligne afin de soutenir sa croissance et développer de nouvelles sources de revenus au-delà du café physique.",
    revenueSolution: "Optimisation des performances du site et intégration d’une boutique en ligne, ouvrant la voie à l’e-commerce, aux cartes cadeaux et à de futurs développements.",
    launchHeading: "Lancer une marque en ligne dès le premier jour",
    launchChallenge: "Turbulente Kombucha avait besoin de sa première présence en ligne afin de présenter son identité de marque et de toucher ses clients au-delà de son réseau de distribution local.",
    launchSolution: "Conception et développement du premier site e-commerce de la marque, avec une identité visuelle inspirée du surf, de la nature et du littoral landais.",
  },
}[lang]
---

<section class="section-pad">
  <div class="subheading-centred">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="layout-two-column challenges">
    <div class="challenges__buttons">
      <button
        type="button"
        class="challenges__button is-active"
        data-index="0"
        aria-expanded="true"
        aria-controls="challenge-panel-0"
      >
        <span class="challenges__button-label">{t.bookingTab}</span>
      </button>
      <button
        type="button"
        class="challenges__button"
        data-index="1"
        aria-expanded="false"
        aria-controls="challenge-panel-1"
      >
        <span class="challenges__button-label">{t.revenueTab}</span>
      </button>
      <button
        type="button"
        class="challenges__button"
        data-index="2"
        aria-expanded="false"
        aria-controls="challenge-panel-2"
      >
        <span class="challenges__button-label">{t.launchTab}</span>
      </button>
    </div>
    <div class="challenges__answers">
      <div class="challenges__answer is-active" id="challenge-panel-0">
        <h3>{t.bookingHeading}</h3>
        <p>Client: Monkey Mood</p>
        <h3>{t.challengeLabel}</h3>
        <p class="max-txt-width">
          {t.bookingChallenge}
        </p>
        <h3>Solution</h3>
        <p class="max-txt-width">
          {t.bookingSolution}
        </p>
      </div>
      <div class="challenges__answer" id="challenge-panel-1">
        <h3>{t.revenueHeading}</h3>
        <p>Client: Pacific Coast Cafe</p>
        <h3>{t.challengeLabel}</h3>
        <p class="max-txt-width">
          {t.revenueChallenge}
        </p>
        <h3>Solution</h3>
        <p class="max-txt-width">
          {t.revenueSolution}
        </p>
      </div>
      <div class="challenges__answer" id="challenge-panel-2">
        <h3>{t.launchHeading}</h3>
        <p>Client: Turbulente Kombucha</p>
        <h3>{t.challengeLabel}</h3>
        <p class="max-txt-width">
          {t.launchChallenge}
        </p>
        <h3>Solution</h3>
        <p class="max-txt-width">
          {t.launchSolution}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/landesChallenges.js'
</script>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .challenges {
    padding-top: var(--space-7);
  }

  .challenges__buttons {
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
  }

  .challenges__button {
    border: none;
    padding: var(--space-5);
    background: none;
    text-decoration: none;
    cursor: pointer;
    text-align: left;
    /* 60% is the faintest this gold can go on the navy background and still
       be readable enough for large text (contrast 3.6 to 1; 3 to 1 is the minimum) */
    opacity: 60%;
  }

  .challenges__button.is-active {
    opacity: 100%;
  }

  /* The label is a <span>, not a heading: a <button> may only contain text-level
     elements. It is styled to look like the headings beside it. */
  .challenges__button-label {
    display: block;
    font-weight: 400;
    font-size: var(--title-2);
    line-height: var(--leading-title);
    font-family: var(--sub-heading);
    letter-spacing: 4%;
    color: var(--sub-heading-colour);
    text-transform: uppercase;
  }

  .challenges__answers {
    position: relative;
    display: grid;
    height: 100%;
  }

  .challenges__answer {
    padding: var(--space-6);
    border: 2px dashed rgba(220, 168, 104, 0.3);
    border-radius: var(--corner-rad);
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease visibility 0.4s ease;
    pointer-events: none;
  }

  .challenges__answer.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media screen and (max-width: 767px) {
    .challenges__button {
      padding-left: 0px;
      padding-top: 0px;
      padding-bottom: var(--space-3);
    }
  }

  @media screen and (max-width: 752px) {
    .challenges__answers {
      position: sticky;
      height: auto;
      top: 50%;
      z-index: 2;
    }

    .challenges__answer.is-active {
      background: var(--page-background);
    }
  }
</style>
