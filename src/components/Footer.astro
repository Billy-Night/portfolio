---
import { GITHUB, INSTAGRAM_1, INSTAGRAM_2, LINKEDIN, MAIL } from './icons'
import { routes, type Lang, type RouteKey } from '../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]
// Set when the site is built, so it updates with the first deploy of each year
const year = new Date().getFullYear()

const t = {
  en: {
    heading: 'Create your digital system',
    subheading: 'Billy Nightingale - Web Design & Development in Capbreton',
    contact: 'Contact Information:',
    home: 'Home',
    projects: 'Projects',
    about: 'About',
    rights: 'All rights reserved.',
    terms: 'Terms and Conditions',
    privacy: 'Privacy Policy',
  },
  fr: {
    heading: 'Création de site web et système digital',
    subheading: 'Billy Nightingale - Web Design & Développement à Capbreton',
    contact: 'Contact:',
    home: 'Accueil',
    projects: 'Projets',
    about: 'À Propos',
    rights: 'Tous droits réservés.',
    terms: 'CGV',
    privacy: 'Confidentialité',
  },
}[lang]
---

<footer class="sections" id="footer">
  <div class="footer__container">
    <div class="footer__info-container">
      <h2 class="h3-style">{t.heading}</h2>
      <p class="footer__business">{t.subheading}</p>
      <p class="footer__contact-title">{t.contact}</p>
      <address class="footer__address">
        Capbreton, Landes, 40130, France<br />
        <a href="tel:+33766095864">+33 7 66 09 58 64</a><br />
        <a href="mailto:contact@billynightingale.com">contact@billynightingale.com</a>
      </address>
      <div class="footer__icons">
        <ul>
          <li>
            <a href="https://www.linkedin.com/in/billynightingale/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg
                class="footer__icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 448 512"
                width="30"
                height="30"
              >
                <path d={LINKEDIN}></path>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/billy.nightingale.studio/" target="_blank" rel="noopener" aria-label="instagram">
              <svg
                class="footer__icon"
                xmlns="http://www.w3.org/2000/svg"
                version="1.1"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                width="512"
                height="512"
                x="0"
                y="0"
                viewBox="0 0 511 511.9"
                style="enable-background: new 0 0 512 512"
                xml:space="preserve"
              >
                <g>
                  <path d={INSTAGRAM_1}></path>
                  <path d={INSTAGRAM_2}></path>
                </g>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.github.com/Billy-Night" target="_blank" rel="noopener" aria-label="GitHub">
              <svg class="footer__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                <path d={GITHUB}></path>
              </svg>
            </a>
          </li>
          <li>
            <a href="mailto:contact@billynightingale.com" aria-label="Mail">
              <svg class="footer__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                <path d={MAIL}></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__nav-container">
      <ul class="footer__nav">
        <li><a class="footer__nav-link" href={r('home')}>{t.home}</a></li>
        <li><a class="footer__nav-link" href={`${r('home')}#projects`}>{t.projects}</a></li>
        <li><a class="footer__nav-link" href={r('about')}>{t.about}</a></li>
        <li><a class="footer__nav-link" href={r('contact')}>Contact</a></li>
        <li><a class="footer__nav-link" href={r('services')}>Services</a></li>
        <li>
          <a class="footer__nav-link" href={r('landes')}>Landes</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="footer__legal">
    <p>&copy; {year} Billy Nightingale. {t.rights}</p>
    <a href={r('terms')}>{t.terms}</a>
    <a href={r('privacy')}>{t.privacy}</a>
  </div>
</footer>

<!-- This component's own styles. They apply only to this component's elements. How styles are organised: src/styles/README.md -->
<style>
  .footer__container {
    display: flex;
    flex-direction: row;
  }

  .footer__info-container {
    width: 100%;
  }

  .footer__info-container h2 {
    font-size: var(--title-4);
    margin-bottom: var(--space-3);
  }

  /* The business name and the contact title are paragraphs, not headings:
     only the tagline above them is a heading. */
  .footer__business {
    margin-top: 0px;
    margin-bottom: var(--space-7);
    font-weight: 400;
    font-size: var(--title-6);
    line-height: var(--leading-title);
    font-family: var(--sub-heading);
    letter-spacing: 3%;
    color: var(--sub-heading-colour);
    text-transform: uppercase;
  }

  .footer__contact-title {
    margin-top: 0px;
    margin-bottom: var(--space-3);
    font-weight: 400;
    font-size: var(--text-m);
    line-height: var(--leading-title);
    color: var(--sub-heading-colour);
  }

  .footer__address {
    font-style: normal;
  }

  .footer__address a {
    color: white;
  }

  .footer__address a:hover {
    color: var(--gold);
  }

  .footer__icons ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    flex-flow: row wrap;
    gap: 2rem;
    margin-top: var(--space-5);
  }

  .footer__icon {
    width: 25px;
    height: 25px;
    fill: var(--gold);
  }

  .footer__nav-container {
    display: flex;
    flex-direction: column;
    justify-content: end;
    width: 100%;
    align-items: end;
  }

  .footer__nav {
    list-style: none;
  }

  .footer__nav li {
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }

  .footer__nav-link {
    font-family: var(--mono);
  }

  .footer__legal {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: row;
    /* On a narrow screen the two links move to a line of their own */
    flex-wrap: wrap;
    row-gap: var(--space-2);
    justify-content: center;
    align-items: center;
  }

  .footer__legal a {
    margin: 0;
    margin-left: var(--space-3);
  }

  .footer__legal p {
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .footer__nav-container {
      display: none;
    }

    .footer__legal a {
      text-align: right;
    }
  }
</style>
