---
import { GITHUB, INSTAGRAM_1, INSTAGRAM_2, LINKEDIN, MAIL } from './icons'
import { routes, type Lang, type RouteKey } from '../i18n/routes'

interface Props {
  lang: Lang
  /** Footer <h3>. Pages currently use different wording — defaults are the contact-page versions. */
  heading?: string
  /** Defaults to the homepage projects section */
  projectsHref?: string
  /**
   * Legacy markup: the EN contact page wraps a bare <footer> in
   * <section class="sections" id="footer"> inside <main>. Every other page
   * uses <footer class="sections" id="footer">.
   */
  wrapInSection?: boolean
  /** Pass null to omit the id (the about pages have no id="footer") */
  id?: string | null
}

const { lang, wrapInSection = false, id = 'footer' } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: 'Create your digital system',
    subheading: 'Billy Nightingale - Web Design & Development in Capbreton',
    contact: 'Contact Information:',
    home: 'Home',
    projects: 'Projects',
    about: 'About',
    rights: 'All rights reserved.',
    terms: 'Terms and Conditions',
  },
  fr: {
    heading: 'Création de site web et système digital',
    subheading: 'Billy Nightingale - Web Design & Développement à Capbreton',
    contact: 'Contact:',
    home: 'Accueil',
    projects: 'Projets',
    about: 'À Propos',
    rights: 'Tous droits réservés.',
    terms: 'CGV',
  },
}[lang]

const heading = Astro.props.heading ?? t.heading
const projectsHref = Astro.props.projectsHref ?? `${r('home')}#projects`

const Outer = wrapInSection ? 'section' : 'footer'
const Inner = wrapInSection ? 'footer' : Fragment
---

<Outer class="sections" id={id}>
  <Inner>
    <div class="footer__container">
      <div class="footer__info_container">
        <h3>{heading}</h3>
        <h4>{t.subheading}</h4>
        <h5>{t.contact}</h5>
        <address class="footer__address">
          Capbreton, Landes, 40130, France<br />
          <a href="tel:+33766095864">+33 7 66 09 58 64</a><br />
          <a href="mailto:contact@billynightingale.com">contact@billynightingale.com</a>
        </address>
        <div class="contact-icons-footer-cont">
          <ul>
            <li>
              <a href="https://www.linkedin.com/in/billynightingale/" target="_blank" aria-label="LinkedIn">
                <svg
                  class="social__icons__footer"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 448 512"
                  width="30"
                  height="30"
                >
                  <path d={LINKEDIN}></path>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.instagram.com/billy.nightingale.studio/" target="_blank" aria-label="instagram">
                <svg
                  class="social__icons__footer"
                  xmlns="http://www.w3.org/2000/svg"
                  version="1.1"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                  width="512"
                  height="512"
                  x="0"
                  y="0"
                  viewBox="0 0 511 511.9"
                  style="enable-background: new 0 0 512 512"
                  xml:space="preserve"
                >
                  <g>
                    <path d={INSTAGRAM_1}></path>
                    <path d={INSTAGRAM_2}></path>
                  </g>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.github.com/Billy-Night" target="_blank" aria-label="GitHub">
                <svg class="social__icons__footer" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                  <path d={GITHUB}></path>
                </svg>
              </a>
            </li>
            <li>
              <a href="mailto:contact@billynightingale.com" aria-label="Mail">
                <svg class="social__icons__footer" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                  <path d={MAIL}></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer__nav_container">
        <ul class="footer__nav">
          <li><a class="footer__nav__link" href={r('home')}>{t.home}</a></li>
          <li><a class="footer__nav__link" href={projectsHref}>{t.projects}</a></li>
          <li><a class="footer__nav__link" href={r('about')}>{t.about}</a></li>
          <li><a class="footer__nav__link" href={r('contact')}>Contact</a></li>
          <li><a class="footer__nav__link" href={r('services')}>Services</a></li>
          {
            lang === 'en' ? (
              <li>
                <a class="footer__nav__link" href={r('landes')}>Landes</a>
              </li>
            ) : (
              // TODO(pre-existing bug, kept for 1:1 parity): the href is on the <li>,
              // so this "Landes" link does nothing on every French page.
              <li class="footer__nav__link" {...({ href: r('landes') } as Record<string, string>)}>
                <a>Landes</a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      <p>&copy; 2026 Billy Nightingale. {t.rights}</p>
      <a href={r('terms')}>{t.terms}</a>
    </div>
  </Inner>
</Outer>
