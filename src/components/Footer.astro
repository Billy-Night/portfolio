---
import { GITHUB, INSTAGRAM_1, INSTAGRAM_2, LINKEDIN, MAIL } from './icons'
import { routes, type Lang, type RouteKey } from '../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]
// Set when the site is built, so it updates with the first deploy of each year
const year = new Date().getFullYear()

const t = {
  en: {
    heading: 'Create your digital system',
    subheading: 'Billy Nightingale - Web Design & Development in Capbreton',
    contact: 'Contact Information:',
    home: 'Home',
    projects: 'Projects',
    about: 'About',
    rights: 'All rights reserved.',
    terms: 'Terms and Conditions',
  },
  fr: {
    heading: 'Création de site web et système digital',
    subheading: 'Billy Nightingale - Web Design & Développement à Capbreton',
    contact: 'Contact:',
    home: 'Accueil',
    projects: 'Projets',
    about: 'À Propos',
    rights: 'Tous droits réservés.',
    terms: 'CGV',
  },
}[lang]
---

<footer class="sections" id="footer">
  <div class="footer__container">
    <div class="footer__info_container">
      <h2 class="h3-style">{t.heading}</h2>
      <p class="footer__business">{t.subheading}</p>
      <p class="footer__contact-title">{t.contact}</p>
      <address class="footer__address">
        Capbreton, Landes, 40130, France<br />
        <a href="tel:+33766095864">+33 7 66 09 58 64</a><br />
        <a href="mailto:contact@billynightingale.com">contact@billynightingale.com</a>
      </address>
      <div class="contact-icons-footer-cont">
        <ul>
          <li>
            <a href="https://www.linkedin.com/in/billynightingale/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg
                class="social__icons__footer"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 448 512"
                width="30"
                height="30"
              >
                <path d={LINKEDIN}></path>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/billy.nightingale.studio/" target="_blank" rel="noopener" aria-label="instagram">
              <svg
                class="social__icons__footer"
                xmlns="http://www.w3.org/2000/svg"
                version="1.1"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                width="512"
                height="512"
                x="0"
                y="0"
                viewBox="0 0 511 511.9"
                style="enable-background: new 0 0 512 512"
                xml:space="preserve"
              >
                <g>
                  <path d={INSTAGRAM_1}></path>
                  <path d={INSTAGRAM_2}></path>
                </g>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.github.com/Billy-Night" target="_blank" rel="noopener" aria-label="GitHub">
              <svg class="social__icons__footer" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                <path d={GITHUB}></path>
              </svg>
            </a>
          </li>
          <li>
            <a href="mailto:contact@billynightingale.com" aria-label="Mail">
              <svg class="social__icons__footer" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                <path d={MAIL}></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__nav_container">
      <ul class="footer__nav">
        <li><a class="footer__nav__link" href={r('home')}>{t.home}</a></li>
        <li><a class="footer__nav__link" href={`${r('home')}#projects`}>{t.projects}</a></li>
        <li><a class="footer__nav__link" href={r('about')}>{t.about}</a></li>
        <li><a class="footer__nav__link" href={r('contact')}>Contact</a></li>
        <li><a class="footer__nav__link" href={r('services')}>Services</a></li>
        <li>
          <a class="footer__nav__link" href={r('landes')}>Landes</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="footer__legal">
    <p>&copy; {year} Billy Nightingale. {t.rights}</p>
    <a href={r('terms')}>{t.terms}</a>
  </div>
</footer>
