---
// The timeline with the line that draws itself as the page scrolls: a heading,
// an introduction and four boxes along the line. Used by home/HomeProcess.astro
// (the four phases of a project) and about/AboutJourney.astro (four career
// steps), which supply what goes in each box:
//
//   <Timeline heading="..." intro="..." stepClass="ts-padding-m">
//     <div slot="step-1">...</div>
//     ... step-2, step-3, step-4
//   </Timeline>
//
// The line, the dot and the reveal of each box are driven by src/scripts/timeline.js.
interface Props {
  heading: string
  intro: string
  /** The padding of the four boxes: 'ts-padding-l' or 'ts-padding-m' */
  stepClass: string
  /** An id for the section, when another part of the page links to it */
  id?: string
}

const { heading, intro, stepClass, id } = Astro.props
---

<section class="timeline__section" id={id}>
  <div class="tl__heading-container">
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="tl__container">
    <div class="tl__line-container">
      <svg
        class="tl_svg"
        viewBox="0 0 603 2137"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle class="tl_dot" r="12"></circle>
        <path
          class="tl_line"
          d="M308 0C308 39.7738 275.757 72.0169 235.983 72.0169L141.5 72.0169C64.1801 72.0169 1.5 134.697 1.5 212.017V422.143C1.5 499.463 64.1801 562.143 141.5 562.143H461.5C538.82 562.143 601.5 624.823 601.5 702.143V959.778C601.5 1037.1 538.82 1099.78 461.5 1099.78H141.5C64.1801 1099.78 1.5 1162.46 1.5 1239.78V1459.91C1.5 1537.23 64.1801 1599.91 141.5 1599.91H461.5C538.82 1599.91 601.5 1662.59 601.5 1739.91V1925.52C601.5 2002.84 538.82 2065.52 461.5 2065.52H381.52C342.573 2065.52 311 2097.1 311 2136.04"
          stroke-width="3"
        />
      </svg>
    </div>
    <div class="tl__content-container">
      <div class:list={['time-step', 'time__step-1', 'glass__back', stepClass]}>
        <slot name="step-1" />
      </div>
      <div class:list={['time-step', 'time__step-2', 'glass__back', stepClass]}>
        <slot name="step-2" />
      </div>
      <div class:list={['time-step', 'time__step-3', 'glass__back', stepClass]}>
        <slot name="step-3" />
      </div>
      <div class:list={['time-step', 'time__step-4', 'glass__back', stepClass]}>
        <slot name="step-4" />
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/timeline.js'
</script>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md
     They cover both uses of the timeline, including the classes each page puts inside its boxes. -->
<style is:global>
  .home-process-svg {
    width: var(--text-l);
    min-width: 19px;
    height: auto;
    fill: var(--metal-light);
  }

  .timeline__section {
    max-width: var(--sec-width);
    margin: 0 auto;
    padding: var(--padding-hor-section) var(--page-gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .tl__heading-container {
    text-align: center;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .tl__container {
    position: relative;
    width: 100%;
  }

  .tl__line-container {
    position: absolute;
    width: 100%;
    inset: 0;
    z-index: 0;
  }

  .tl_dot {
    fill: var(--gold);
    stroke-width: 3;
  }

  .tl_svg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .tl_line {
    fill: none;
    stroke: var(--gold);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tl__content-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    z-index: 1;
    row-gap: clamp(var(--space-10), 12vw, 16rem);
    column-gap: clamp(var(--space-6), 6vw, var(--space-10));
    padding-top: clamp(var(--space-8), 8vw, var(--space-11));
    padding-bottom: clamp(var(--space-8), 8vw, var(--space-11));
  }

  .time-step {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ts-padding-l {
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    margin: clamp(var(--space-4), 3vw, var(--space-6));
  }

  .ts-padding-m {
    padding: clamp(var(--space-4), 4vw, var(--space-6));
    margin: clamp(var(--space-2), 3vw, var(--space-4));
  }

  .ts-p-marg p {
    margin: 3px;
  }

  .ts-about-heading {
    width: 80%;
    text-align: center;
  }

  @media screen and (max-width: 700px) {
    .ts-heading {
      width: 100%;
    }
  }

  .hide-ts-h {
    opacity: 0;
  }

  .reveal-text span {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    color: var(--sub-heading-colour);
    animation: reveal 0.6s forwards;
  }

  .reveal-text span:nth-child(1) {
    animation-delay: 0.1s;
  }

  .reveal-text span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .reveal-text span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .reveal-text span:nth-child(4) {
    animation-delay: 0.4s;
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .time__step-1 {
    grid-row: 1;
    grid-column: 1;
  }

  .time__step-2 {
    grid-row: 2;
    grid-column: 2;
  }

  .time__step-3 {
    grid-row: 3;
    grid-column: 1;
  }

  .time__step-4 {
    grid-row: 4;
    grid-column: 2;
  }

  @media screen and (max-width: 700px) {
    .ts-heading {
      width: 100%;
    }
  }

  @media screen and (max-width: 560px) {
    .time__step-1 {
      grid-row: 1;
      grid-column: 1 / 3;
    }

    .time__step-2 {
      grid-row: 2;
      grid-column: 1 / 3;
    }

    .time__step-3 {
      grid-row: 3;
      grid-column: 1 / 3;
    }

    .time__step-4 {
      grid-row: 4;
      grid-column: 1 / 3;
    }

    .ts-padding-m {
      margin: 0px;
    }

    .ts-padding-l {
      margin: 0px;
    }
  }

  /* Reduced motion: the headings appear in place instead of rising. This must
     come after the rules above that start the animation. */
  @media (prefers-reduced-motion: reduce) {
    .reveal-text span {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
