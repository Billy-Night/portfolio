---
// One website package card on the services page. The text comes from
// src/data/pricing.ts; the labels shared by every card are in the table below.
import { routes, type Lang } from '../../i18n/routes'
import type { Package } from '../../data/pricing'
import PackageFeatures from './PackageFeatures.astro'
import PackageIcon from './PackageIcon.astro'

interface Props {
  pkg: Package
  lang: Lang
}

const { pkg, lang } = Astro.props
const large = pkg.highlighted === true

const t = {
  en: {
    priceFrom: "From",
    bestForLabel: "Best for",
    deliveryLabel: "Delivery time",
    callButton: "Book a call",
    pricingButton: "See Pricing",
  },
  fr: {
    priceFrom: "À partir de",
    bestForLabel: "Idéal pour",
    deliveryLabel: "Délai de réalisation",
    callButton: "Réserver un appel découverte",
    pricingButton: "Comparer les offres",
  },
}[lang]
---

<article class="package-card package-card--featured">
  <div class="package-card__top">
    <div>
      <div class="package-card__label">
        <span>{pkg.tagline[lang]}</span>
        <span class="package-card__label-line"></span>
      </div>
      <h3 class:list={['package-card__title', large && 'package-card__title--large']}>{pkg.name[lang]}</h3>
    </div>
    <PackageIcon id={pkg.id} label={pkg.iconLabel?.[lang]} large={large} />
  </div>
  <div class="package-card__divider package-card__divider--short"></div>
  <div class="package-card__label">
    <span>{t.priceFrom} <span class="package-card__price">{pkg.price[lang]}</span></span>
  </div>
  <p class:list={['package-card__description', large && 'package-card__description--large']}>
    {pkg.description[lang]}
  </p>
  <PackageFeatures items={pkg.features[lang]} large={large} />
  <h4>{t.bestForLabel}</h4>
  <p>{pkg.bestFor[lang]}</p>
  <h4>{t.deliveryLabel}</h4>
  <p>{pkg.delivery[lang]}</p>
    <div class="package-card__actions">
      <a class="btn__primary btn__prim--light" href={routes.contact[lang]}>
        {t.callButton} <span aria-hidden="true">→</span>
      </a>
      <a class="btn__third" href="#pricing-table">
        {t.pricingButton}
        <span class="price-btn-arrow" aria-hidden="true"
          ><svg
            width="15"
            height="15"
            viewBox="0 0 21 15"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M20.7071 8.07088C21.0976 7.68035 21.0976 7.04719 20.7071 6.65666L14.3431 0.292702C13.9526 -0.0978227 13.3195 -0.0978227 12.9289 0.292702C12.5384 0.683226 12.5384 1.31639 12.9289 1.70692L18.5858 7.36377L12.9289 13.0206C12.5384 13.4111 12.5384 14.0443 12.9289 14.4348C13.3195 14.8254 13.9526 14.8254 14.3431 14.4348L20.7071 8.07088ZM0 7.36377V8.36377H20V7.36377V6.36377H0V7.36377Z"
              fill="white"
            />
          </svg>
        </span>
      </a>
    </div>
  {large && <div class="package-card__pattern" aria-hidden="true" />}
</article>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--gold);
    border-radius: var(--corner-rad);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.025), transparent 35%),
      var(--page-background);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.12);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .package-card:hover {
    transform: translateY(-4px);
    border-color: rgba(221, 168, 95, 0.75);
    background-color: var(--navy-card-hover);
  }

  .package-card--featured {
    padding: var(--gap-md);
  }

  .package-card__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-md);
  }

  .package-card__label {
    display: flex;
    align-items: center;
    font-family: var(--mono);
    gap: var(--gap-sm);
    margin-bottom: var(--gap-sm);
  }

  .package-card__label-line {
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--gold);
  }

  .package-card__title {
    margin: 0;
    line-height: 0.95;
  }

  .package-card__title {
    font-size: var(--title-3);
  }

  .package-card__title--large {
    max-width: 10ch;
    font-size: var(--title-1);
  }

  .package-card__divider {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 1px;
    margin: var(--gap-sm) 0;
    background: var(--divider-gradient);
  }

  .package-card__price {
    font-size: var(--title-3);
    font-family: var(--display);
    color: var(--gold);
  }

  .package-card__description {
    position: relative;
    z-index: 1;
    max-width: 39rem;
    margin: 0 0 var(--gap-sm);
    color: var(--body-colour);
  }

  .package-card__description--large {
    margin-top: 0;
  }

  .package-card__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm);
    margin-top: auto;
    padding-top: var(--gap-sm);
  }

  .price-btn-arrow {
    display: flex;
    align-items: center;
  }

  .package-card__pattern {
    position: absolute;
    right: -4rem;
    bottom: -5rem;
    width: 22rem;
    aspect-ratio: 1;
    border: 1px solid rgba(221, 168, 95, 0.07);
    border-radius: 42% 58% 55% 45%;
    opacity: 0.6;
    transform: rotate(20deg);
  }

  .package-card__pattern::before,
  .package-card__pattern::after {
    position: absolute;
    inset: 2rem;
    content: '';
    border: inherit;
    border-radius: inherit;
  }

  .package-card__pattern::after {
    inset: 4rem;
  }

  /* Above 800px the parts of a card sit 1rem apart. This spacing used to arrive
     by accident, from a rule written for the homepage project cards that applied
     to every <article>. That rule is now scoped, so the spacing is stated here. */
  @media (min-width: 800px) {
    .package-card {
      gap: 1rem;
    }
  }

  @media (max-width: 1181px) {
    .package-card--featured {
      min-height: auto;
    }
  }

  @media (max-width: 680px) {
    .package-card--featured {
      min-height: auto;
      padding: 1.5rem;
    }

    .package-card__top {
      gap: 1rem;
    }

    .package-card__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .package-card {
      transition: none;
    }

    .package-card:hover {
      transform: none;
    }
  }
</style>
