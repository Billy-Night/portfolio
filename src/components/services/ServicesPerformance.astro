---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Built for performance & Longevity",
    performanceIconAlt: "icon indicating improving web performance",
    performanceHeading: "Performance & Accessibility",
    performanceText1: "I ensure all my clients sites are performance tested before and after deployment, to ensure the best service.",
    performanceText2: "All my sites are built to industry standard and meet all accessibility requirements.",
    hostingIconAlt: "icon tech stack",
    hostingHeading: "Maintenance & Hosting",
    hostingText1: "I offer care packages for all my sites, keep them updated and my clients stress free.",
    hostingText2: "Providing fast and reliable hosting for all my custom built sites.",
  },
  fr: {
    heading: "Conçu pour la performance et la durabilité",
    performanceIconAlt: "qui indique une amélioration des performances du site web",
    performanceHeading: "Performance et accessibilité",
    performanceText1: "Je m’assure que tous les sites de mes clients sont testés en matière de performance avant et après la mise en ligne, afin de garantir un service de qualité.",
    performanceText2: "Tous mes sites sont développés selon les standards du secteur et respectent les exigences en matière d’accessibilité.",
    hostingIconAlt: "icon qui indique le tech stack",
    hostingHeading: "Maintenance & Hébergement",
    hostingText1: "Je propose des formules de maintenance pour tous mes sites, afin de les maintenir à jour et d’offrir à mes clients une totale tranquillité d’esprit.",
    hostingText2: "Je propose un hébergement rapide et fiable pour tous les sites que je développe sur mesure.",
  },
}[lang]
---

<section
  class="sections sec-service-addons"
  id="services-page__sec-service-addons"
>
  <h2 class="section-sub-headings">{t.heading}</h2>
  <div class="sec-service-addons-content-container">
    <div class="addons-content-container">
      <div class="addons-performance-img-frame">
        <img
          src="/assets/icons/performance_arrow.svg"
          alt={t.performanceIconAlt}
        />
      </div>
      <div class="addons-performance-text-container">
        <h2>{t.performanceHeading}</h2>
        <p>
          {t.performanceText1}
        </p>
        <p>
          {t.performanceText2}
        </p>
      </div>
    </div>
    <div class="addons-content-container">
      <div class="addons-performance-img-frame">
        <img
          alt={t.hostingIconAlt}
          src="/assets/icons/tech_stack_icon.svg"
        />
      </div>
      <div class="addons-performance-text-container">
        <h2>{t.hostingHeading}</h2>
        <p>
          {t.hostingText1}
        </p>
        <p>
          {t.hostingText2}
        </p>
      </div>
    </div>
  </div>
</section>
