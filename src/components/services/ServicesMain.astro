---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Main Services",
    subheading: "Are you ready to build your dream digital experience ?",
    designText: "Thoughtful, user-focused design that reflects your brand and makes it easy for visitors to take action.",
    developmentHeading: "Web Development",
    developmentText: "Clean, fast, and reliable websites built to scale, maintain, and perform long-term.",
    seoText: "Solid technical and on-page foundations so your site can be found by the right people.",
  },
  fr: {
    heading: "Services principaux",
    subheading: "Prêt à créer une expérience digitale à la hauteur de vos ambitions ?",
    designText: "Un design réfléchi et centré sur l’utilisateur, qui reflète votre marque et facilite le passage à l’action.",
    developmentHeading: "Développement Web",
    developmentText: "Des sites web propres, rapides et fiables, conçus pour évoluer, être maintenus facilement et offrir des performances durables.",
    seoText: "Des bases techniques et éditoriales solides pour que votre site soit visible auprès des bonnes personnes.",
  },
}[lang]
---

<section
  class="sections sec-services-main"
  id="services-page__main-services"
>
  <div class="services-main-title">
    <h2 class="section-sub-headings">{t.heading}</h2>
    <h3>{t.subheading}</h3>
  </div>
  <div class="services-main-blocks">
    <div class="service-card">
      <h2>Web Design</h2>
      <p class="max-txt-width">
        {t.designText}
      </p>
    </div>
    <div class="service-card">
      <h2>{t.developmentHeading}</h2>
      <p class="max-txt-width">
        {t.developmentText}
      </p>
    </div>
    <div class="service-card">
      <h2>SEO</h2>
      {/* The French page limits this paragraph's width; the English page does not */}
      <p class={lang === 'fr' ? 'max-txt-width' : undefined}>
        {t.seoText}
      </p>
    </div>
  </div>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  .services-main-title {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .services-main-title h3 {
    font-family: var(--sans);
    font-size: var(--title-6);
    color: var(--body-colour);
    text-transform: none;
  }

  .services-main-blocks {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-7) 5%;
  }

  .service-card:nth-child(1) {
    grid-column: span 12;
    height: 350px;
  }

  .service-card:nth-child(2) {
    grid-column: span 8;
    height: 350px;
  }

  .service-card:nth-child(3) {
    grid-column: span 4;
    height: 350px;
  }

  .service-card {
    position: relative;
    transition: var(--transition-lift);
    height: 350px;
    background-color: var(--glass-bg-light);
    border: var(--glass-border);
    border-radius: var(--corner-rad);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 var(--space-6) 0 var(--space-6);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05),
      transparent 50%
    );
    pointer-events: none;
  }

  @media screen and (max-width: 700px) {
    .services-main-blocks {
      gap: var(--space-6) 5%;
    }
    .service-card:nth-child(1) {
      grid-column: span 12;
      height: 300px;
    }

    .service-card:nth-child(2) {
      grid-column: span 7;
      height: 300px;
    }

    .service-card:nth-child(3) {
      grid-column: span 5;
      height: 300px;
    }
  }

  @media screen and (max-width: 520px) {
    .services-main-blocks {
      gap: var(--space-5) 5%;
    }
    .service-card:nth-child(1) {
      grid-column: span 12;
      height: 300px;
    }

    .service-card:nth-child(2) {
      grid-column: span 12;
      height: 300px;
    }

    .service-card:nth-child(3) {
      grid-column: span 12;
      height: 300px;
    }
  }
</style>
