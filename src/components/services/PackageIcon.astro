---
// The icon on a package card: two squares for the starter package, three
// diamonds for the business package, three circles for the growth package.
// The animations are in the style block at the end of this file (.package-card__icon).
import type { Package } from '../../data/pricing'

interface Props {
  id: Package['id']
  /** Read out by screen readers in place of the icon */
  label?: string
  /** The larger icon on the highlighted card */
  large?: boolean
}

const { id, label, large = false } = Astro.props
---

<div class:list={['package-card__icon', large && 'package-card__icon--large']} aria-hidden="true">
  {id === 'starter' && (
    <svg viewBox="0 0 64 64">
      <rect x="14" y="20" width="28" height="28" />
      <rect x="24" y="10" width="28" height="28" />
    </svg>
  )}
  {id === 'business' && (
    <svg
      viewBox="-10 -10 120 120"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={label}
    >
      <g
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      >
        <rect
          x="30"
          y="30"
          width="40"
          height="40"
          transform="rotate(45 50 50)"
        />
        <rect
          x="20"
          y="20"
          width="60"
          height="60"
          transform="rotate(45 50 50)"
        />
        <rect
          x="10"
          y="10"
          width="80"
          height="80"
          transform="rotate(45 50 50)"
        />
      </g>
    </svg>
  )}
  {id === 'growth' && (
    <svg
      viewBox="-7 -7 114 114"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={label}
    >
      <g
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      >
        <circle cx="40" cy="50" r="20" />
        <circle cx="50" cy="50" r="30" />
        <circle cx="60" cy="50" r="40" />
      </g>
    </svg>
  )}
</div>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .package-card__icon {
    flex: 0 0 auto;
    width: 3.5rem;
    color: var(--gold);
  }

  .package-card__icon :global(svg) {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .package-card__icon :global(rect) {
    transform-box: view-box;
    transform-origin: center;
  }

  /* Inner rectangle — clockwise */
  .package-card__icon :global(rect:nth-child(1)) {
    animation: rotate-clockwise 14s linear infinite;
  }

  /* Middle rectangle — anti-clockwise */
  .package-card__icon :global(rect:nth-child(2)) {
    animation: rotate-anticlockwise 20s linear infinite;
  }

  /* Outer rectangle — clockwise */
  .package-card__icon :global(rect:nth-child(3)) {
    animation: rotate-clockwise 28s linear infinite;
  }

  .package-card__icon :global(circle) {
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform;
  }

  /* Small inner lens */
  .package-card__icon :global(circle:nth-child(1)) {
    animation: telescope-inner 6s ease-in-out infinite;
  }

  /* Middle lens */
  .package-card__icon :global(circle:nth-child(2)) {
    animation: telescope-middle 6s ease-in-out infinite;
  }

  /* Outer lens */
  .package-card__icon :global(circle:nth-child(3)) {
    animation: telescope-outer 6s ease-in-out infinite;
  }

  @keyframes rotate-clockwise {
    from {
      transform: rotate(45deg);
    }

    to {
      transform: rotate(405deg);
    }
  }

  @keyframes rotate-anticlockwise {
    from {
      transform: rotate(45deg);
    }

    to {
      transform: rotate(-315deg);
    }
  }

  @keyframes telescope-inner {
    0%,
    100% {
      transform: translateX(0) scale(1);
    }

    50% {
      transform: translateX(-2px) scale(0.94);
    }
  }

  @keyframes telescope-middle {
    0%,
    100% {
      transform: translateX(0) scale(1);
    }

    50% {
      transform: translateX(2px) scale(1.02);
    }
  }

  @keyframes telescope-outer {
    0%,
    100% {
      transform: translateX(0) scale(1);
    }

    50% {
      transform: translateX(7px) scale(1.06);
    }
  }

  .package-card__icon--large {
    width: clamp(5rem, 9vw, 8rem);
  }

  @media (max-width: 680px) {
    .package-card__icon {
      width: 2.75rem;
    }

    .package-card__icon--large {
      width: 4rem;
    }
  }

  /* :nth-child(n) matches every circle. It is there to give this rule the same
     weight as the :nth-child(1) rules above, which a plain "circle" lost to. */
  @media (prefers-reduced-motion: reduce) {
    .package-card__icon :global(circle:nth-child(n)) {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .package-card__icon :global(rect:nth-child(n)) {
      animation: none;
      transform: rotate(45deg);
    }
  }
</style>
