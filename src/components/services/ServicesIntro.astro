---
// Shared by the English and French pages. Text that differs is in the table below.
import { routes, type Lang, type RouteKey } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const r = (key: RouteKey) => routes[key][lang]

const t = {
  en: {
    heading: "Web design, development & SEO for growing businesses",
    subheading: "I help businesses build fast, modern websites that attract clients and support long-term growth.",
    ctaLink: "[ START A PROJECT ]",
  },
  fr: {
    heading: "Web Design, et SEO pour les entreprises",
    subheading: "J’accompagne les entreprises dans la création de sites web modernes et rapides, conçus pour attirer des clients et soutenir une croissance durable.",
    ctaLink: "[ COMMENCER UN PROJECT ]",
  },
}[lang]
---

<section class="services-intro-section">
  <div class="services__hero-text">
    <h1>{t.heading}</h1>
    <div class="services__hero-sub-heading">
      <h2 class="max-txt-width">
        {t.subheading}
      </h2>
    </div>
  </div>
  <div class="services__hero-link">
    <a class="hero__contact-link" href={r('contact')}>{t.ctaLink}</a>
  </div>
</section>

<!-- This component's own styles. is:global keeps the rules unscoped, so they behave
     exactly as they did in the shared stylesheet. Shared classes used here are in src/styles/. -->
<style is:global>
  .services-intro-section {
    padding: var(--padding-hor-section) var(--page-gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lx);
  }

  .services__hero-text {
    max-width: var(--sec-width-lg);
    margin: auto var(--page-gutter);
    text-align: center;
  }

  .services__hero-text h1 {
    font-size: var(--title-hero-xl);
    font-family: var(--display);
    color: var(--brightGold);
    margin-bottom: var(--space-5);
    text-transform: uppercase;
  }

  .services__hero-sub-heading {
    margin-right: auto;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .services__hero-sub-heading h2 {
    font-family: var(--sans);
    font-size: var(--title-6);
    color: var(--body-colour);
    text-transform: none;
  }

  .services__hero-link {
    margin-top: auto;
    margin-right: auto;
    margin-left: auto;
    margin-bottom: 62px;
  }
</style>
