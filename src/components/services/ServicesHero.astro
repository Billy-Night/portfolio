---
// Shared by the English and French pages. Text that differs is in the table below.
import Photo from '../Photo.astro'
import imgPortraitSittingWorkingV2 from '../../assets/images/portraits/portrait_sitting_working_v2.webp'
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    designLink: "Web design",
    developmentLink: "Web Development",
    projectManagementLink: "Project Management",
    imageAlt: "Billy Nightingale sitting at his MacBook working on web design",
  },
  fr: {
    designLink: "Web Design",
    developmentLink: "Web Développement",
    projectManagementLink: "Gestion projet",
    imageAlt: "Billy Nightingale travaille sur le web design et développement à Capbreton",
  },
}[lang]
---

<section class="services-hero-section">
  <div class="services-intro-container">
    <div class="services-intro-img-frame">
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace={t.designLink}
          ><span>{t.designLink}</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace={t.developmentLink}
          ><span>{t.developmentLink}</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace="SEO"
          ><span>SEO</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__sec-service-addons"
          class="paint-text flip-text"
          data-replace="Performance"
          ><span>Performance</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services__page-sec-project-management"
          class="paint-text flip-text"
          data-replace={t.projectManagementLink}
          ><span>{t.projectManagementLink}</span></a
        >
      </p>
      <Photo
        src={imgPortraitSittingWorkingV2}
        alt={t.imageAlt}
        loading="eager"
      />
    </div>
  </div>
</section>

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  .services-hero-section {
    max-width: var(--sec-width-lg);
    margin: 0 auto;
    margin-top: var(--space-2);
    padding-top: var(--padding-hor-section);
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  .services-intro-img-frame {
    padding: var(--space-4);
    min-height: 320px;
    width: 100%;
    background-color: var(--light-container);
    border-radius: var(--corner-rad);
    position: relative;
    margin-top: clamp(3rem, 9.6vw, 16rem);
    -webkit-backdrop-filter: var(--glass-blur-rich);
    backdrop-filter: var(--glass-blur-rich);
  }

  .services-intro-img-frame :global(img) {
    width: clamp(300px, 40vw, 450px);
    height: auto;
    position: absolute;
    bottom: 0;
    left: 70%;
    transform: translate(-50%, 9.6%);
    z-index: 1;
  }

  .services-intro-word {
    width: fit-content;
    margin-bottom: 0px;
  }

  .flip-text {
    overflow: hidden;
    position: relative;
    display: inline-block;
    cursor: pointer;
    color: var(--font-colour-dark);
  }

  .flip-text:hover,
  .flip-text:focus-visible {
    color: var(--font-colour-dark);
  }

  .flip-text::before,
  .flip-text::after {
    position: absolute;
    left: 0;
    width: 100%;
  }

  .flip-text::before {
    content: '';
    bottom: 0;
    height: 2px;
    background-color: var(--font-colour-dark);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .flip-text::after {
    content: attr(data-replace);
    top: 0;
    height: 100%;
    color: var(--font-colour-dark);
    transform: translate3d(100%, 0, 0);
    transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .flip-text:hover::before,
  .flip-text:focus-visible::before {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  .flip-text:hover::after,
  .flip-text:focus-visible::after {
    transform: translate3d(0, 0, 0);
  }

  .flip-text :global(span) {
    display: inline-block;
    transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .flip-text:hover :global(span),
  .flip-text:focus-visible :global(span) {
    transform: translate3d(-100%, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-text::before,
    .flip-text::after,
    .flip-text :global(span) {
      transition: none;
    }
  }

  @media screen and (max-width: 670px) {
    .services-intro-word {
      display: none;
    }

    .services-intro-img-frame :global(img) {
      left: 50%;
    }
  }
</style>
