---
// Shared by the English and French pages. Text that differs is in the table below.
import Photo from '../Photo.astro'
import imgPortraitSittingWorkingV2 from '../../assets/images/portraits/portrait_sitting_working_v2.webp'
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    designLink: "Web design",
    developmentLink: "Web Development",
    projectManagementLink: "Project Management",
    imageAlt: "Billy Nightingale sitting at his MacBook working on web design",
  },
  fr: {
    designLink: "Web Design",
    developmentLink: "Web Développement",
    projectManagementLink: "Gestion projet",
    imageAlt: "Billy Nightingale travaille sur le web design et développement à Capbreton",
  },
}[lang]
---

<section class="services-hero-section">
  <div class="services-intro-container">
    <div class="services-intro-img-frame">
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace={t.designLink}
          ><span>{t.designLink}</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace={t.developmentLink}
          ><span>{t.developmentLink}</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__main-services"
          class="paint-text flip-text"
          data-replace="SEO"
          ><span>SEO</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services-page__sec-service-addons"
          class="paint-text flip-text"
          data-replace="Performance"
          ><span>Performance</span></a
        >
      </p>
      <p class="services-intro-word h2-style">
        <a
          href="#services__page-sec-project-management"
          class="paint-text flip-text"
          data-replace={t.projectManagementLink}
          ><span>{t.projectManagementLink}</span></a
        >
      </p>
      <Photo
        src={imgPortraitSittingWorkingV2}
        alt={t.imageAlt}
        loading="eager"
      />
    </div>
  </div>
</section>
