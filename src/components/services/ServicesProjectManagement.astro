---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    heading: "Project Management",
    discoveryHeading: "Discovery & Goals",
    designHeading: "Design & Structure",
    developmentHeading: "Development & Testing",
    launchHeading: "Launch & Support",
    intro: "A clear, collaborative process from first call to launch.",
  },
  fr: {
    heading: "Gestion de projet",
    discoveryHeading: "Découverte et objectifs",
    designHeading: "Design et structure",
    developmentHeading: "Développement et tests",
    launchHeading: "Mise en ligne et support",
    intro: "Un processus clair et collaboratif, du premier échange à la mise en ligne.",
  },
}[lang]
---

<section
  class="sections sec-project-management"
  id="services__page-sec-project-management"
>
  <h2 class="section-sub-headings">{t.heading}</h2>
  <div class="project-management-container">
    <div class="task-card"><h3>{t.discoveryHeading}</h3></div>
    <div class="task-card"><h3>{t.designHeading}</h3></div>
    <div class="task-card"><h3>{t.developmentHeading}</h3></div>
    <div class="task-card"><h3>{t.launchHeading}</h3></div>
  </div>
  <p class="project-management-hook">
    {t.intro}
  </p>
</section>

<!-- This component's own styles. is:global keeps the rules unscoped, so they behave
     exactly as they did in the shared stylesheet. Shared classes used here are in src/styles/. -->
<style is:global>
  .project-management-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-7);
  }

  .task-card {
    position: relative;
    transition: var(--transition-lift);
    height: 200px;
    background-color: var(--glass-bg-light);
    border: var(--glass-border);
    border-radius: var(--corner-rad);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 var(--space-8) 0 var(--space-8);
  }

  .task-card h3 {
    font-size: var(--text-l);
  }

  .task-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .task-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05),
      transparent 50%
    );
    pointer-events: none;
  }

  .project-management-hook {
    margin-top: var(--space-6);
    text-align: center;
  }

  @media screen and (max-width: 1100px) {
    .project-management-container {
      gap: var(--space-5);
    }
  }

  @media screen and (max-width: 995px) {
    .project-management-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-7);
    }
  }

  @media screen and (max-width: 650px) {
    .project-management-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }

    .task-card {
      height: 150px;
      width: auto;
      padding: 0 var(--space-6) 0 var(--space-6);
    }
  }

  @media screen and (max-width: 350px) {
    .project-management-container {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>
