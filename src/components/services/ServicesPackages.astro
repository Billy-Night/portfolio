---
// Shared by the English and French pages. Text that differs is in the table below.
import type { Lang } from '../../i18n/routes'
import { packages, pricingRows } from '../../data/pricing'
import PackageCard from './PackageCard.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = {
  en: {
    eyebrow: "Website packages",
    headingLine1: "Three paths. One purpose.",
    headingLine2: "Your online growth.",
    intro: "Choose the website package that meets you where you are and gives you the foundation to grow with confidence.",
    benefitsLabel: "Package benefits",
    benefitPerformance: "Built for performance",
    benefitMobile: "Mobile optimised",
    benefitGrowth: "Ready to grow",
    pricingHeading: "Pricing",
    pricingNote1: "Every project includes 2 - 3 rounds of revisions and, depending on the package selected, ongoing support, maintenance and training.",
    pricingNote2: "Projects are custom built and to your requirements, so prices vary",
  },
  fr: {
    eyebrow: "Offres de création de site internet",
    headingLine1: "Trois offres. Un seul objectif.",
    headingLine2: "Développer votre activité en ligne.",
    intro: "Choisissez l’offre adaptée à votre entreprise et construisons un site internet sur mesure pour renforcer votre visibilité, attirer de nouveaux clients et accompagner votre croissance.",
    benefitsLabel: "Avantages inclus dans les offres",
    benefitPerformance: "Conçu pour la performance",
    benefitMobile: "Optimisé pour mobile",
    benefitGrowth: "Prêt à évoluer",
    pricingHeading: "Tarifs de création de site internet",
    pricingNote1: "Chaque projet inclut 2 à 3 séries de modifications et, selon l’offre choisie, un accompagnement continu, la maintenance et une formation.",
    pricingNote2: "Chaque projet est conçu sur mesure selon vos objectifs et vos besoins : les tarifs peuvent donc varier.",
  },
}[lang]
---

<section class="sections-large packages" aria-labelledby="packages-title">
  <div class="packages__container">
    <div class="packages__header">
      <div class="packages__heading">
        <p class="packages__eyebrow">{t.eyebrow}</p>
        <h2 id="packages-title" class:list={[lang === 'en' && "packages__title", lang === 'fr' && "packages__title_fr"]}>
          {t.headingLine1}<br />
          {t.headingLine2}
        </h2>
      </div>
      <p class="packages__intro">
        {t.intro}
      </p>
    </div>
    <div class="packages__grid">
      {packages.map((pkg) => <PackageCard pkg={pkg} lang={lang} />)}
    </div>
    <div class="packages__benefits" aria-label={t.benefitsLabel}>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M24 4 40 10v12c0 10-6 18-16 22C14 40 8 32 8 22V10Z" />
          <path d="m17 24 5 5 10-11" />
        </svg>
        <span>{t.benefitPerformance}</span>
      </div>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <rect x="6" y="8" width="24" height="32" rx="2" />
          <rect x="34" y="17" width="8" height="15" rx="1" />
          <path d="M14 34h8" />
        </svg>
        <span>{t.benefitMobile}</span>
      </div>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <rect x="7" y="30" width="7" height="11" />
          <rect x="20" y="22" width="7" height="19" />
          <rect x="33" y="12" width="7" height="29" />
        </svg>
        <span>{t.benefitGrowth}</span>
      </div>
    </div>
  </div>

  <section class="pricing-section" aria-labelledby="pricing-title">
    <h2 class="section-sub-headings" id="pricing-title">{t.pricingHeading}</h2>
    <div class="pricing-container" id="pricing-table">
      {
        pricingRows.map((row) => (
          <div class="pricing-card">
            <h3>{row.name[lang]}</h3>
            <p>{row.range[lang]}</p>
          </div>
        ))
      }
    </div>
    <p class="pricing-hook">
      {t.pricingNote1}
    </p>
    <p class="pricing-hook">
      {t.pricingNote2}
    </p>
  </section>
</section>

<!-- This component's own styles, unscoped. How styles are organised: src/styles/README.md -->
<style is:global>
  /* The section itself */
  .packages {
    position: relative;
    overflow: hidden;
    padding: var(--padding-hor-section) var(--page-gutter);
  }

  .packages__container {
    width: min(100%, 2200px);
    margin-inline: auto;
    margin-bottom: var(--padding-hor-section);
  }

  .packages__header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
    gap: var(--gap-lg);
    margin-bottom: var(--gap-lg);
  }

  .packages__eyebrow {
    margin: 0 0 1.25rem;
    color: var(--body-colour);
    text-transform: uppercase;
  }

  .packages__title {
    margin: 0;
    line-height: 0.95;
  }

  .packages__title {
    max-width: 15ch;
    font-size: var(--fs-hero-xl);
  }

  .packages__title_fr {
    max-width: 30ch;
    font-size: var(--fs-hero-xl);
  }

  .packages__intro {
    margin: 0 0 0.5rem;
    color: var(--body-colour);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    grid-column: 3 / 4;
  }

  .packages__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--gap-md);
  }

  .packages__benefits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 0;
    padding-top: 1.5rem;
  }

  .benefit svg {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .benefit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 2rem;
    font-size: 0.85rem;
  }

  .benefit:first-child {
    padding-left: 0;
  }

  .benefit + .benefit {
    border-left: 1px solid var(--gold);
  }

  .benefit svg {
    width: 1.8rem;
    color: var(--gold);
  }

  .pricing-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 2px solid white;
    border-radius: var(--corner-rad);
    box-shadow: var(--glass-shadow);
  }

  .pricing-card {
    padding: var(--gap-md) 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .pricing-card h3 {
    font-size: var(--title-5);
    text-align: center;
  }

  .pricing-hook {
    text-align: center;
    margin-top: var(--space-6);
  }

  @media screen and (max-width: 560px) {
    .pricing-container {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media (max-width: 1181px) {
    .packages__header,
      .packages__grid {
        grid-template-columns: 1fr;
      }

    .packages__header {
        align-items: start;
        gap: 1.5rem;
      }

    .packages__intro {
        max-width: 42rem;
        grid-column: 1 / 2;
      }
  }

  @media (max-width: 680px) {
    .benefit {
        width: 100%;
        padding: 0;
      }

    .benefit + .benefit {
        border-left: 0;
      }
  }
</style>
