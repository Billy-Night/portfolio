---

<section class="sections-large packages" aria-labelledby="packages-title">
  <div class="packages__container">
    <div class="packages__header">
      <div class="packages__heading">
        <p class="packages__eyebrow">{t.websitePackages}</p>
        <h2 id="packages-title" class:list={[lang === 'en' && "packages__title", lang === 'fr' && "packages__title_fr"]}>
          {t.threePathsOnePurpose}<br />
          {t.yourOnlineGrowth}
        </h2>
      </div>
      <p class="packages__intro">
        {t.chooseTheWebsitePackage}
      </p>
    </div>
    <div class="packages__grid">
      {/* Starter package */}
      <article class="package-card package-card--featured">
        <div class="package-card__top">
          <div>
            <div class="package-card__label">
              <span>{t.startYourPresence}</span>
              <span class="package-card__label-line"></span>
            </div>
            <h3 class="package-card__title">{t.starterWebsite}</h3>
          </div>
          <div class="package-card__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <rect x="14" y="20" width="28" height="28" />
              <rect x="24" y="10" width="28" height="28" />
            </svg>
          </div>
        </div>
        <div
          class="package-card__divider package-card__divider--short"
        ></div>
        <div class="package-card__label">
          <span>{t.from} <span class="package-card__price">{t.n700}</span></span>
        </div>
        <p class="package-card__description">
          {t.aProfessionalOnePage}
        </p>
        <PackageFeatures items={t.starterFeatures} />
        <h4>{t.bestFor}</h4>
        <p>{t.newBusinessesThatNeed}</p>
        <h4>{t.deliveryTime}</h4>
        <p>{t.n12Weeks}</p>
        <div class="package-card__actions">
          <a class="btn__primary btn__prim--light" href={r('contact')}>
            {t.bookACall} <span aria-hidden="true">→</span>
          </a>
          <a class="btn__third" href="#pricing-table">
            {t.seePricing}
            <span class="price-btn-arrow" aria-hidden="true"
              ><svg
                width="15"
                height="15"
                viewBox="0 0 21 15"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20.7071 8.07088C21.0976 7.68035 21.0976 7.04719 20.7071 6.65666L14.3431 0.292702C13.9526 -0.0978227 13.3195 -0.0978227 12.9289 0.292702C12.5384 0.683226 12.5384 1.31639 12.9289 1.70692L18.5858 7.36377L12.9289 13.0206C12.5384 13.4111 12.5384 14.0443 12.9289 14.4348C13.3195 14.8254 13.9526 14.8254 14.3431 14.4348L20.7071 8.07088ZM0 7.36377V8.36377H20V7.36377V6.36377H0V7.36377Z"
                  fill="white"
                />
              </svg>
            </span>
          </a>
        </div>
      </article>
      {/* Business package */}
      <article class="package-card package-card--featured">
        <div class="package-card__top">
          <div>
            <div class="package-card__label">
              <span>{t.recommendedForMostEstablished}</span>
              <span class="package-card__label-line"></span>
            </div>
            <h3 class="package-card__title package-card__title--large">
              {t.businessWebsite}
            </h3>
          </div>
          <div
            class="package-card__icon package-card__icon--large"
            aria-hidden="true"
          >
            <svg
              viewBox="-10 -10 120 120"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label={t.arialabelThreeConcentricDiamonds}
            >
              <g
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                vector-effect="non-scaling-stroke"
              >
                <rect
                  x="30"
                  y="30"
                  width="40"
                  height="40"
                  transform="rotate(45 50 50)"
                />
                <rect
                  x="20"
                  y="20"
                  width="60"
                  height="60"
                  transform="rotate(45 50 50)"
                />
                <rect
                  x="10"
                  y="10"
                  width="80"
                  height="80"
                  transform="rotate(45 50 50)"
                />
              </g>
            </svg>
          </div>
        </div>
        <div
          class="package-card__divider package-card__divider--short"
        ></div>
        <div class="package-card__label">
          <span
            >{t.from} <span class="package-card__price">{t.n1500}</span></span
          >
        </div>
        <p
          class="package-card__description package-card__description--large"
        >
          {t.aCompleteCustomWebsite}
        </p>
        <PackageFeatures items={t.businessFeatures} large />
        <h4>{t.bestFor}</h4>
        <p>
          {t.establishedBusinessesLookingTo}
        </p>
        <h4>{t.deliveryTime}</h4>
        <p>{t.n23Weeks}</p>
        <div class="package-card__actions">
          <a class="btn__primary btn__prim--light" href={r('contact')}>
            {t.bookACall} <span aria-hidden="true">→</span>
          </a>
          <a class="btn__third" href="#pricing-table">
            {t.seePricing}
            <span class="price-btn-arrow" aria-hidden="true"
              ><svg
                width="15"
                height="15"
                viewBox="0 0 21 15"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20.7071 8.07088C21.0976 7.68035 21.0976 7.04719 20.7071 6.65666L14.3431 0.292702C13.9526 -0.0978227 13.3195 -0.0978227 12.9289 0.292702C12.5384 0.683226 12.5384 1.31639 12.9289 1.70692L18.5858 7.36377L12.9289 13.0206C12.5384 13.4111 12.5384 14.0443 12.9289 14.4348C13.3195 14.8254 13.9526 14.8254 14.3431 14.4348L20.7071 8.07088ZM0 7.36377V8.36377H20V7.36377V6.36377H0V7.36377Z"
                  fill="white"
                />
              </svg>
            </span>
          </a>
        </div>
        <div class="package-card__pattern" aria-hidden="true"></div>
      </article>
      {/* Growth package */}
      <article class="package-card package-card--featured">
        <div class="package-card__top">
          <div>
            <div class="package-card__label">
              <span>{t.scaleAndAutomate}</span>
              <span class="package-card__label-line"></span>
            </div>
            <h3 class="package-card__title">{t.growthWebsite}</h3>
          </div>
          <div
            class="package-card__icon package-card__icon"
            aria-hidden="true"
          >
            <svg
              viewBox="-7 -7 114 114"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label={t.arialabelThreeConcentricCircles}
            >
              <g
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                vector-effect="non-scaling-stroke"
              >
                <circle cx="40" cy="50" r="20" />
                <circle cx="50" cy="50" r="30" />
                <circle cx="60" cy="50" r="40" />
              </g>
            </svg>
          </div>
        </div>
        <div
          class="package-card__divider package-card__divider--short"
        ></div>
        <div class="package-card__label">
          <span
            >{t.from} <span class="package-card__price">{t.n3000}</span></span
          >
        </div>
        <p class="package-card__description">
          {t.scaleMeasureAndAutomate}
        </p>
        <PackageFeatures items={t.growthFeatures} />
        <h4>{t.bestFor}</h4>
        <p>{t.growingBusinessesWithMore}</p>
        <h4>{t.deliveryTime}</h4>
        <p>{t.n46Weeks}</p>
        <div class="package-card__actions">
          <a class="btn__primary btn__prim--light" href={r('contact')}>
            {t.bookACall} <span aria-hidden="true">→</span>
          </a>
          <a class="btn__third" href="#pricing-table">
            {t.seePricing}
            <span class="price-btn-arrow" aria-hidden="true"
              ><svg
                width="15"
                height="15"
                viewBox="0 0 21 15"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20.7071 8.07088C21.0976 7.68035 21.0976 7.04719 20.7071 6.65666L14.3431 0.292702C13.9526 -0.0978227 13.3195 -0.0978227 12.9289 0.292702C12.5384 0.683226 12.5384 1.31639 12.9289 1.70692L18.5858 7.36377L12.9289 13.0206C12.5384 13.4111 12.5384 14.0443 12.9289 14.4348C13.3195 14.8254 13.9526 14.8254 14.3431 14.4348L20.7071 8.07088ZM0 7.36377V8.36377H20V7.36377V6.36377H0V7.36377Z"
                  fill="white"
                />
              </svg>
            </span>
          </a>
        </div>
      </article>
    </div>
    <div class="packages__benefits" aria-label={t.arialabelPackageBenefits}>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M24 4 40 10v12c0 10-6 18-16 22C14 40 8 32 8 22V10Z" />
          <path d="m17 24 5 5 10-11" />
        </svg>
        <span>{t.builtForPerformance}</span>
      </div>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <rect x="6" y="8" width="24" height="32" rx="2" />
          <rect x="34" y="17" width="8" height="15" rx="1" />
          <path d="M14 34h8" />
        </svg>
        <span>{t.mobileOptimised}</span>
      </div>
      <div class="benefit">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <rect x="7" y="30" width="7" height="11" />
          <rect x="20" y="22" width="7" height="19" />
          <rect x="33" y="12" width="7" height="29" />
        </svg>
        <span>{t.readyToGrow}</span>
      </div>
    </div>
  </div>

  <section class="pricing-section" aria-labelledby="pricing-title">
    <h2 class="section-sub-headings" id="pricing-title">{t.pricing}</h2>
    <div class="pricing-container" id="pricing-table">
      <div class="pricing-card">
        <h3>{t.starterLandingPage}</h3>
        <p>{t.n7001200}</p>
      </div>
      <div class="pricing-card">
        <h3>{t.businessWebsite2}</h3>
        <p>{t.n15003000}</p>
      </div>
      <div class="pricing-card">
        <h3>{t.growthWebsite2}</h3>
        <p>{t.n30006000}</p>
      </div>
      <div class="pricing-card">
        <h3>{t.eCommerceModuleProject}</h3>
        <p>{t.n15005000}</p>
      </div>
      <div class="pricing-card">
        <h3>{t.maintenance}</h3>
        <p>{t.n35150Month}</p>
      </div>
      <div class="pricing-card">
        <h3>{t.ongoingVisibility}</h3>
        <p>{t.n2501000Month}</p>
      </div>
    </div>
    <p class="pricing-hook">
      {t.everyProjectIncludes2}
    </p>
    <p class="pricing-hook">
      {t.projectsAreCustomBuilt}
    </p>
  </section>
</section>
