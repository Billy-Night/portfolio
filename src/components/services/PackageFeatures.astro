---
// The bullet list on a package card. Each language passes its own list of
// features, so the two languages can have different bullets and counts.
import BulletList from '../BulletList.astro'

interface Props {
  items: string[]
  /** The wider variant used on the featured (middle) card */
  large?: boolean
}

const { items, large = false } = Astro.props
---

<BulletList items={items} listClass={large ? 'package-card__features package-card__features--large' : 'package-card__features'} />

<!-- This component's own styles. They apply only to this component's elements; a selector in :global(...) also
     reaches elements written elsewhere. How styles are organised: src/styles/README.md -->
<style>
  :global(.package-card__features) {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--gap-sm);
    padding: 0;
    margin: 0 0 1.75rem;
    list-style: none;
  }

  :global(.package-card__features) :global(li) {
    position: relative;
  }

  :global(.package-card__features--large) {
    gap: var(--gap-sm);
    margin-top: var(--gap-sm);
  }

  :global(.package-card__features--large) :global(li) {
    font-size: var(--text-base);
  }
</style>
