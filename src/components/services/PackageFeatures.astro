---
// The bullet list on a package card. Each language passes its own list of
// features, so the two languages can have different bullets and counts.
import BulletList from '../BulletList.astro'

interface Props {
  items: string[]
  /** The wider variant used on the featured (middle) card */
  large?: boolean
}

const { items, large = false } = Astro.props
---

<BulletList items={items} class={large ? 'package-card__features package-card__features--large' : 'package-card__features'} />
