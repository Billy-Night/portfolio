/*
  Cache-Control: public, max-age=600, must-revalidate

# style.css and script.js are linked with a content hash (?v=...), added by
# assetUrl() in src/utils/assetVersion.ts. A changed file gets a new URL, so
# browsers can keep each version for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
