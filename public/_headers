# Security headers, sent with every file:
# - nosniff: the browser must use the file type the server states, not guess it
# - X-Frame-Options: other sites cannot display these pages inside a frame
# - Referrer-Policy: other sites are told which site a visitor came from, not
#   which page
# - Permissions-Policy: the site, and anything embedded in it, cannot ask for
#   the camera, microphone or location
# - Content-Security-Policy-Report-Only: the list of places the pages may load
#   things from. Everything comes from this site, except the analytics that
#   load after cookie consent: Microsoft Clarity, Google Analytics, and the
#   Google Ads addresses that Analytics calls for remarketing and conversions.
#   The Google addresses are the ones in Google's own guide:
#   https://developers.google.com/tag-platform/security/guides/csp
#   A policy cannot say "google in any country", so each country is listed:
#   .com, .fr, .es and .co.uk. Add more if visitors from elsewhere matter.
#   "Report-Only" means the browser only logs what the policy would block, in
#   its console, and blocks nothing. Once the live site shows no reports,
#   rename the header to Content-Security-Policy to enforce it.
#   'unsafe-inline' is needed because Astro and Cloudflare put small scripts
#   directly in the page.
/*
  Cache-Control: public, max-age=600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clarity.ms https://*.googletagmanager.com https://www.googleadservices.com https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.clarity.ms https://c.bing.com https://*.google-analytics.com https://*.googletagmanager.com https://*.google.com https://*.google.fr https://*.google.es https://*.google.co.uk https://*.g.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; font-src 'self'; connect-src 'self' https://*.clarity.ms https://c.bing.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.google.com https://*.google.fr https://*.google.es https://*.google.co.uk https://*.g.doubleclick.net https://ad.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# style.css is linked with a content hash (?v=...), added by assetUrl() in
# src/utils/assetVersion.ts. A changed file gets a new URL, so browsers can
# keep each version for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# The font files never change, so browsers keep them for a year and do not
# ask for them again. To replace a font, give the new file a new name:
# browsers that have the old one would never fetch a changed file of the same
# name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts bundled by Astro have a content hash in their file name
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
